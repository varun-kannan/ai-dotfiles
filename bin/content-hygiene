# Small Greek letters used as math names (nu, alpha, rho...). Omicron is not: it is never a math name.
GREEK_LOWER_LOOKALIKE = set("\u03bd\u03b1\u03ba\u03c1\u03c5\u03b3\u03c3\u03f1")
LOOKALIKE = GREEK_LOWER_LOOKALIKE | {"\u03b9", "\u03bf", "\u07cb", "\uab7a"} | _latin_tricks() \
    | CONFUSABLE_LETTERS | MULTI_LETTER_CONFUSABLE | MIXED_ONLY_CONFUSABLE | set(
