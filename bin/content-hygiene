GREEK_MATH_MAX = 4      # short Greek-plus-Latin names (a rho or sigma with a suffix) are ordinary in numeric code
DIGIT_SKELETON_CONFUSABLE = set("\u0417\u041e\u0431\u0433\u04e8\u3007")
# The ICU confusable skeleton (UTS #39) of each lookalike: two names with the same skeleton
# read as one name. Digits, I and m have skeletons too (0 is O, m is rn).
SKELETON = {"0": "O", "1": "l", "I": "l", "m": "rn"}
