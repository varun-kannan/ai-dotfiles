    ).split():
    _target, _chars = _group.split("=")
    SKELETON.update((c, _target) for c in _chars)
# Digits and signs of other scripts whose skeleton is ASCII (Bengali zero reads as O, Telugu
# anusvara as o). Python splits a name at them, so the letter rules never see them.
NATIVE_DIGIT_CONFUSABLE = set(chr(int(x, 16)) for x in (
    "661 665 667 6F1 6F5 6F7 7C0 966 9E6 9EA 9ED A66 A67 A6A AE6 B03 B66 B68 BE6 C02 C66 C82 CE6 D02 D66 "
    "D6D D82 E50 ED0 1040 114D0 118E0 118E3 118E5 118E6 118E9 "
    ).split())
MATH_NAME_EXT = {".jl", ".lean", ".agda", ".hs", ".lhs", ".idr"}
PHRASE_CHARS = 2000      # characters of a line that the phrase rules (placeholders, scaffolding) read
PER_LINE_LIMIT = 40     # findings of one kind reported per line
CONTEXT_LINES = 3       # lines either side of a lookalike name where a real word of its script vouches for it
SHORT_WORD = 3          # a two or three letter word made only of lookalikes is too often a real word to block on

# Text hidden from a reader of the rendered page but read by a model.
# An invisible character written out: \U000E0041, \u200b, the surrogate pair \udb40\udc41,
# &#xE0041; or &#917569;.
# Java allows any number of u's (\\uuu200b); Perl allows spaces in \\x{ 200b }; Ruby takes a
# list in \\u{41 E0041}; Rust allows underscores in \\u{E_0041}.
ESCAPED_HIDDEN = re.compile(r"\\u+[dD][89abAB][0-9a-fA-F]{2}\\u+[dD][c-fC-F][0-9a-fA-F]{2}|\\U([0-9a-fA-F]{8})"
                            r"|\\x\{[ \t]*[0_]*([0-9a-fA-F][0-9a-fA-F_]{0,15})[ \t]*\}|\\u+([0-9a-fA-F]{4})"
                            r"|&#[xX]0*([0-9a-fA-F]{2,6});?|&#0*(\d{2,7});?"
                            r"|\\u\{[0_]*([0-9a-fA-F_ \t]+)\}|\\N\{([A-Za-z0-9 _-]{1,60})\}|&([A-Za-z][A-Za-z0-9]{1,31});"
                            r"|\\N\{U\+[0_]*([0-9a-fA-F][0-9a-fA-F_]{0,15})\}")
CSS_ESCAPE = re.compile(r"\\([0-9a-fA-F]{1,6})(?![0-9a-fA-F])")
CSS_ESCAPE_EXT = {".css", ".scss", ".less", ".sass", ".html", ".htm", ".xhtml", ".svg", ".vue", ".svelte", ".astro"}
# More ways to write one code point: (pattern, base, extensions it applies to, or None for all).
# Perl and C++23 \o{20013}; R \U{E0041}; PowerShell `u{200B}; Haskell \8203 (decimal).
OTHER_ESCAPES = [(re.compile(r"\\o\{[ \t]*[0_]*([0-7][0-7_]{0,21})[ \t]*\}"), 8, None),
                 (re.compile(r"\\U\{0*([0-9a-fA-F]{1,8})\}"), 16, None),
                 (re.compile(r"`u\{0*([0-9a-fA-F]{1,8})\}"), 16, {".ps1", ".psm1", ".psd1"}),
                 # zsh, bash 4.2+ and fish take 1-8 digits after \U and 1-4 after \u: $'\UE0041'.
                 (re.compile(r"\\U([0-9a-fA-F]{1,7})(?![0-9a-fA-F])"), 16, {".sh", ".bash", ".zsh", ".ksh", ".fish"}),
                 (re.compile(r"\\u([0-9a-fA-F]{1,3})(?![0-9a-fA-F])"), 16, {".sh", ".bash", ".zsh", ".ksh", ".fish"}),
                 (re.compile(r"\\0*([1-9][0-9]{2,6})(?![0-9])"), 10, {".hs", ".lhs"}),
                 (re.compile(r"\\x0*([0-9a-fA-F]{1,8})(?![0-9a-fA-F])"), 16, {".hs", ".lhs"}),
                 (re.compile(r"\\o0*([0-7]{1,11})(?![0-7])"), 8, {".hs", ".lhs"}),
                 (re.compile(r"\\x0*([0-9a-fA-F]{1,8});"), 16, {".scm", ".rkt", ".ss", ".sld"}),
                 (re.compile(r"\\x\[[ \t]*0*([0-9a-fA-F]{1,8})"), 16, {".raku", ".rakumod", ".p6", ".pm6"})]
# Two hex digits after \x name a code point, not a byte, in Python str literals (not b"..."),
# JavaScript strings and YAML double-quoted strings: "\x85" is NEL.
X_CODE_POINT = re.compile(r"\\(?:x([0-9a-fA-F]{2})|([0-3][0-7]{2}))")
X_CODE_POINT_EXT = {".py", ".pyi", ".js", ".jsx", ".ts", ".tsx", ".mjs", ".cjs", ".yaml", ".yml", ".pl", ".pm",
                    ".dart", ".cs", ".java"}
# Lua writes bytes in decimal: \226\128\139. \z, concatenation, and adjacent literals
# can split one UTF-8 sequence without changing its value.
LUA_BYTE_ONE = r"\\[0-9]{1,3}"
LUA_BYTE_GAP = r'''(?:\\z\s*|["'][ \t]*(?:(?:\.\.|\+)[ \t]*)?(?:\n[ \t]*)?["'])?'''
LUA_BYTES = re.compile(LUA_BYTE_ONE + "(?:" + LUA_BYTE_GAP + LUA_BYTE_ONE + "){2,}")
# Postgres U&'\200B' and U&'\+0E0041'.
PG_UNICODE = re.compile(r"""(?i)\bU&(?:'((?:[^']|'')*)'|"((?:[^"]|"")*)")"""
                        r"(?:(?:\s|/\*.*?\*/|--[^\n]*\n)*UESCAPE(?:\s|/\*.*?\*/|--[^\n]*\n)*'([^'])')?", re.S)
YAML_DQ = re.compile(r'"(?:[^"\\]|\\.)*"', re.S)
# Where a double-quoted scalar can start: at the start of a line or list item, after "key: ",
# or after [ { , in a flow collection.
YAML_VALUE_START = re.compile(r"(?:^[ \t]*(?:-[ \t]+)*|:[ \t]+|[\[{,][ \t]*)$")
YAML_BLOCK = re.compile(r"^([ \t]*)(?:-[ \t]+)?(?:[^#\n]*?:[ \t]+)?[|>][-+0-9]*[ \t]*(?:#.*)?$")


def _yaml_quoted(text):
    """Double-quoted scalars of a YAML file, outside block scalars (run: |) and comments, where a
    backslash is only a character."""
    eligible, at, block = [], 0, None
    for line in text.split("\n"):
        end = at + len(line)
        indent = len(line) - len(line.lstrip(" \t"))
        if block is not None and (not line.strip() or indent > block):
            at = end + 1
            continue
        block = None
        if not line.lstrip().startswith("#"):
            eligible.append((at, end))
            m = YAML_BLOCK.match(line)
            if m:
                block = len(m.group(1))
        at = end + 1
    # Walk each eligible line the way YAML reads it: keys, then a value that is double-quoted,
    # single-quoted, a flow collection, or plain. Only a double-quoted scalar decodes escapes;
    # a quote inside a plain or single-quoted scalar is a character. A double-quoted scalar may
    # run over several lines.
    found = []
    for a, b in eligible:
        pos = max(a, found[-1].end() if found else 0)
        if pos >= b:
            continue
        _yaml_line(text, pos, b, found, 0)
    return found


YAML_PROPS = re.compile(r"(?:(?:!<[^>\n]*>|[&!*][^ \t\n,\[\]{}]*)[ \t]+)*")


def _yaml_line(text, i, b, found, depth):
    """Scan one value position at i; add double-quoted scalars to found. Returns where it stopped."""
    keyed = False                         # at block level a line holds one key; its value runs to the end
    while i < b:
        while i < b and text[i] in " \t":
            i += 1
        if text.startswith(("--- ", "? "), i) and depth == 0:
            i += 4 if text.startswith("--- ", i) else 2
            continue
        if text.startswith("- ", i) or (text.startswith("-", i) and i + 1 == b):
            i += 2
            continue
        i = YAML_PROPS.match(text, i).end()
        if i >= b or text[i] == "#":
            return b
        c = text[i]
        if c == '"':
            m = YAML_DQ.match(text, i)
            if not m:
                return b
            found.append(m)
            i = m.end()
        elif c == "'":
            k = i + 1
            while k < len(text):
                if text[k] == "'" and text[k + 1:k + 2] == "'":
                    k += 2
                elif text[k] == "'":
                    break
                else:
                    k += 1
            i = k + 1
        elif c in "[{" and depth < 50:
            i += 1
            while i < b:
                i = _yaml_line(text, i, b, found, depth + 1)
                while i < b and text[i] in " \t":
                    i += 1
                if i < b and text[i] == ",":
                    i += 1
                    continue
                if i < b and text[i] in "]}":
                    i += 1
                break
        else:
            # A plain scalar: a key if ": " follows before a comment, else the value to the end.
            stop = "]},#" if depth else "#"
            k = i
            while k < b and not (text[k] in stop and (text[k] != "#" or text[k - 1] in " \t")):
                if text[k] == ":" and (k + 1 == b or text[k + 1] in " \t") and not (keyed and not depth):
                    break
                k += 1
            if k < b and text[k] == ":":
                i, keyed = k + 1, True
                continue
            return k if depth else b
        # after a quoted key or value: a key if ":" follows, else done with this value
        while i < b and text[i] in " \t":
            i += 1
        if i < b and text[i] == ":":
            i, keyed = i + 1, True
            continue
        return i
    return i


PG_ESCAPE = re.compile(r"\\(?:\+([0-9a-fA-F]{6})|([0-9a-fA-F]{4}))")


def _shell_live(text, pos, ext):
    """In a shell script, outside single quotes, the shell halves a run of backslashes before
    printf or echo -e reads it: "\\\\U000E0049" reaches printf as "\\U000E0049" and is live."""
    if ext not in (".sh", ".bash", ".zsh", ".ksh", ".fish"):
        return False
    n = 0
    while pos - n - 1 >= 0 and text[pos - n - 1] == "\\":
        n += 1
    if _SHELL_LITERALS[0] is not text or _SHELL_LITERALS[1] != ext:
        literals = []
        text_spans(text, "x" + ext, literals)
        literals.sort()
        _SHELL_LITERALS[:] = [text, ext, literals]
    lit = _literal_at(_SHELL_LITERALS[2], pos - n)
    if lit and text[lit[0]] == "'" and text[lit[0] - 1:lit[0]] != "$":
        return False                  # inside single quotes ($'...' aside): nothing is halved
    return ((n + 2) // 2) % 2 == 1


_SHELL_LITERALS = [None, None, []]


_ROWS = [None, []]


def _literal_at(literals, pos):
    """(start, end) of the innermost literal in the sorted `literals` that holds pos, or None."""
    k = bisect.bisect_right(literals, (pos, len(literals) and 1 << 62)) - 1
    for a, b in literals[max(0, k - 64):k + 1][::-1]:
        if a <= pos < b:
            return a, b
    return None


def _row_of(text, pos):
    """How many newlines come before pos. One pass per text, then a bisect per call: counting
    from the start for every finding is quadratic on a file with thousands of them."""
    if _ROWS[0] is not text:
        _ROWS[0], _ROWS[1] = text, [m.start() for m in re.finditer("\n", text)]
    return bisect.bisect_left(_ROWS[1], pos)


def _escaped(text, pos):
    """True when the backslash at pos is itself escaped by an odd run of backslashes before it."""
    n = 0
    while pos - n - 1 >= 0 and text[pos - n - 1] == "\\":
        n += 1
    return n % 2 == 1
# C, C++, Objective-C and C# read every hex digit after \\x (in C# up to four): "\\x200B".
WIDE_X = re.compile(r"\\x0*([0-9a-fA-F]{3,8})(?![0-9a-fA-F])")
WIDE_X_EXT = {".c", ".h", ".cc", ".cpp", ".cxx", ".hh", ".hpp", ".hxx", ".m", ".mm", ".cs", ".el"}
HIDDEN_STYLE = re.compile(r"(?i)<[a-z][^<>]{0,300}(?:display\s*:\s*none|visibility\s*:\s*hidden|font-size\s*:\s*0)[^<>]{0,300}>")
LINK_TITLE = re.compile(r"""(?m)\]\([^()\s]{1,500}[ \t]{1,8}["']([^"'\n]{1,2000})["']\)|^[ \t]{0,3}\[[^\]\n]{1,200}\]:[ \t]{1,8}\S{1,500}[ \t]{1,8}["'(]([^"')\n]{1,2000})["')][ \t]{0,8}$""")
INJECTION = re.compile(r"(?i)\b(ignore|disregard|forget|override)\b[^.]{0,40}\b(previous|prior|above|earlier|all|system)\b"
                       r"[^.]{0,20}\b(instructions?|rules?|prompts?|messages?)\b"
                       r"|\bdo not (tell|mention|reveal|inform)\b[^.]{0,30}\b(user|human|anyone)\b"
                       r"|\byou are now\b|\bnew instructions?:")


def _decode_tags(run):
    return "".join(chr(ord(c) - 0xE0000) for c in run if 0x20 <= ord(c) - 0xE0000 <= 0x7E)


def _flag_emoji(line, start, run):
    """England, Scotland and Wales flags are a black flag plus tag letters plus a cancel tag."""
    return start > 0 and line[start - 1] == "\U0001F3F4" and run.endswith("\U000E007F") \
        and _decode_tags(run[:-1]) in FLAG_TAGS


def _script(ch):
    o = ord(ch)
    for lo, hi, name in SCRIPTS:
        if lo <= o <= hi:
            return name
    if o > 0x7F and ch.isalpha():
        return unicodedata.name(ch, "OTHER ?").split()[0].title()     # Armenian, Cherokee, Arabic...
    return None


def _homoglyph(word, line_real_scripts):
    """Why a word is a lookalike, or None.

    mixed: Latin letters plus letters from another script that read as Latin.
    whole: only such letters, on a line with no ordinary text in that script.
    """
    alike = [c for c in word if c in LOOKALIKE]
    if not alike:
        return None
    script = _script(alike[0])
    only_small_greek = all(c in GREEK_LOWER_LOOKALIKE for c in alike)
    if only_small_greek and "\u03bd" not in alike and len(word) <= GREEK_MATH_MAX and any("a" <= c.lower() <= "z" for c in word):
        return "may be a numeric name; mixes Latin and %s letters" % script
    if any("a" <= c.lower() <= "z" for c in word):
        return "mixes Latin and %s letters" % script
    letter_alike = [c for c in alike if c not in MIXED_ONLY_CONFUSABLE]
    digit_like = all(c in DIGIT_SKELETON_CONFUSABLE for c in word)
    # Every script in the word needs its own context: a Cyrillic line does not vouch for an
    # Armenian letter mixed into a Cyrillic-looking word.
    scripts = sorted({_script(c) for c in letter_alike}, key=[_script(c) for c in letter_alike].index)
    if len(word) >= 2 and len(letter_alike) == len(word) and not digit_like \
            and any(s not in line_real_scripts for s in scripts):
        return "is made only of %s letters that read as Latin" % " and ".join(scripts)
    return None


# Top-level domains a dotted name must end in to count as a host when no :// says so: the
# country codes and the common generic ones, less those that are mostly file extensions (.md,
# .py, .pl, .rs...). Others (x.append, x.std, a .png file name) are a member, a method or a file.
HOST_TLDS = set("""
ac ad ae af ag ai al am ao aq ar as at au aw ax az ba bb bd be bf bg bh bi bj bm bn bo br bs bt bw by bz ca cc cd cf
cg ch ci ck cl cm cn co cr cu cv cw cx cy cz de dj dk dm do dz ec ee eg er es et eu fi fj fk fm fo fr ga gd ge gf gg gh
gi gl gm gn gp gq gr gs gt gu gw gy hk hm hn hr ht hu id ie il im in io iq ir is it je jm jo jp ke kg kh ki km kn kp kr
kw ky kz la lb lc li lk lr ls lt lu lv ly ma mc me mg mh mm mn mo mp mq mr ms mt mu mv mw mx my mz na nc ne nf
ng ni nl no np nr nu nz om pa pe pf pg ph pk pn pr pt pw qa re ro ru rw sa sb sc sd se sg sh si sk sl sm
sn so sr ss st su sv sx sy sz tc td tf tg th tj tk tl tm tn to tr tt tv tw tz ua ug uk us uy uz va vc ve vg vi vn vu wf
ws ye yt za zm zw
com net org edu gov mil int info biz name pro aero coop museum mobi asia tel travel jobs cat xyz site online tech app
dev top shop store club live news blog cloud page link click space website fun icu vip wiki email world today company
network digital media social group zone tools agency studio design systems services support software codes host
download security bank finance money pay win bet game games art lol africa berlin london nyc tokyo
""".split())
# IDNA maps these full stops to ".", so they part host labels as a dot does.
HOST_DOTS = str.maketrans("\u3002\uff0e\uff61", "...")


def _host_at(line, a, b, dotted=True):
    """The span of the host name that the word line[a:b] is part of, or None: a word after ://,
    or, when dotted, a label in a dotted run that ends in a known top-level domain (x.com,
    user@x.com). A label may hold digits, "-" and "_" around the word (api-x.com, x1.com)."""
    line = line.translate(HOST_DOTS)
    s, e = a, b
    while s > 0 and (line[s - 1].isalnum() or line[s - 1] in ".-_"):
        s -= 1
    while e < len(line) and (line[e].isalnum() or line[e] in ".-_"):
        e += 1
    if line[:s].endswith("://"):
        return s, e
    # The last label must be a top-level domain, not a method of a name (x.to(...), x.co = ...),
    # and the word must come before it.
    run = line[b:e].rstrip(".-_")
    if dotted and "." in run and run.rsplit(".", 1)[1].lower() in HOST_TLDS and not re.match(r"[ \t]*[(=[]", line[e:]):
        return s, e
    return None


def _native_idn_host(host):
    """Whether a host under a top-level label of another script (.\u0440\u0444) is written in that script:
    enough of its letters are real letters of it (_native_host), or every letter is a core letter of one script
    (a Russian word that happens to be all lookalikes, \u0441\u043e\u043a.\u0440\u0444). A rarer letter (a palochka for l)
    still needs the share."""
    letters = [c for c in host if c.isalpha()]
    core = lambda c: 0x0400 <= ord(c) <= 0x045F or 0x0370 <= ord(c) <= 0x03FF
    return _native_host(host) or bool(letters) and all(core(c) for c in letters) and len({_script(c) for c in letters}) == 1


def _host_label(line, host, a):
    """The dot-separated label of the host line[host[0]:host[1]] that holds column a."""
    line = line.translate(HOST_DOTS)
    s = line.rfind(".", host[0], a) + 1 or host[0]
    e = line.find(".", a, host[1])
    return line[max(s, host[0]):host[1] if e < 0 else e]


def _native_host(label):
    """Whether a host label is written in another script (a real Russian domain): at least a
    third of its non-ASCII letters, and two of them unless they are half, are letters of one
    script that do not read as Latin. Real words share many letters with Latin (a Russian label
    can be mostly lookalikes); a spoof has few or none, and one real letter (the m of a Cyrillic
    "com") does not make a label native. Each label is judged alone, so a real subdomain does
    not vouch for a spoofed name beside it."""
    letters = [c for c in label if c.isalpha() and not c.isascii()]
    real = [c for c in letters if c not in LOOKALIKE]
    return bool(real) and len({_script(c) for c in real}) == 1 and 3 * len(real) >= len(letters) \
        and (len(real) >= 2 or 2 * len(real) >= len(letters))


SHELL_TEXT_EXT = {".sh", ".bash", ".zsh", ".ksh", ".fish", ".mk", ".dockerfile", ".ps1", ".bat", ".cmd"}


def _shell_argument(line, pos, code_ext):
    """Whether the word at line[pos] is an argument of a shell command, which is text. A word in
    command position is a name that runs: the first, one after a keyword or a prefix command
    (with its options, a duration, or VAR=value assignments), and one after the ")" that ends
    a case pattern."""
    return code_ext in SHELL_TEXT_EXT and bool(re.match(r"^[ \t@-]*[^ \t]+[ \t]+", line[:pos])) \
        and not re.search(r"(?:[;&|!`]|\$\(|^[ \t]*\(?[^ \t;&|()$]+(?:\|[^ \t;&|()]+)*\)|(?:^|[ \t;&|(])"
                           r"(?:function|if|then|else|elif|do|while|until|exec|sudo|doas|time|command|builtin|env|nice"
                           r"|stdbuf|eval|alias|source|\.|\{|nohup|xargs|timeout)|^[ \t]*[A-Za-z_][A-Za-z0-9_]*=[^ \t]*)"
                           r"(?:[ \t]+(?:-[^ \t]*|[0-9.]+[smhd]?|[A-Za-z_][A-Za-z0-9_]*=[^ \t]*))*[ \t]*$",
                           line[:pos])


def _modifier_letter(ch):
    return unicodedata.category(ch) == "Lm" or unicodedata.decomposition(ch).startswith(("<super>", "<sub>"))


def _emoji_base(ch):
    """A character that has both a text and an emoji form, so a presentation selector after
    it means something. Box drawing, arrows-as-math and plain symbols do not qualify."""
    o = ord(ch)
    return o >= 0x1F000 or o in (0x00A9, 0x00AE, 0x203C, 0x2049, 0x2122, 0x2139, 0x24C2, 0x3030, 0x303D, 0x3297, 0x3299) \
        or 0x2194 <= o <= 0x21AA or 0x231A <= o <= 0x23FF or 0x25AA <= o <= 0x25FE or 0x2600 <= o <= 0x27BF \
        or o in (0x2934, 0x2935) or 0x2B05 <= o <= 0x2B55


def _is_han(ch):
    o = ord(ch)
    return 0x3400 <= o <= 0x4DBF or 0x4E00 <= o <= 0x9FFF or 0xF900 <= o <= 0xFAFF or 0x20000 <= o <= 0x3134F


def _space_separated_script(ch):
    """Thai, Lao, Khmer and Myanmar write without spaces and use a zero-width space between words."""
    o = ord(ch)
    return 0x0E00 <= o <= 0x0EFF or 0x1780 <= o <= 0x17FF or 0x1000 <= o <= 0x109F


def _is_selector(ch):
    o = ord(ch)
    return 0xFE00 <= o <= 0xFE0F or 0xE0100 <= o <= 0xE01EF


def _hidden_code_point(o):
    """True for a code point that shows as nothing or hides text: tags, selectors, every
    format character, blank lookalikes. Escapes are judged by this, the same table as raw text."""
    if not 0 <= o <= 0x10FFFF:
        return False
    if 0xE0000 <= o <= 0xE0FFF or 0xFE00 <= o <= 0xFE0F or o in BLANK_LOOKALIKE or o in MONGOLIAN_SELECTORS:
        return True
    if o in (0x85, 0x2028, 0x2029):
        return True                       # NEL, line and paragraph separators: invisible line breaks
    return unicodedata.category(chr(o)) == "Cf" and o not in ARABIC_FORMAT


# Pages an HTML parser reads (where &#146; is a right quote); XML and SVG read it as written.
HTML_PAGES = {".json", ".html", ".htm", ".php", ".erb", ".ejs", ".hbs", ".jinja", ".j2", ".twig", ".vue", ".svelte",
              ".astro", ".md", ".markdown"}


def _cp1252_reference(o):
    """A character reference from 128 to 159 is read by HTML parsers as the cp1252 character
    (&#146; is a right quote), except for the five cp1252 leaves undefined."""
    if 0x80 <= o <= 0x9F:
        try:
            return ord(bytes([o]).decode("cp1252"))
        except UnicodeDecodeError:
            return o
    return o


def _hidden_run(decoded, length=3):
    """True when the decoded text holds this many hidden characters, or any tag character or
    variation selector 17-256, which no binary blob spells by chance in numbers."""
    hidden = [ord(c) for c in decoded if _hidden_in_bytes(ord(c))]
    return len(hidden) >= length or any(0xE0000 <= o <= 0xE01EF for o in hidden)


def _hidden_in_bytes(o):
    """_hidden_code_point for a character spelled in escaped bytes. Except for NEL, C1 controls
    are left out: their two bytes turn up by chance in binary fixtures written as escapes."""
    return _hidden_code_point(o) and (o == 0x85 or not 0x80 <= o <= 0x9F)


BYTE_ESCAPE_ONE = r"(?:\\[xX][0-9a-fA-F]{2}|\\0?[0-3][0-7]{2})"
# Between escapes: nothing, the end of one literal and the start of the next ("\xe2" "\x80"),
# a backslash-newline, or Lua's \z and the blanks after it.
BYTE_LITERAL_GAP = (r'''["'](?:[ \t\r\n]|\\\n|/\*.*?\*/|\#[^\n]*(?:\n|$)|'''
                    r'''(?:\+|\.\.|<<|,|\[|\]|\(|\)))*?(?:[bBrRuU]{0,2}|\$)["']''')
BYTE_ESCAPE_GAP = r"(?:" + BYTE_LITERAL_GAP + r"|\\\n[ \t]*|\\z\s*)?"
BYTE_ESCAPES = re.compile(BYTE_ESCAPE_ONE + "(?:" + BYTE_ESCAPE_GAP + BYTE_ESCAPE_ONE + "){2,}")
# C, C++ and Go never join the elements of a list of strings ("\xc2", "\x85"): only adjacent literals.
BYTE_ESCAPES_ADJACENT = re.compile(BYTE_ESCAPE_ONE + "(?:" + BYTE_ESCAPE_GAP.replace(r"|,|\[|\]|\(|\)", "")
                                   + BYTE_ESCAPE_ONE + "){2,}")
PERCENT_GAP = r'''(?:["'](?:[ \t\r\n]|/\*.*?\*/|\#[^\n]*(?:\n|$)|\+|\.\.)*?["'])?'''
PERCENT_RUN = re.compile(r"%[0-9a-fA-F]{2}(?:" + PERCENT_GAP + r"%[0-9a-fA-F]{2}){2,}")
PERCENT_U_RUN = re.compile(r"%u[0-9a-fA-F]{4}(?:" + PERCENT_GAP + r"%u[0-9a-fA-F]{4})+")


def _noncharacter(o):
    return 0xFDD0 <= o <= 0xFDEF or (o & 0xFFFE) == 0xFFFE


def _unassigned_hidden(o):
    """An unassigned code point that renders as nothing, or one no font shows. Blocks where
    new emoji and ideographs keep being added are left alone: this Python may be older than them."""
    # Only the ranges Unicode sets aside as invisible. Any other code point this Python does not
    # know may simply be newer than its tables (the Saudi riyal sign, U+20C1), and a font that
    # lacks it shows a box, not nothing.
    return 0xE0000 <= o <= 0xE0FFF or o == 0x2065 or 0xFFF0 <= o <= 0xFFF8


def _real_scripts(line):
    """Scripts with at least one letter on the line that does not read as Latin."""
    return {_script(c) for c in line if c not in LOOKALIKE and _script(c)}


def _is_rtl(ch):
    """A right-to-left letter. Direction marks are excluded: they must not justify themselves."""
    return unicodedata.bidirectional(ch) in ("R", "AL") and unicodedata.category(ch).startswith("L")


def _is_cjk(ch):
    o = ord(ch)
    return 0x3040 <= o <= 0x30FF or 0x3400 <= o <= 0x4DBF or 0x4E00 <= o <= 0x9FFF \
        or 0xAC00 <= o <= 0xD7AF or 0xF900 <= o <= 0xFAFF


def _is_cjk_context(ch):
    o = ord(ch)
    return _is_cjk(ch) or 0x3000 <= o <= 0x303F or 0xFF01 <= o <= 0xFF20


def _joining_script(ch):
    """Scripts where zero-width joiners change how letters connect: Arabic, Syriac, Indic,
    Myanmar, Khmer, Mongolian."""
    o = ord(ch)
    return 0x0600 <= o <= 0x077F or 0x08A0 <= o <= 0x08FF or 0xFB50 <= o <= 0xFDFF or 0xFE70 <= o <= 0xFEFC \
        or 0x0900 <= o <= 0x0DFF or 0x1000 <= o <= 0x109F or 0x1780 <= o <= 0x17FF or 0x1800 <= o <= 0x18AF


def _emoji_part(ch):
    o = ord(ch)
    return o >= 0x1F000 or 0x2190 <= o <= 0x2BFF or o in (0xFE0F, KEYCAP, 0x00A9, 0x00AE, 0x203C, 0x2049,
                                                           0x2122, 0x2139, 0x3030, 0x303D, 0x3297, 0x3299)


