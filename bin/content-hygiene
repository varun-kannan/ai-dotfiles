    "\u2c82\u2c88\u2c8c\u2c8e\u2c92\u2c93\u2c94\u2c98\u2c9a\u2c9e\u2c9f\u2ca2\u2ca3\u2ca4\u2ca5\u2ca6\u2ca8"
    "\u2cac\u2cad"
    # Cyrillic Extended-B, Canadian syllabics, and Latin letters that pass for i, l, I
    "\ua64b\u1472\u146f\u15c5\u157c\u1587\u15af\u0131\u01c0\u0269\u026a\u04bd\u0138")
# An index may be written with subscript or superscript digits and letters too (\u03c1\u2080, \u03c1\u1d62).
GREEK_INDEX = "0-9_\u2080-\u2089\u2070\u00b9\u00b2\u00b3\u2074-\u2079"
