#!/usr/bin/env python3
# hygiene:ignore-file - this scanner quotes every pattern it looks for
"""content-hygiene - scan text for output-hygiene violations.

Implements the mechanical parts of CLAUDE.md sections 11 (character hygiene),
12 (no scaffolding) and 8 (comment/placeholder hygiene).

Usage:
    content-hygiene FILE [FILE ...]     scan files
    content-hygiene --stdin [--name N]  scan stdin, N used for type detection
    content-hygiene --self-test         run built-in tests

Options: --quiet (hard findings only), --security (hard findings and hidden-text warnings),
--deadline S (a file not finished in S seconds is reported as not checked), --no-marker
(ignore the opt-out marker), --fragment (part of a file: no first-line or last-line rules),
--classify-moves (from NUL-separated old/new pairs on stdin, print the new paths whose
judgement changes). --help lists them all.

Exit: 0 clean or warnings only, 1 hard violations found, 2 unknown option, 3 no input given
or a named file is missing or unreadable (and nothing hard was found in the rest).

Files are one of three kinds. Code (the default) is strict. Prose (.md, .txt and
similar) and data (.json, .yaml, .csv, .html and similar) may hold typographic
characters, so those are warnings there. Dependency manifests and CI workflows count
as code whatever their extension (package.json, requirements*.txt, compose files,
.github/workflows). Characters that hide text (tag characters,
zero-width characters outside the scripts that use them, stray variation selectors,
control characters) are hard findings in every kind; bidirectional controls are hard
in code and data and warnings in prose.

Limits: files with a known binary extension are not read, a file over 2 MB is scanned
up to that size, and a file with no text extension that looks binary is skipped.

Opt out per file by putting the marker  hygiene:ignore-file  in the first 30
lines. Reference material that quotes these characters on purpose needs it.
"""
import os
import sys

# Run isolated (python3 -I): no PYTHONPATH, no user site, and not the current folder on the
# module path, which may be a repository with a file named like a standard module. A start
# without -I (from a #! line or a hook command) restarts once with it.
if not sys.flags.isolated and __name__ == "__main__":
    os.execv(sys.executable, [sys.executable, "-I", os.path.abspath(__file__)] + sys.argv[1:])
import argparse
import bisect
import builtins
import codecs
import html.entities
import keyword
import re
import signal
import stat
import time
import unicodedata
import warnings

MARKER = "hygiene:ignore-file"

# Every codepoint below is written as an escape, so this file is plain ASCII.

# Characters that never belong in a file.
INVISIBLE = {
    0x200B: "ZERO WIDTH SPACE",
    0x2060: "WORD JOINER",
    0x00AD: "SOFT HYPHEN",
    0x2028: "LINE SEPARATOR",
    0x2029: "PARAGRAPH SEPARATOR",
}
# Characters with a real use in some writing systems. Allowed there, hard elsewhere.
ZWNJ, ZWJ, LRM, RLM, ALM, BOM = 0x200C, 0x200D, 0x200E, 0x200F, 0x061C, 0xFEFF
NBSP, NNBSP = 0x00A0, 0x202F
KEYCAP = 0x20E3

# Hidden-text characters. These hide or reorder text: tag characters spell out
# invisible ASCII that models still read (prompt injection, "ASCII smuggling"),
# bidi controls make code display differently from how it runs ("Trojan Source"),
# variation selectors and private-use characters can carry hidden bytes, and blank
# lookalikes pass for spaces or empty identifiers. Tools sold as AI "watermark
# removers" mostly strip these; they are copy-paste and injection artifacts, not a
# model's statistical watermark.
TAG_RUN = re.compile("[\U000E0000-\U000E007F]+")
VS_RUN = re.compile("[\ufe00-\ufe0f\U000E0100-\U000E01EF]{2,}")
PUA_RUN = re.compile("[\ue000-\uf8ff\U000F0000-\U000FFFFD\U00100000-\U0010FFFD]+")
PUA_HARD_RUN = 8
LOOKALIKE_RUN = re.compile("[\uff21-\uff3a\uff41-\uff5a\u24b6-\u24e9\U0001D400-\U0001D7FF]+")
ASCII_CONTROL = re.compile("[\x00-\x08\x0b\x0e-\x1f\x7f]|\r(?!$)")
BIDI = set(range(0x202A, 0x202F)) | set(range(0x2066, 0x206A))
BLANK_LOOKALIKE = {0x115F: "HANGUL CHOSEONG FILLER", 0x1160: "HANGUL JUNGSEONG FILLER",
                   0x3164: "HANGUL FILLER", 0xFFA0: "HALFWIDTH HANGUL FILLER",
                   0x2800: "BRAILLE PATTERN BLANK", 0x180E: "MONGOLIAN VOWEL SEPARATOR",
                   0x034F: "COMBINING GRAPHEME JOINER",
                   0x17B4: "KHMER VOWEL INHERENT AQ", 0x17B5: "KHMER VOWEL INHERENT AA",
                   0x1D159: "MUSICAL SYMBOL NULL NOTEHEAD", 0x16FE4: "KHITAN SMALL SCRIPT FILLER"}
MONGOLIAN_SELECTORS = (0x180B, 0x180C, 0x180D, 0x180F)
INVISIBLE_MATH = (0x2061, 0x2062, 0x2063, 0x2064)
ARABIC_FORMAT = (0x0600, 0x0601, 0x0602, 0x0603, 0x0604, 0x0605, 0x06DD, 0x070F, 0x08E2)
WORD = re.compile(r"[^\W\d_]+")

# Letters from other scripts that read as Latin letters. A word mixing them with Latin
# letters, or made only of them, is a homoglyph: it looks like one name and is another.
# Letters that do not look Latin (Greek delta, lambda) are left alone.
SCRIPTS = ((0x0370, 0x03FF, "Greek"), (0x1F00, 0x1FFF, "Greek"), (0x0400, 0x052F, "Cyrillic"),
           (0x0530, 0x058F, "Armenian"), (0x13A0, 0x13FF, "Cherokee"), (0x0250, 0x02AF, "IPA"),
           (0xA4D0, 0xA4FF, "Lisu"), (0x2C80, 0x2CFF, "Coptic"), (0xA640, 0xA69F, "Cyrillic"),
           (0x1400, 0x167F, "Canadian syllabics"), (0x0131, 0x0131, "Latin dotless"), (0x01C0, 0x01C3, "Latin click"),
           (0x0237, 0x0237, "Latin dotless"), (0x1D00, 0x1DBF, "Latin phonetic"), (0xA720, 0xA7FF, "Latin extended"),
           (0xAB30, 0xAB6F, "Latin extended"))
FLAG_TAGS = ("gbeng", "gbsct", "gbwls")          # England, Scotland, Wales: the only tag-sequence flags
MAX_SCAN_BYTES = 2000000
MAX_FINDINGS = 200
PUA_HARD_FILE = 8        # this many private-use characters in one file can carry a message, however they are spread
CARRIER_MIN = 16         # joiners and direction marks in a file before their share of the text is looked at
CARRIER_SHARE = 25       # percent of the letters that use them; real text stays under 10
IVS_HARD_FILE = 16       # likewise for ideographic variation selectors, one after each Han character
NOTE_SCAN_CHARS = 2000   # how much of one hidden note is checked for instruction-like wording
def _latin_tricks():
    """Latin small capitals, turned and dotless letters: Latin by script, not folded by NFKC,
    and read as plain letters (U+1D04 looks like c)."""
    found = {"\u0237"}
    for lo, hi in ((0x0250, 0x02AF), (0x1D00, 0x1DBF), (0xA720, 0xA7FF), (0xAB30, 0xAB6F)):
        for o in range(lo, hi + 1):
            name = unicodedata.name(chr(o), "")
            if "LETTER" in name and ("SMALL CAPITAL" in name or "TURNED" in name or "DOTLESS" in name):
                found.add(chr(o))
    return found


