class Finding(object):
    def __init__(self, sev, line, col, code, detail):
        self.sev, self.line, self.col, self.code, self.detail = sev, line, col, code, detail

    def fmt(self, path):
        # A file name can hold control characters; shown raw they would reach the terminal.
        shown = "".join(c if c.isprintable() else "\\x%02x" % ord(c) if ord(c) < 256 else "\\u%04x" % ord(c) for c in path)
        loc = "%s:%d:%d" % (shown, self.line, self.col)
        return "%-5s %-28s %s  %s" % (self.sev, loc, self.code, self.detail)


MANIFEST_NAMES = {"package.json", "package-lock.json", "composer.json", "deno.json", "tsconfig.json", "pyproject.toml",
                  "pipfile", "cargo.toml", "go.mod", "gemfile", "pubspec.yaml", "docker-compose.yml", "docker-compose.yaml",
                  "compose.yml", "compose.yaml", "action.yml", "action.yaml", "azure-pipelines.yml", "azure-pipelines.yaml",
                  "bitbucket-pipelines.yml", "bitbucket-pipelines.yaml", ".pre-commit-config.yaml", ".pre-commit-config.yml",
                  "pnpm-lock.yaml", "pnpm-lock.yml", ".yarnrc.yml", ".yarnrc.yaml", ".travis.yml", "environment.yml",
                  "environment.yaml", "pnpm-workspace.yaml", "setup.cfg", "renovate.json", "pom.xml"}


def is_manifest(name):
    """A dependency manifest or a CI workflow: every name in it must be exactly what it looks like."""
    base = os.path.basename(name).lower()
    spelled = "/" + name.replace(os.sep, "/").lower()
    return base in MANIFEST_NAMES or (base.endswith(".txt") and ("requirements" in base or base.startswith("constraints")
                                                                 or "/requirements/" in spelled)) \
        or "/.github/workflows/" in spelled or "/.github/actions/" in spelled or "/.gitlab-ci" in spelled \
        or "/.circleci/config.yml" in spelled or "/.circleci/config.yaml" in spelled \
        or ("/.gitlab/" in spelled and base.endswith((".yml", ".yaml"))) \
        or ("compose" in base and base.endswith((".override.yml", ".override.yaml")))


# Free text in a manifest or CI file, which only warns, against the names a tool resolves, which
# must be exact. manifest_mask() marks each character 1 (text) or 2 (exact); 0 leaves it to the
# line rules in _scan_chars.
CI_TEXT_KEYS = {"name", "displayname", "description", "run-name", "context", "default"}
CI_COMMAND_KEYS = {"run", "script", "command", "bash", "pwsh", "powershell", "entry", "before_script", "after_script"}
# A mapping of variables (env: in GitHub, variables: in GitLab and Azure): each value is text a
# step reads (a greeting, a label); the variable names, and a variable group or template, are exact.
CI_ENV_KEYS = {"env", "variables"}
CI_ENV_EXACT = {"name", "group", "template"}
CI_KEY = re.compile(r"([ \t]*(?:-[ \t]+)*)([A-Za-z_][\w-]*)[ \t]*:(?:[ \t]+|[ \t]*\r?$)")
YAML_BLOCK_START = re.compile(r"[|>][-+0-9]*[ \t]*(?:#.*)?\r?$")
SHELL_ASSIGN = re.compile(r"[A-Za-z_][A-Za-z0-9_]*\+?=")
SHELL_HEREDOC = re.compile(r"<<-?[ \t]*(['\"]?)([A-Za-z_][A-Za-z0-9_]*)\1")
SHELL_PREFIX = {"if", "then", "else", "elif", "do", "while", "until", "!", "{", "sudo", "exec", "time", "env", "command",
                "nohup"}
TOML_TEXT_KEYS = {"description", "author", "authors", "maintainers", "homepage", "documentation", "keywords"}
JSON_TEXT_KEYS = {"description", "author", "authors", "contributors", "maintainers", "keywords"}
JSON_TOP_TEXT_KEYS = {"homepage", "bugs", "funding", "support"}
# Maps whose keys are package or command names: an "author" there is a package called author.
JSON_NAME_MAP = re.compile(r"(?i)(?:dependencies|require(?:-dev)?|overrides|resolutions|imports|scopes|catalogs?|packages"
                           r"|bin|scripts|repositories|workspaces|engines)$")


def is_ci_yaml(name):
    base = os.path.basename(name).lower()
    spelled = "/" + name.replace(os.sep, "/").lower()
    return base.endswith((".yml", ".yaml")) and ("/.github/" in spelled or "/.circleci/" in spelled or "/.gitlab/" in spelled
                                                 or base == ".travis.yml" or base.startswith(
        ("azure-pipelines.", "bitbucket-pipelines.", ".gitlab-ci", ".pre-commit-config.", "action.")))


def _shell_mask(text, a, b, mask, folded=False):
    """Mark the shell script in text[a:b]: each command word exact, the rest (arguments, assigned
    values, quoted strings, comments, here-documents) text. folded: a YAML > scalar, whose line
    breaks are spaces."""
    mask[a:b] = bytes([1]) * (b - a)
    cmd, heredoc, k = True, None, a
    while k < b:
        c = text[k]
        if c == "\n":
            ends = not folded and text[k - 1:k] != "\\"
            k += 1
            if heredoc:
                while k < b:
                    end = text.find("\n", k, b)
                    end = b if end < 0 else end
                    done = text[k:end].strip() == heredoc
                    k = end + 1
                    if done:
                        break
                heredoc, ends = None, True
            cmd = cmd or ends
        elif c in " \t\r":
            k += 1
        elif c == "#":
            end = text.find("\n", k, b)
            k = b if end < 0 else end
        elif c in ";&|()`":
            cmd, k = True, k + 1
        else:
            start, quote = k, None
            while k < b:
                ch = text[k]
                if quote:
                    if ch == "\\" and quote == '"':
                        k += 1
                    elif ch == quote:
                        quote = None
                elif ch in "\"'":
                    quote = ch
                elif ch == "\\":
                    k += 1
                elif ch in " \t\r\n;&|()`":
                    break
                k += 1
            k = min(k, b)
            word = text[start:k]
            here = SHELL_HEREDOC.match(text, start, b) if word.startswith("<<") and not word.startswith("<<<") else None
            if here:
                heredoc, k = here.group(2), max(k, here.end())
            elif cmd and not SHELL_ASSIGN.match(word) and word not in SHELL_PREFIX:
                mask[start:k] = bytes([2]) * (k - start)
                cmd = False


def _ci_value(text, lines, starts, i, at, col, mask, command):
    """Mark the scalar that starts at column at of line i and runs on over the lines deeper than
    col (a block scalar, or a plain one folded over lines). Returns the line after it."""
    j = i + 1
    while j < len(lines) and (not lines[j].strip() or len(lines[j]) - len(lines[j].lstrip(" \t")) > col):
        j += 1
    value = lines[i][at:]
    block = YAML_BLOCK_START.match(value)
    a = (starts[i + 1] if i + 1 < len(lines) else len(text)) if block else starts[i] + at
    if command and not block and value[:1] in ("'", '"'):
        a += 1                            # a quoted YAML scalar: the script is inside the quotes
    b = starts[j - 1] + len(lines[j - 1])
    if b > a:
        if command:
            _shell_mask(text, a, b, mask, folded=not (block and value.startswith("|")))
        else:
            mask[a:b] = bytes([1]) * (b - a)
    return j


def _ci_env(text, lines, starts, i, col, mask):
    """Mark the values of the variables mapping on the lines after i deeper than col as text.
    Returns the line after it."""
    while i < len(lines):
        line = lines[i]
        if line.strip() and not line.lstrip().startswith("#"):
            if len(line) - len(line.lstrip(" \t")) <= col:
                break
            m = CI_KEY.match(line)
            value = line[m.end():] if m else ""
            # A flow mapping or list is left to the line rules; an empty value opens a nested
            # mapping (GitLab value: and description:), whose lines are read in turn.
            if value.strip() and not value.lstrip().startswith(("#", "{", "[")) \
                    and m.group(2).lower() not in CI_ENV_EXACT:
                i = _ci_value(text, lines, starts, i, m.end(), len(m.group(1)), mask, False)
                continue
        i += 1
    return i


def _ci_parent(lines, i, col):
    """The key of the mapping that the key at column col of line i belongs to."""
    for j in range(i - 1, -1, -1):
        m = CI_KEY.match(lines[j])
        if m and len(m.group(1)) < col:
            return m.group(2).lower()
    return ""


def _ci_mask(text, mask):
    lines = text.split("\n")
    starts, at = [], 0
    for line in lines:
        starts.append(at)
        at += len(line) + 1
    i = 0
    while i < len(lines):
        m = CI_KEY.match(lines[i])
        key = m.group(2).lower() if m else ""
        command = key in CI_COMMAND_KEYS
        if key in CI_ENV_KEYS and not lines[i][m.end():].split("#", 1)[0].strip():
            i = _ci_env(text, lines, starts, i + 1, len(m.group(1)), mask)
            continue
        if key == "name" and _ci_parent(lines, i, len(m.group(1))) in ("image", "services"):
            # GitLab image: name: and services: - name: are the image pulled, not a label.
            mask[starts[i] + m.end():starts[i] + len(lines[i])] = bytes([2]) * (len(lines[i]) - m.end())
            i += 1
            continue
        if not command and key not in CI_TEXT_KEYS:
            i += 1
            continue
        col = len(m.group(1))
        value = lines[i][m.end():]
        if value.strip() and not value.lstrip().startswith("#"):
            i = _ci_value(text, lines, starts, i, m.end(), col, mask, command)
            continue
        i += 1
        if not command:
            continue
        # A list of commands (script: in GitLab, Azure, Bitbucket), each item one script. A
        # mapping instead (CircleCI run: with name: and command:) is read key by key.
        item_col = None
        while i < len(lines):
            line = lines[i]
            if not line.strip() or line.lstrip().startswith("#"):
                i += 1
                continue
            item = re.match(r"([ \t]*)-(?:[ \t]+|[ \t]*\r?$)", line)
            indent = len(line) - len(line.lstrip(" \t"))
            if not item or indent < col or indent != (indent if item_col is None else item_col) \
                    or CI_KEY.match(line[item.end():]):
                break
            item_col = indent
            i = _ci_value(text, lines, starts, i, item.end(), indent, mask, True)


def _compose_mask(text, mask):
    """Mark the values of Compose environment: and labels: as text a container reads, in either
    form (KEY: value, or - KEY=value); image:, build: and the rest stay to the line rules."""
    lines = text.split("\n")
    starts, at = [], 0
    for line in lines:
        starts.append(at)
        at += len(line) + 1
    for i, line in enumerate(lines):
        m = CI_KEY.match(line)
        if m and m.group(2).lower() in ("command", "entrypoint"):
            # The program is exact; what it is given (an echo's message) is text, in either form.
            value = line[m.end():].split(" #", 1)[0]
            if value.lstrip().startswith("["):
                items = list(re.finditer(r"""(?:"(?:[^"\\\n]|\\.)*"|'[^'\n]*'|[^,\[\] \t]+)""", value))
                for item in items[1:]:
                    mask[starts[i] + m.end() + item.start():starts[i] + m.end() + item.end()] = bytes([1]) * len(item.group(0))
            elif value.strip():
                _shell_mask(text, starts[i] + m.end(), starts[i] + m.end() + len(value), mask)
            else:
                col, j = len(m.group(1)), i + 1
                while j < len(lines) and re.match(r"[ \t]*-[ \t]", lines[j]) \
                        and len(lines[j]) - len(lines[j].lstrip(" \t")) >= col:
                    if j > i + 1:
                        mask[starts[j]:starts[j] + len(lines[j])] = bytes([1]) * len(lines[j])
                    j += 1
            continue
        if not m or m.group(2).lower() not in ("environment", "labels") or line[m.end():].split("#", 1)[0].strip():
            continue
        labels = m.group(2).lower() == "labels"
        col = len(m.group(1))
        if not labels:
            _ci_env(text, lines, starts, i + 1, col, mask)
        j = i + 1
        while j < len(lines) and (not lines[j].strip() or len(lines[j]) - len(lines[j].lstrip(" \t")) > col):
            item = re.match(r"[ \t]*-[ \t]+[\"']?[^=\"'\s]+=", lines[j])
            if item:
                a = len(lines[j]) - len(lines[j].lstrip(" \t-")) if labels else item.end()
                mask[starts[j] + a:starts[j] + len(lines[j])] = bytes([1]) * (len(lines[j]) - a)
            elif labels and CI_KEY.match(lines[j]):
                a = len(lines[j]) - len(lines[j].lstrip(" \t"))
                mask[starts[j] + a:starts[j] + len(lines[j])] = bytes([1]) * (len(lines[j]) - a)
            j += 1


def _toml_value_end(text, k):
    """Where the TOML value that starts at k ends: the end of its line, or of the array, inline
    table or multi-line string that carries it over lines."""
    depth, n = 0, len(text)
    while k < n:
        c = text[k]
        if text.startswith(('"""', "'''"), k):
            end = text.find(text[k:k + 3], k + 3)
            k = n if end < 0 else end + 3
            continue
        if c in "\"'":
            k += 1
            while k < n and text[k] not in (c, "\n"):
                k += 2 if c == '"' and text[k] == "\\" else 1
            k += 1
            continue
        if c == "#":
            end = text.find("\n", k)
            k = n if end < 0 else end
            continue
        if c in "[{":
            depth += 1
        elif c in "]}":
            depth -= 1
        elif c == "\n" and (depth <= 0 or re.match(r"\[|[A-Za-z0-9_\"'-]+[ \t]*=", text[k + 1:k + 200])):
            return k                      # done, or a table or key at the start of a line: the value never closed
        k += 1
    return n


def _toml_mask(text, mask):
    table, pos = [], 0
    while pos < len(text):
        end = text.find("\n", pos)
        end = len(text) if end < 0 else end
        line = text[pos:end]
        header = re.match(r"[ \t]*\[\[?([^\]\n]*)\]", line)
        kv = re.match(r"""[ \t]*([A-Za-z0-9_.\"' -]+?)[ \t]*=[ \t]*""", line)
        if header:
            table = [p.strip().strip("\"'").lower() for p in header.group(1).split(".")]
        elif kv:
            # Every value is stepped over whole, so a line inside a dependency array is never read as a key.
            stop = _toml_value_end(text, pos + kv.end())
            path = table + [p.strip().strip("\"'").lower() for p in kv.group(1).split(".")]
            # In a dependency table every key is a package name, "description" included.
            dependency = any("dependencies" in p for p in path[:-1])
            if dependency or path[-1] in TOML_TEXT_KEYS or path[-2:-1] == ["urls"]:
                mask[pos + kv.end():stop] = bytes([2 if dependency else 1]) * (stop - pos - kv.end())
            end = text.find("\n", stop)
            end = len(text) if end < 0 else end
        pos = end + 1


def _json_text(stack, key):
    """Whether a value under key in the innermost open container is text."""
    if not stack:
        return False
    is_object, holder, text = stack[-1]
    if text or not is_object or key is None:
        return text
    key = key.lower()
    if key in JSON_TOP_TEXT_KEYS and len(stack) == 1:
        return True
    return key in JSON_TEXT_KEYS and not (holder and JSON_NAME_MAP.search(holder))


def _json_mask(text, mask):
    stack, key, want_key, k, n = [], None, False, 0, len(text)
    while k < n:
        c = text[k]
        if text.startswith("//", k):
            end = text.find("\n", k)
            k = n if end < 0 else end
            continue
        if text.startswith("/*", k):
            end = text.find("*/", k + 2)
            k = n if end < 0 else end + 2
            continue
        if c in "{[":
            holder = key if stack and stack[-1][0] else (stack[-1][1] if stack else None)
            stack.append((c == "{", holder, _json_text(stack, key)))
            key, want_key = None, c == "{"
        elif c in "}]":
            if stack:
                stack.pop()
            want_key = False
        elif c == ",":
            want_key = bool(stack and stack[-1][0])
        elif c == '"':
            end = k + 1
            while end < n and text[end] not in ('"', "\n"):
                end += 2 if text[end] == "\\" else 1
            end = min(end + 1, n)
            if want_key:
                key, want_key = text[k + 1:end - 1], False
                is_text = bool(stack and stack[-1][2])
            else:
                is_text = _json_text(stack, key)
            mask[k:end] = bytes([1 if is_text else 2]) * (end - k)
            if not want_key and len(stack) == 2 and stack[-1][0] and stack[-1][1] == "scripts" and text[end - 1:end] == '"':
                _shell_mask(text, k + 1, end - 1, mask)       # an npm script: commands exact, arguments text
            k = end
            continue
        k += 1


# pom.xml elements that describe the project or its people; coordinates, versions and the
# URLs a build fetches from stay exact. A direct project URL is descriptive, while a URL nested
# in repositories, dependencies or plugins is resolved by the build.
POM_TEXT = re.compile(r"<(name|description|organization|email|roles?|timezone|comments|inceptionYear)>(.*?)</\1>", re.S)
POM_URL = re.compile(r"<url>(.*?)</url>", re.S)
POM_EXACT_URL_PARENTS = ("repositories", "pluginRepositories", "distributionManagement", "dependencies", "plugins")


def _pom_url_is_text(text, at):
    """A project or person URL is text; a URL under a build-coordinate container is exact."""
    before = text[:at].lower()
    return not any(before.rfind("<" + tag.lower()) > before.rfind("</" + tag.lower())
                   for tag in POM_EXACT_URL_PARENTS)
# setup.cfg [metadata] keys that are text; requirement keys elsewhere stay exact.
CFG_TEXT_KEYS = {"description", "long_description", "summary", "author", "maintainer", "keywords", "author_email",
                 "maintainer_email", "license", "url", "home_page", "download_url", "project_urls"}


def _cfg_mask(text, mask):
    section, key, at = "", None, 0
    for line in text.split("\n"):
        head = re.match(r"\[([^\]]+)\]", line)
        if head:
            section, key = head.group(1).strip().lower(), None
        elif line[:1] in " \t" and line.strip():
            pass                          # a continuation line belongs to the key above it
        else:
            m = re.match(r"([A-Za-z_][\w.-]*)[ \t]*[=:]", line)
            key = m.group(1).lower() if m else None
        if section == "metadata" and key in CFG_TEXT_KEYS:
            k = at + (0 if line[:1] in " \t" else re.search("[=:]", line).end())
            mask[k:at + len(line)] = bytes([1]) * (at + len(line) - k)
        at += len(line) + 1


def manifest_mask(text, name):
    """1 for each character of free text (an author, a step name, a command's arguments), 2 for
    each that a tool resolves as a name; None for a file this does not read."""
    base = os.path.basename(name).lower()
    mask = bytearray(len(text))
    if base.endswith(".json"):
        _json_mask(text, mask)
    elif base in ("pyproject.toml", "cargo.toml", "pipfile"):
        _toml_mask(text, mask)
    elif is_ci_yaml(name):
        _ci_mask(text, mask)
    elif "compose" in base and base.endswith((".yml", ".yaml")):
        _compose_mask(text, mask)
    elif base == "pom.xml":
        for m in POM_TEXT.finditer(text):
            mask[m.start(2):m.end(2)] = bytes([1]) * (m.end(2) - m.start(2))
        for m in POM_URL.finditer(text):
            if _pom_url_is_text(text, m.start()):
                mask[m.start(1):m.end(1)] = bytes([1]) * (m.end(1) - m.start(1))
    elif base == "setup.cfg":
        _cfg_mask(text, mask)
    else:
        return None
    return mask


def is_helm_template(name):
    """A Helm chart template (chart/templates/x.yaml): YAML data with Go-template code in {{ }}."""
    spelled = "/" + name.replace(os.sep, "/").lower()
    return "/templates/" in spelled and spelled.endswith((".yaml", ".yml"))


def kind(name):
    base = os.path.basename(name).lower()
    ext = os.path.splitext(base)[1]
    if is_manifest(name):
        return "code"
    if ext in PROSE_EXT or (not ext and base in PROSE_NAMES):
        return "prose"
    return "data" if ext in DATA_EXT else "code"


def is_prose(name):
    return kind(name) == "prose"


# Where strings and comments are, by language. Enough to tell text from code for the rules
# below; it is not a parser, and a language it does not know gets the cautious answer.
LINE_COMMENTS = {".raku": ("#",), ".rakumod": ("#",), ".lean": ("--",), ".agda": ("--",), ".fs": ("//",),
                 ".fsx": ("//",), ".fsi": ("//",), ".adb": ("--",), ".ads": ("--",), ".vhdl": ("--",), ".purs": ("--",),
                 ".idr": ("--",), ".f90": ("!",), ".f95": ("!",), 
    ".py": ("#",), ".pyi": ("#",), ".sh": ("#",), ".bash": ("#",), ".zsh": ("#",), ".ksh": ("#",), ".fish": ("#",), ".rb": ("#",),
    ".pl": ("#",), ".pm": ("#",), ".r": ("#",), ".jl": ("#",), ".ex": ("#",), ".exs": ("#",), ".nim": ("#",),
    ".yaml": ("#",), ".yml": ("#",), ".toml": ("#",), ".ini": (";", "#"), ".cfg": (";", "#"), ".conf": ("#",),
    ".tf": ("#", "//"), ".ps1": ("#",), ".mk": ("#",), ".cmake": ("#",), ".dockerfile": ("#",),
    ".lisp": (";",), ".el": (";",), ".clj": (";",), ".cljs": (";",), ".scm": (";",), ".rkt": (";",), ".asm": (";",),
    ".m": ("%",), ".erl": ("%",), ".hrl": ("%",), ".tex": ("%",), ".sty": ("%",),
    ".lua": ("--",), ".sql": ("--",), ".hs": ("--",), ".elm": ("--",), ".ada": ("--",), ".vhd": ("--",),
    ".vb": ("'",), ".bas": ("'",), ".bat": ("REM ", "::"), ".cmd": ("REM ", "::"),
}
# Languages where "#" is code (a private field, #define, #[attr], a Swift #"raw"# string) and
# only "//" starts a line comment. A language in neither table keeps both, the cautious answer.
SLASH_COMMENT_ONLY = {".js", ".jsx", ".mjs", ".cjs", ".ts", ".tsx", ".c", ".h", ".cc", ".cpp", ".cxx", ".hpp", ".hh",
                      ".hxx", ".cu", ".mm", ".rs", ".swift", ".cs", ".java", ".go", ".kt", ".kts", ".scala", ".dart",
                      ".groovy", ".gradle", ".zig", ".proto", ".css", ".scss", ".less", ".vue", ".svelte", ".astro"}
BLOCK_COMMENTS = {
    ".lean": (("/-", "-/"),), ".agda": (("{-", "-}"),), ".fs": (("(*", "*)"),), ".fsx": (("(*", "*)"),),
    ".purs": (("{-", "-}"),), ".idr": (("{-", "-}"),), ".adb": (), ".ads": (), ".vhdl": (), ".f90": (), ".f95": (),
    ".py": (), ".pyi": (), ".sh": (), ".bash": (), ".zsh": (), ".rb": (), ".yaml": (), ".yml": (), ".toml": (),
    ".lua": (("--[[", "]]"),), ".hs": (("{-", "-}"),), ".elm": (("{-", "-}"),), ".ml": (("(*", "*)"),),
    ".html": (("<!--", "-->"),), ".htm": (("<!--", "-->"),), ".xml": (("<!--", "-->"),), ".svg": (("<!--", "-->"),),
    ".vue": (("<!--", "-->"), ("/*", "*/")), ".svelte": (("<!--", "-->"), ("/*", "*/")),
    ".lisp": (("#|", "|#"),), ".clj": (), ".el": (), ".scm": (("#|", "|#"),), ".m": (("%{", "%}"),),
    ".jl": (("#=", "=#"),), ".ps1": (("<#", "#>"),),
}
TRIPLE_QUOTES = {".py", ".pyi", ".kt", ".kts", ".scala", ".swift", ".jl", ".groovy", ".dart", ".java", ".nim", ".ex", ".exs",
                 ".cs", ".toml", ".graphql", ".gql"}
# Languages whose ordinary quoted strings may run over several lines.
MULTILINE_QUOTES = {".rs": '"', ".r": "\"'", ".sql": "'\"", ".php": "\"'", ".rb": "\"'", ".pl": "\"'", ".pm": "\"'",
                    ".sh": "'\"", ".bash": "'\"", ".zsh": "'\"", ".ps1": "'\""}
MULTILINE_BACKTICK = {".js", ".jsx", ".mjs", ".cjs", ".ts", ".tsx", ".go", ".vue", ".svelte", ".astro"}
HEREDOC = {".sh", ".bash", ".zsh", ".rb", ".php", ".pl", ".pm", ".tf"}
CHAR_LITERAL = {".c", ".h", ".cc", ".cpp", ".hpp", ".cxx", ".hh", ".hxx", ".java", ".rs", ".go", ".kt", ".scala", ".cs", ".swift", ".zig"}
NO_SINGLE_QUOTE = {".lisp", ".el", ".clj", ".cljs", ".scm", ".rkt", ".ml", ".hs", ".elm", ".vb", ".bas", ".tex"}
KNOWN_CODE = set(LINE_COMMENTS) | set(BLOCK_COMMENTS) | TRIPLE_QUOTES | MULTILINE_BACKTICK | CHAR_LITERAL | {
    ".c", ".h", ".cu", ".cxx", ".hh", ".hxx", ".mm", ".ksh", ".js", ".ts", ".tsx", ".jsx", ".mjs", ".cjs", ".go", ".rs", ".java", ".kt", ".swift", ".cs", ".php",
    ".css", ".scss", ".less", ".dart", ".zig", ".groovy", ".gradle", ".proto", ".graphql"}
TEXT_STRING, TEXT_COMMENT = 1, 2
MARKUP_CODE = {".jsx", ".tsx", ".vue", ".svelte", ".astro", ".php", ".erb", ".ejs", ".hbs", ".jinja", ".j2", ".twig",
               ".razor", ".cshtml", ".liquid", ".njk", ".tmpl", ".gotmpl", ".gohtml", ".mustache", ".jsp", ".aspx", ".ascx",
               ".vm", ".mako", ".heex", ".eex", ".leex", ".templ", ".tpl", ".marko", ".typ", ".qmd", ".rmd"}
KNOWN_CODE |= MARKUP_CODE
SCRIPT_BLOCK = re.compile(r"<(script|style)\b[^>]{0,500}>", re.I)
# A JSX tag. A closing tag is always one; an opening tag is not right after a name, ")" or
# "]", where "<" opens a type argument (Array<string>, f<T>()), and <T extends X> or <T,>
# are type parameters. Attributes may hold {expressions} with their own < > and =>.
JSX_TAG = re.compile(r"</[A-Za-z][\w.:-]{0,80}[ \t\n]*>|</>"
                     r"|(?<![\w$.\])])<(?:[A-Za-z][\w.:-]{0,80}(?:[ \t\n](?:[^<>{}]|\{(?:[^{}]|\{(?:[^{}]|\{(?:[^{}]|\{(?:[^{}]|\{[^{}]{0,400}\}){0,800}\}){0,800}\}){0,800}\}){0,800}\}){0,800}?)?/?)?>")
TYPE_PARAMS = re.compile(r"<[A-Za-z_$][\w$]*[ \t]*(?:,|extends\b)")
JSX_TEXT_LIMIT = 20000
CODE_BLOCKS = {".php": (("<?php", "?>"), ("<?=", "?>")), ".erb": (("<%", "%>"),), ".ejs": (("<%", "%>"),),
               ".hbs": (("{{", "}}"),), ".jinja": (("{%", "%}"), ("{{", "}}")), ".j2": (("{%", "%}"), ("{{", "}}")),
               ".twig": (("{%", "%}"), ("{{", "}}")), ".liquid": (("{%", "%}"), ("{{", "}}")),
               ".njk": (("{%", "%}"), ("{{", "}}")), ".tmpl": (("{{", "}}"),), ".gotmpl": (("{{", "}}"),),
               ".gohtml": (("{{", "}}"),), ".mustache": (("{{", "}}"),), ".jsp": (("<%", "%>"), ("${", "}")),
               ".aspx": (("<%", "%>"),), ".ascx": (("<%", "%>"),), ".mako": (("<%", "%>"), ("${", "}")),
               ".heex": (("<%", "%>"), ("<%=", "%>"), ("{", "}")), ".eex": (("<%", "%>"),),
               ".leex": (("<%", "%>"),), ".templ": (("{{", "}}"), ("{", "}")), ".tpl": (("{{", "}}"),),
               ".marko": (("${", "}"),)}

_HBS_COMMENT = re.compile(r"\{\{!--.*?--\}\}|\{\{!.*?\}\}", re.S)
_ASP_COMMENT = re.compile(r"<%--.*?--%>", re.S)
_EEX_COMMENT = re.compile(r"<%!--.*?--%>", re.S)
TEMPLATE_COMMENTS = {".hbs": _HBS_COMMENT, ".mustache": _HBS_COMMENT, ".jsp": _ASP_COMMENT, ".aspx": _ASP_COMMENT,
                     ".ascx": _ASP_COMMENT, ".heex": _EEX_COMMENT, ".eex": _EEX_COMMENT, ".leex": _EEX_COMMENT,
                     ".mako": re.compile(r"<%doc>.*?</%doc>|^[ \t]*##[^\n]*", re.S | re.M),
                     ".tpl": re.compile(r"\{\*.*?\*\}", re.S)}


def _block_end(text, closer, at, quotes):
    """Where a code block closes; with quotes, a closer inside a quoted string does not count."""
    n = len(text)
    while at < n:
        nxt = text.find(closer, at)
        if nxt < 0:
            return n
        if not quotes:
            return nxt
        q = PHP_SKIP.search(text, at, nxt)
        if q is None:
            return nxt
        if q.group(0) in ("//", "#"):
            eol = text.find("\n", q.end(), nxt)
            if eol < 0:
                return nxt                # the comment reaches the closer, which ends it
            at = eol + 1
            continue
        if q.group(0) == "/*":
            end = text.find("*/", q.end())
            at = n if end < 0 else end + 2
            continue
        if q.group(1):
            # A heredoc or nowdoc runs to a line that starts with its name.
            end = re.compile(r"(?m)^[ \t]*" + re.escape(q.group(1)) + r"\b").search(text, q.end())
            at = n if end is None else end.end()
            continue
        end = q.start() + 1
        while end < n and text[end] != q.group(0):
            end += 2 if text[end] == "\\" else 1
        at = end + 1
    return n


# What a closer cannot end inside, in PHP: a quoted string, a /* comment */, a heredoc or nowdoc.
# A // or # comment runs to the end of its line or to ?>, whichever comes first, as PHP reads it.
PHP_SKIP = re.compile(r"""[\"'`]|/\*|//|#(?!\[)|<<<[ \t]*["']?([A-Za-z_]\w*)["']?[ \t]*\n""")


# A closing or self-closing JSX tag, or a fragment: the sign of JSX in a .js file.
JSX_IN_JS = re.compile(r"</[A-Za-z][\w.:-]{0,80}>|<[A-Za-z][\w.:-]{0,80}(?:[ \t\n](?:[^<>{}]|\{(?:[^{}]|\{(?:[^{}]|\{(?:[^{}]|\{(?:[^{}]|\{[^{}]{0,400}\}){0,800}\}){0,800}\}){0,800}\}){0,800}\}){0,800}?)?/>|<>|</>")


def _balanced_end(text, start, opener, closer, js=False, py=False, sh=False):
    """Return just after a balanced code expression, ignoring delimiters in quoted strings and,
    with js, in comments and regex literals; with py (an f-string replacement field), in # comments,
    which Python 3.12 allows in a field that spans lines (not in its format spec)."""
    depth, i, n = 1, start + 1, len(text)
    spec, parens = False, 0
    while i < n:
        c = text[i]
        if js and c == "/":
            if text.startswith("/*", i):
                end = text.find("*/", i + 2)
                i = n if end < 0 else end + 2
                continue
            if text.startswith("//", i):
                end = text.find("\n", i)
                i = n if end < 0 else end
                continue
            k = i - 1
            while k > start and text[k] in " \t\r\n":
                k -= 1
            if not (text[k].isalnum() or text[k] in "_$)]}\"'`"):
                k, cls = i + 1, False
                while k < n and text[k] != "\n" and (cls or text[k] != "/"):
                    if text[k] == "\\":
                        k += 1
                    elif text[k] in "[]":
                        cls = text[k] == "["
                    k += 1
                if k < n and text[k] == "/":
                    i = k + 1
                    continue
        if c in "\"'`":
            q, triple = c, text.startswith(c * 3, i)
            i += 3 if triple else 1
            while i < n:
                if sh and q == '"' and text.startswith("$(", i):
                    i = _balanced_end(text, i + 1, "(", ")", sh=True)     # a substitution nests in "..."
                elif text[i] == "\\" and not (sh and q == "'"):
                    i += 2
                elif triple and text.startswith(q * 3, i):
                    i += 3
                    break
                elif not triple and text[i] == q:
                    i += 1
                    break
                else:
                    i += 1
            continue
        if py:
            if c == "#" and not (spec and depth == 1):
                end = text.find("\n", i)
                i = n if end < 0 else end
                continue
            if c in "([":
                parens += 1
            elif c in ")]":
                parens -= 1
            elif c == ":" and depth == 1 and parens <= 0:
                spec = True                   # f"{n:#x}": the format spec, where # is a flag
        if c == opener:
            depth += 1
        elif c == closer:
            depth -= 1
            if depth == 0:
                return i + 1
        i += 1
    return n


def template_mask(text, ext):
    """1 for each character of template text (prose a page shows), 0 for code, in a file that
    mixes the two: outside the script blocks of Vue and Svelte, outside the frontmatter and
    scripts of Astro, outside the code blocks of PHP and template languages, and between the
    tags of JSX. None for other files."""
    if ext in (".js", ".mjs", ".cjs"):
        # React code is often kept in .js files. Tags inside strings and comments (HTML built
        # by DOM code) are not JSX.
        spans = text_spans(text, "x.js")
        code = "".join(" " if spans[k] else c for k, c in enumerate(text))
        if JSX_IN_JS.search(code):
            ext = ".jsx"
    if ext not in MARKUP_CODE:
        return None
    n = len(text)
    if ext in (".jsx", ".tsx"):
        mask = bytearray(n)
        open_tags, closings = 0, None
        for m in JSX_TAG.finditer(text):
            if TYPE_PARAMS.match(m.group(0)):
                continue
            tag = m.group(0).strip()
            if tag.startswith("</"):
                open_tags = max(0, open_tags - 1)
            elif not tag.endswith("/>"):
                # An opening tag needs its closing tag further on; "i <n && j >m" has none.
                name = re.match(r"<([A-Za-z][\w.:-]*)", tag)
                if closings is None:
                    closings = {}
                    for c in re.finditer(r"</([A-Za-z][\w.:-]*)?", text):
                        closings.setdefault(c.group(1) or "", []).append(c.start())
                ends = closings.get(name.group(1) if name else "", [])
                first = bisect.bisect_left(ends, m.end())
                # A closing tag inside a // comment does not count (it would let code read as text).
                if not any(not re.search(r"(?:^|[ \t;])//", text[text.rfind("\n", 0, k) + 1:k])
                           for k in ends[first:first + 50]):
                    continue
                open_tags += 1
            if open_tags == 0:
                continue                  # the outermost element closed: code follows, not page text
            # Text runs to the next tag; a {child expression} inside it is code, and the text
            # goes on after it. A "}" with no "{" ends it (the tag was inside an expression).
            k, depth, stop = m.end(), 0, min(n, m.end() + JSX_TEXT_LIMIT)
            while k < stop:
                c = text[k]
                if c == "<" and depth == 0:
                    break
                if c == "{":
                    depth += 1
                elif c == "}":
                    if depth == 0:
                        break
                    depth -= 1
                elif depth == 0:
                    mask[k] = 1
                k += 1
        return mask
    mask = bytearray(b"\x01" * n)
    # A script or style block runs in the browser whatever template language serves the page.
    for m in SCRIPT_BLOCK.finditer(text):
        end = re.compile(r"</" + m.group(1) + r"[ \t\n]*>", re.I).search(text, m.end())
        close = end.start() if end else -1
        close = n if close < 0 else close
        mask[m.end():close] = bytes(close - m.end())
    if ext in (".vue", ".svelte", ".astro"):
        if ext == ".astro" and text.startswith("---"):
            close = text.find("\n---", 3)
            close = n if close < 0 else close + 4
            mask[0:close] = bytes(close)
        # Expressions in the template are code: {{ }} and {...}, and bound attributes
        # (v-on, :prop, @event, on:event).
        for m in re.finditer(r"\{\{.*?\}\}|\{[^{}\n]{0,2000}\}", text, re.S):
            mask[m.start():m.end()] = bytes(m.end() - m.start())
        for m in re.finditer(r"""[ \t\n](?:v-[\w:.\-]+|:[\w.\-]+|@[\w.\-]+|on:[\w|\-]+)[ \t]*=[ \t]*("[^"]*"|'[^']*')""", text):
            mask[m.start(1) + 1:m.end(1) - 1] = b"\x02" * (m.end(1) - m.start(1) - 2)
        return mask
    for opener, closer in CODE_BLOCKS.get(ext, ()):
        pos = 0
        while True:
            if ext == ".php" and opener == "<?php":
                # PHP reads <?php in any case, and <? alone as a short tag (not <?xml).
                hit = re.compile(r"<\?(?:php\b|(?![=xX]))", re.I).search(text, pos)
                start = hit.start() if hit else -1
            else:
                start = text.find(opener, pos)
            if start < 0:
                break
            close = _block_end(text, closer, start + len(opener), ext == ".php")
            mask[start:close] = bytes(close - start)
            pos = close + len(closer)
    if ext in (".razor", ".cshtml"):
        for m in re.finditer(r"@(?:code|functions)?[ \t]*\{|@\{", text):
            close = _balanced_end(text, m.end() - 1, "{", "}")
            mask[m.start():close] = bytes(close - m.start())
        for m in re.finditer(r"@(?:[^\W\d]\w*(?:\.[^\W\d]\w*)*|\([^\n)]{0,2000}\))", text):
            mask[m.start():m.end()] = bytes(m.end() - m.start())
    if ext == ".vm":
        for m in re.finditer(r"(?:#[A-Za-z_]\w*[ \t]*\([^\n)]{0,2000}\)|\$!?\{?[A-Za-z_]\w*(?:\.[A-Za-z_]\w*)*\}?)", text):
            mask[m.start():m.end()] = bytes(m.end() - m.start())
    if ext == ".tpl":
        for m in re.finditer(r"\{[^{}\n]{1,2000}\}", text):
            mask[m.start():m.end()] = bytes(m.end() - m.start())
    if ext in (".qmd", ".rmd"):
        for m in re.finditer(r"(?ms)^```[^\n]*\n.*?^```[ \t]*$", text):
            mask[m.start():m.end()] = bytes(m.end() - m.start())
    comments = TEMPLATE_COMMENTS.get(ext)
    if comments:
        # A template comment is read as prose, not as template code.
        for m in comments.finditer(text):
            mask[m.start():m.end()] = b"\x01" * (m.end() - m.start())
    return mask
HEREDOC_RE = re.compile(r"<<<?[-~]?[ \t]*(['\"]?)([A-Za-z_][A-Za-z0-9_]{0,40})\1")
# A shell heredoc word: any quoting in it (<<\EOF, <<'EOF', <<E"O"F) makes the body literal.
SHELL_HEREDOC_WORD = re.compile(r"""<<(-?)[ \t]*((?:[A-Za-z0-9_.:+@%/-]|\\.|'[^'\n]{0,40}'|"[^"\n]{0,40}"){1,40})""")
# Ruby %q( ) %w[ ] and friends, Perl q( ) qq{ } qw< >, Rust r#"..."#: the opener and its closer.
BRACKET_CLOSE = {"(": ")", "[": "]", "{": "}", "<": ">"}


SHEBANG_EXT = (("python", ".py"), ("node", ".js"), ("deno", ".ts"), ("bun", ".ts"), ("ruby", ".rb"), ("perl", ".pl"),
               ("php", ".php"), ("lua", ".lua"), ("bash", ".sh"), ("zsh", ".sh"), ("fish", ".fish"), ("sh", ".sh"))
EXT_ALIASES = {".pyw": ".py", ".pyx": ".py", ".rake": ".rb", ".gemspec": ".rb", ".cts": ".ts", ".mts": ".ts", ".bats": ".sh"}


def effective_ext(name, text=""):
    """The extension whose rules apply: the file's own, an alias of it, or, for a file with
    none, the language its #! line names."""
    ext = os.path.splitext(name)[1].lower()
    if ext:
        return EXT_ALIASES.get(ext, ext)
    first = text[:200].split("\n", 1)[0] if text.startswith("#!") else ""
    for word, mapped in SHEBANG_EXT:
        if re.search(r"[/ ]%s[0-9.]*\b" % word, first):
            return mapped
    return ""


KNOWN_CODE_NAMES = ("dockerfile", "makefile", "gemfile", "rakefile")


def code_ext_of(name, text=""):
    """The extension whose code rules scan() applies, with the modes some file names set."""
    base = os.path.basename(name).lower()
    if re.match(r"(?:docker|container)file(?:\.[^/]*)?$", base):
        return ".dockerfile"              # a Dockerfile has no extension but its RUN lines are shell text
    if re.match(r"(?:gnu)?makefile$", base):
        return ".mk"                      # likewise a Makefile's recipe lines
    return effective_ext(name, text)


def move_rejudged(old, new):
    """Whether a file renamed from old to new may get another verdict, so must be scanned again."""
    judged = lambda q: (kind(q), is_manifest(q), effective_ext(q), os.path.splitext(q)[1].lower(), code_ext_of(q),
                        os.path.basename(q).lower() in KNOWN_CODE_NAMES)
    return judged(old) != judged(new)


REGEX_LITERAL_EXT = {".js", ".jsx", ".ts", ".tsx", ".mjs", ".cjs", ".rb", ".pl", ".pm"}


TEXT_TAIL_COMMENT = 3


def tail_comments(text, spans):
    """A copy of spans in which a comment that starts after code on its line is TEXT_TAIL_COMMENT.
    Only a comment that opens a line is read as a comment for escapes and names: one that opens
    mid-line may be a quote or regex the tokenizer misread, so what it holds is judged as code.
    A trailing comment of plain words (rate = 1  # course) holds nothing a program could run."""
    out = bytearray(spans)
    for run in re.finditer(b"\x02+", bytes(spans)):
        line_start = text.rfind("\n", 0, run.start()) + 1
        if text[line_start:run.start()].strip() and re.search(r"[()\[\]{}=;\"'`\\]", text[run.start() + 1:run.end()]):
            out[run.start():run.end()] = bytes([TEXT_TAIL_COMMENT]) * (run.end() - run.start())
    return out


def text_spans(text, name, literals=None, offset=0):
    """bytearray over text: TEXT_STRING inside a string, TEXT_COMMENT inside a comment, 0 in code.
    One pass that jumps from one opener to the next, so its cost is the length of the text.
    `literals`, when given, collects (start, end) of each string literal, offset by `offset`, so
    a check can read the prefix of the literal a column is in rather than of the run it is in."""
    ext = effective_ext(name, text)
    base = os.path.basename(name).lower()
    if base in ("dockerfile", "makefile", "gemfile", "rakefile", ".env"):
        ext = {"gemfile": ".rb", "rakefile": ".rb"}.get(base, ".sh")
    lines = LINE_COMMENTS.get(ext, ("//",) if ext in SLASH_COMMENT_ONLY else ("#", "//"))
    blocks = BLOCK_COMMENTS.get(ext, (("/*", "*/"),))
    quotes = '"`' if ext in NO_SINGLE_QUOTE else '"\'`'
    openers = [re.escape(t) for t in lines] + [re.escape(a) for a, _ in blocks] + [re.escape(q) for q in quotes]
    if ext in HEREDOC:
        openers.append("<<")
    if ext in (".rb",):
        openers.append(r"^=begin\b")
    if ext in (".pl", ".pm"):
        openers.append(r"^=[a-zA-Z]")
    if ext == ".lua":
        openers.append(r"\[=*\[")
    if ext == ".rb":
        openers.append(r"%[qQwWiIrxs]?[^\w\s]")
    if ext in (".rb", ".ex", ".exs"):
        openers.append(r"(?<![\w?])\?[^\x00-\x7f](?!\w)")   # a character literal: ?a
    if ext in (".pl", ".pm"):
        # Quote-like operators; not a hash key, variable, method or file test (y =>, $s, ->y, -s).
        # A # right after the operator is its delimiter (s#a#b#); after a blank it starts a comment.
        openers.append(r"(?<![\w$@%&*:>-])(?<!sub )(?:qr|q[qwx]?|tr|[msy])(?:#|[ \t]*[^\w\s=,;#)\]}>])")
    if ext in (".ex", ".exs"):
        openers.append(r"~[A-Za-z][A-Z0-9]*(?:\"\"\"|'''|[/|\"'(\[{<])")
    if ext == ".zig":
        openers.append(r"\\\\")
    if ext == ".rs":
        openers.append(r"b?r#+\"")
    if ext == ".swift":
        openers.append(r"#+\"")              # raw strings: #"..."#, ##"..."##, #"""..."""#
    if ext == ".ps1":
        openers.append(r"@[\"']")
    if ext == ".cs":
        openers.append(r"(?:\$@|@\$?)\"")
    if ext in (".c", ".h", ".cc", ".cpp", ".hpp", ".cxx", ".hh", ".hxx"):
        openers.append(r"(?:u8|[uUL])?R\"[^ ()\\\t\r\n]{0,16}\(")
    if ext in REGEX_LITERAL_EXT:
        openers.append(r"/")
    if ext in (".js", ".cjs", ".mjs"):
        openers += ["<!--", "-->"]          # Annex B HTML-like comments in a script
    if ext == ".sql":
        openers.append(r"\$[A-Za-z_]?\w{0,40}\$")      # Postgres dollar quoting: $$...$$, $body$...$body$
    finder = re.compile("|".join(sorted(openers, key=len, reverse=True)), re.M)
    mask = bytearray(len(text))
    n, i = len(text), 0

    js = ext in (".js", ".jsx", ".ts", ".tsx", ".mjs", ".cjs")
    # Page text between JSX tags is not code: a quote or backtick in it opens nothing.
    jsx_text = template_mask(text, ext) if ext in (".jsx", ".tsx") else None

    def close(start, end, kind):
        mask[start:end] = bytes([kind]) * (end - start)
        if kind == TEXT_STRING and literals is not None and end > start:
            literals.append((offset + start, offset + end))
        return end

    def brace_open(at, size):
        """For an interpolation opened by `size` braces, the run of braces at `at`: where the
        opening braces start (None when the run is literal text) and where the run ends. With
        one brace, {{ is a literal pair, so {{{x}}} holds an interpolation; with C# $$, fewer
        than two braces are literal and the last two open it."""
        run = at
        while run < n and text[run] == "{":
            run += 1
        if size == 1:
            return (None if (run - at) % 2 == 0 else run - 1), run
        return (None if run - at < size else run - size), run

    def heredoc_here(at, h):
        """Ruby or Perl: whether the << at `at` opens a heredoc rather than an append or shift.
        The name follows << with no space (Perl allows one before a quoted name), and << does
        not follow the end of an operand: a variable, number, string or closing bracket, or a
        name right against it (x<<y). A name and a space before <<NAME is a call (puts <<~EOS)."""
        if re.match(r"<<[-~]?[ \t]", text[at:at + 4]) and not (ext != ".rb" and h.group(1)):
            return False
        k = at - 1
        while k >= 0 and text[k] in " \t":
            k -= 1
        if k < 0 or text[k] == "\n":
            return True
        if mask[k] == TEXT_STRING or text[k] in ")]}":
            return False
        word = re.search(r"[$@%]*\w+$", text[max(0, k - 80):k + 1])
        if word is None:
            return True
        return not (k == at - 1 or word.group(0)[0] in "$@%" or word.group(0).isdigit())

    def head_keyword(k):
        """Whether the ")" at k closes the head of an if, while, for or with statement."""
        depth, j = 0, k
        while j >= max(0, k - 10000):
            if not mask[j]:
                c = text[j]
                if c in ")]}":
                    depth += 1
                elif c in "([{":
                    depth -= 1
                    if depth == 0:
                        return c == "(" and bool(re.search(r"(?:^|[^\w$.])(?:if|while|for(?:[ \t\r\n]+await)?|with)"
                                                           r"[ \t\r\n]*$", text[max(0, j - 30):j]))
            j -= 1
        return False

    def closes_block(k):
        """Whether the "}" at k closes a block (a statement body, function or class) rather than
        an object literal: after a block a "/" starts a regex, after an object it divides."""
        depth, j = 0, k
        while j >= max(0, k - 10000):
            if not mask[j]:
                c = text[j]
                if c in ")]}":
                    depth += 1
                elif c in "([{":
                    depth -= 1
                    if depth == 0:
                        break
            j -= 1
        else:
            return False
        return text[j] == "{" and opens_block(j)

    def statement_start(b, nest=0):
        """Whether a statement can start right after b: after ; } or a case or label colon, at
        the start of a block, or on a new line after the end of an operand (ASI)."""
        newline = False
        while b >= 0 and (text[b] in " \t\r\n" or mask[b] == TEXT_COMMENT):
            newline = newline or text[b] == "\n"
            b -= 1
        if b < 0 or text[b] in ";}:":
            return True
        if text[b] == "{":
            return opens_block(b, nest + 1)
        return newline and text[b] not in ",([?=+-*/%&|^!~<>."

    def opens_block(j, nest=0):
        """Whether the "{" at j opens a block rather than an object literal."""
        b = j - 1
        while b >= 0 and (text[b] in " \t\r\n" or mask[b] == TEXT_COMMENT):
            b -= 1
        if b < 0 or text[b] in ";{})":
            return True                       # a statement start, or the head of if/for/function (...)
        if text.startswith("=>", b - 1):
            return True                       # an arrow function body
        head = text[max(0, j - 200):j]
        word = re.search(r"([A-Za-z_$][\w$]*)$", text[max(0, b - 40):b + 1])
        if word and word.group(1) in ("else", "do", "try", "catch", "finally", "static"):
            return True                       # catch { } has no binding since ES2019
        if re.search(r"(?:^|[;{}\n])[ \t]*(?:export[ \t]+(?:default[ \t]+)?)?(?:declare[ \t]+)?(?:abstract[ \t]+)?"
                     r"(?:class|interface|enum|namespace|module|global)\b[^;{}=()]*$", head):
            return True                       # a class, interface, enum, namespace or module body
        if re.search(r"\)[ \t\r\n]*:[ \t\r\n]*[\w$.<>\[\]|&, \t\r\n]*[\w$>\]]$", text[max(0, j - 200):b + 1]):
            return True                       # a TypeScript return type: function f(): void { }
        if text[b] == ":":
            # case x: { }, default: { } and a labeled block (out: { }), at the start of a
            # statement; in an object literal ({ out: { } }) the "{" is a value.
            label = re.search(r"(?:^|[^\w$.])(case\b[^;{}:]*|[A-Za-z_$][\w$]*)[ \t\r\n]*$", text[max(0, b - 200):b])
            if label and nest < 50:          # deeper nesting: read as an object, not a recursion error
                return statement_start(max(0, b - 200) + label.start(1) - 1, nest)
        return False

    fn_seen, file_kind = [], []

    def enclosing_function(k):
        """(async, generator) of the innermost function whose body holds k, or None at the top.
        Reaching an earlier query's position at the same depth gives its answer: one function
        full of awaits costs its length, not its length squared."""
        found = enclosing_scan(k)
        fn_seen[:] = [k, found]
        return found

    def enclosing_scan(k):
        depth, j = 0, k
        while j >= max(0, k - 20000):
            if fn_seen and j == fn_seen[0] and depth == 0:
                return fn_seen[1]
            if not mask[j]:
                c = text[j]
                if c in ")]}":
                    depth += 1
                elif c in "([{":
                    if depth:
                        depth -= 1
                    elif c == "{":
                        kind = function_head(j)
                        if kind is not None:
                            return kind
            j -= 1
        return None

    def function_head(j):
        """(async, generator) when the "{" at j opens a function body, else None."""
        b = j - 1
        while b >= 0 and (text[b] in " \t\r\n" or mask[b] == TEXT_COMMENT):
            b -= 1
        if b < 1:
            return None
        if text.startswith("=>", b - 1):
            return bool(re.search(r"(?:^|[^\w$.])async[ \t]*(?:\([^()]*\)|[A-Za-z_$][\w$]*)[ \t]*(?::[^;{}()]*)?=>$",
                                  text[max(0, b - 300):b + 1])), False
        ret = re.search(r"\)[ \t\r\n]*:[ \t\r\n]*[\w$.<>\[\]|&, \t\r\n]*[\w$>\]]$", text[max(0, b - 200):b + 1])
        if ret:
            b = max(0, b - 200) + ret.start()
        if text[b] != ")":
            return None
        depth, p = 0, b
        while p >= max(0, b - 10000):
            if not mask[p]:
                if text[p] in ")]}":
                    depth += 1
                elif text[p] in "([{":
                    depth -= 1
                    if depth == 0:
                        break
            p -= 1
        if p < 0 or text[p] != "(":
            return None
        before = text[max(0, p - 80):p]
        if re.search(r"(?:^|[^\w$.])(?:if|while|for|for[ \t]+await|switch|catch|with)[ \t\r\n]*$", before):
            return None
        f = re.search(r"(?:^|[^\w$.])(?:(async)[ \t]+)?function\b[ \t\r\n]*(\*)?[ \t\r\n]*[\w$]*[ \t]*(?:<[^()]*>)?[ \t]*$", before)
        if not f:
            f = re.search(r"(?:^|[^\w$.])(?:static[ \t]+)?(?:(async)[ \t]+)?(?:(?:get|set)[ \t]+)?(\*)?[ \t]*"
                          r"(?:[A-Za-z_$][\w$]*|\[[^\]]*\])[ \t]*(?:<[^()]*>)?[ \t]*$", before)
        return (bool(f.group(1)), bool(f.group(2))) if f else None

    def reserved_here(w, k):
        """Whether await or yield ending at k is the keyword: in a module, in an async function or
        generator, or (yield) in strict code. A sloppy script may use either as a name."""
        if not file_kind:
            file_kind[:] = [bool(offset or ext == ".mjs" or re.search(r"(?m)^[ \t]*(?:import[ \t]*[\w${*\"']|export\b)", text)),
                            bool(re.search(r"(?m)^[ \t]*([\"'])use strict\1", text))]
        if file_kind[0] or w == "yield" and file_kind[1]:
            return True                       # a module (a nested body cannot tell: keep the keyword), strict code
        if w == "await" and re.search(r"(?:^|[^\w$.])async[ \t]*(?:\([^()]*\)|[A-Za-z_$][\w$]*)[ \t]*=>[^;{}]*$",
                                      text[max(0, k - 300):k - 4]):
            return True                       # a concise async arrow body
        kind = enclosing_function(k)
        return kind is not None and kind[0 if w == "await" else 1]

    def paint_string(start, end, specs=(), backticks=False):
        close(start, end, TEXT_STRING)
        for marker, opener, closer in specs:
            pos = start
            while True:
                hit = text.find(marker, pos, end)
                if hit < 0:
                    break
                if not marker.strip("{"):
                    hit, run_end = brace_open(hit, len(marker))
                    if hit is None:
                        pos = run_end
                        continue
                expr_start = hit + marker.rindex(opener)
                expr_end = _balanced_end(text, expr_start, opener, closer, js, ext in (".py", ".pyi"),
                                         ext in (".sh", ".bash", ".zsh", ".ksh"))
                body_start, body_end = expr_start + 1, min(expr_end - 1, end)
                if body_start < body_end:
                    nested = text_spans(text[body_start:body_end], name, literals, offset + body_start)
                    mask[body_start:body_end] = nested
                mask[hit:body_start] = bytes(body_start - hit)
                if expr_end <= end:
                    mask[body_end:expr_end] = bytes(expr_end - body_end)
                pos = max(hit + len(marker), expr_end)
        if backticks:
            pos = start
            while True:
                left = text.find("`", pos, end)
                if left < 0:
                    break
                right = text.find("`", left + 1, end)
                if right < 0:
                    break
                nested = text_spans(text[left + 1:right], name, literals, offset + left + 1)
                mask[left:right + 1] = bytes(right + 1 - left)
                mask[left + 1:right] = nested
                pos = right + 1
        return end

    def delimited_end(j, opener):
        """Just past the closer of a quote-like body that starts at j: brackets nest, and a
        backslash escapes the next character."""
        closer = BRACKET_CLOSE.get(opener, opener)
        depth = 1
        while j < n:
            c = text[j]
            if c == "\\":
                j += 2
                continue
            if c == closer:
                depth -= 1
                if depth == 0:
                    return j + 1
            elif c == opener:
                depth += 1
            j += 1
        return n

    def interpolation_end(at, spec):
        """Just past the interpolation whose marker starts at `at`, or past a run of literal braces."""
        marker, opener, closer = spec
        if not marker.strip("{"):
            at, run_end = brace_open(at, len(marker))
            if at is None:
                return run_end
        return _balanced_end(text, at + marker.rindex(opener), opener, closer, js, ext in (".py", ".pyi"),
                             ext in (".sh", ".bash", ".zsh", ".ksh"))

    def interpolation_specs(start, q):
        prefix = text[max(0, start - 3):start]
        if q == "`" and ext in (".js", ".jsx", ".ts", ".tsx", ".mjs", ".cjs"):
            return (("${", "{", "}"),), False
        if q in "\"'" and ext in (".py", ".pyi") and re.search(r"(?i)(?:^|[^A-Za-z])(?:rf|fr|f|rt|tr|t)$", prefix):
            return (("{", "{", "}"),), False
        if q == '"' and ext in (".rb", ".ex", ".exs") or q == "`" and ext == ".rb":
            return (("#{", "{", "}"),), False
        if q == '"' and ext in (".pl", ".pm"):
            return (("@{[", "[", "]"), ("${\\", "{", "}")), False
        if q == '"' and ext in (".kt", ".kts"):
            return (("${", "{", "}"),), False
        if q == '"' and ext == ".swift":
            return (("\\(", "(", ")"),), False
        if q == '"' and ext == ".cs" and "$" in prefix:
            # C# 11 raw strings: $$"""...""" needs two braces to open an interpolation.
            dollars = 0
            while dollars < start and text[start - dollars - 1] == "$":
                dollars += 1
            raw = dollars > 1 and text.startswith('"""', start)
            return (("{" * dollars if raw else "{", "{", "}"),), False
        if q == '"' and ext in (".sh", ".bash", ".zsh", ".ksh"):
            return (("$(", "(", ")"),), True
        if q == "`" and ext in (".sh", ".bash", ".zsh", ".ksh"):
            return (), True
        return (), False

    if ext in SLASH_COMMENT_ONLY and text.startswith("#!") and not text.startswith("#!["):
        eol = text.find("\n")
        i = close(0, n if eol < 0 else eol, TEXT_COMMENT)     # a #! line, which is not a Rust #![attr]
    while i < n:
        m = finder.search(text, i)
        if not m:
            break
        i, tok = m.start(), m.group(0)
        if jsx_text is not None and jsx_text[i]:
            i += 1
            continue
        if tok == "<<":
            shell = ext in (".sh", ".bash", ".zsh", ".ksh")
            if shell and text.startswith("<<<", i):
                i += 3                         # a here-string: the word after it is code
                continue
            if shell:
                arith = text.rfind("((", text.rfind("\n", 0, i) + 1, i)
                if arith >= 0 and text.find("))", arith, i) < 0:
                    i += 2                     # a shift inside $(( )) or (( ))
                    continue
            h = (SHELL_HEREDOC_WORD if shell else HEREDOC_RE).match(text, i)
            if h and ext in (".rb", ".pl", ".pm") and not heredoc_here(i, h):
                h = None
            if not h:
                i += 2
                continue
            if shell:
                word = h.group(2)
                quoted = bool(re.search(r"['\"\\]", word))
                word = re.sub(r"\\(.)|'([^']*)'|\"([^\"]*)\"", lambda w: w.group(1) or w.group(2) or w.group(3) or "", word)
                # Only <<- strips leading tabs from the closing line; a plain << needs it at column 0.
                indent = "\t*" if h.group(1) else ""
            else:
                word, quoted = h.group(2), bool(h.group(1))
                indent = "[ \t]*" if ext in (".php", ".tf") or re.match(r"<<<?[-~]", h.group(0)) else ""
            # PHP 7.3 lets code follow the closing name on its line (EOT;); shells do not.
            tail = r"(?![A-Za-z0-9_])" if ext == ".php" else r"[ \t]*$"
            end = re.compile(r"(?m)^%s%s%s" % (indent, re.escape(word), tail)).search(text, h.end())
            heredoc_end = end.start() if end else n
            if shell and not quoted:
                i = paint_string(h.end(), heredoc_end, (("$(", "(", ")"),), True)
            elif ext == ".rb" and h.group(1) != "'":
                i = paint_string(h.end(), heredoc_end, (("#{", "{", "}"),))
            elif ext == ".php" and h.group(1) != "'":
                i = paint_string(h.end(), heredoc_end, (("{$", "{", "}"), ("${", "{", "}")))
            elif ext in (".pl", ".pm") and h.group(1) != "'":
                i = paint_string(h.end(), heredoc_end, (("@{[", "[", "]"), ("${\\", "{", "}")))
            else:
                i = close(h.end(), heredoc_end, TEXT_STRING)
            continue
        if tok == "/" and ext in REGEX_LITERAL_EXT:
            # The end of an operand makes this division: an identifier, number, string or regex,
            # a closing bracket, postfix ++ or --, a TypeScript non-null "!". Expression-leading
            # keywords are the exception, and so is the ")" that ends an if/while/for head.
            k = i - 1
            while k >= 0 and text[k] in " \t\r\n":
                k -= 1
            before = text[max(0, k - 39):k + 1]
            prev = before[-1:]
            word = re.search(r"([A-Za-z_$][\w$]*)$", before)
            regex_words = {"return", "typeof", "case", "yield", "await", "void", "throw", "else", "do", "in",
                           "delete", "new"}
            if ext in (".rb", ".pl", ".pm"):
                regex_words |= {"split", "grep", "when", "map"}
            # In JS a member (x.of, s.in) is a property name, never a keyword; Ruby's line.split /re/ is a call.
            member = word and ext not in (".rb", ".pl", ".pm") and before[:word.start()].endswith(".")
            if not prev:
                regex_start = True
            elif mask[k] == TEXT_STRING:
                regex_start = False
            elif word and word.group(1) in regex_words and not member \
                    and not (js and word.group(1) in ("await", "yield") and not reserved_here(word.group(1), k)):
                regex_start = True
            elif js and word and word.group(1) == "of" and re.search(
                    r"\bfor(?:[ \t]+await)?[ \t]*\([ \t]*(?:(?:const|let|var)[ \t]+)?[\w$\[\]{}, \t]+[ \t]of$",
                    text[max(0, k - 200):k + 1]):
                regex_start = True            # for (x of /re/...): "of" is the keyword here
            elif prev == "}" and js:
                regex_start = closes_block(k)
            elif prev.isalnum() or prev in "_$]}":
                regex_start = False
            elif prev == ")":
                regex_start = js and head_keyword(k)
            elif js and (before.endswith(("++", "--"))
                         or prev == "!" and (before[-2:-1].isalnum() or before[-2:-1] in ("_", "$", ")", "]"))):
                regex_start = False
            else:
                regex_start = True
            if regex_start or before.endswith(("=~", "!~")):
                k, cls = i + 1, False
                while k < n and text[k] != "\n":
                    c = text[k]
                    if c == "\\":
                        k += 2
                        continue
                    if c == "[":
                        cls = True
                    elif c == "]":
                        cls = False
                    elif c == "/" and not cls:
                        break
                    k += 1
                if k < n and text[k] == "/":
                    i = close(i, k + 1, TEXT_STRING)
                    continue
            i += 1
            continue
        if tok in ("<!--", "-->"):
            # <!-- starts a line comment anywhere; --> only at the start of a line, after
            # nothing but blanks and comments (elsewhere it is x-- > y).
            line_start = text.rfind("\n", 0, i) + 1
            if tok == "-->" and any(not mask[k] and text[k] not in " \t" for k in range(line_start, i)):
                i += 3
                continue
            end = text.find("\n", i)
            i = close(i, n if end < 0 else end, TEXT_COMMENT)
            continue
        if ext == ".sql" and tok.startswith("$"):
            end = text.find(tok, m.end())
            i = close(i, n if end < 0 else end + len(tok), TEXT_STRING)
            continue
        if tok.startswith("=begin"):
            end = text.find("\n=end", i)
            i = close(i, n if end < 0 else end + 5, TEXT_COMMENT)
            continue
        if tok.startswith("=") and ext in (".pl", ".pm"):
            end = text.find("\n=cut", i)
            i = close(i, n if end < 0 else end + 5, TEXT_COMMENT)
            continue
        if ext == ".rb" and tok.startswith("%") and len(tok) == 2 and tok[1] not in "([{<|!/":
            # A bare %^...^ is a string only where an expression starts; after an operand it is modulo.
            k = i - 1
            while k >= 0 and text[k] in " \t":
                k -= 1
            if tok[1] in ")]}>=" or not (k < 0 or text[k] in "\n=(,[{;|&!?:<>+-*/~^%" or re.search(
                    r"(?:^|[^\w$@.])(?:return|puts|print|p|when|in|and|or|not|if|unless|while|until|then|do|yield)$",
                    text[max(0, k - 10):k + 1])):
                i += 1
                continue
        if ext == ".rb" and tok.startswith("%") and tok[1] not in "qwis":
            opener = tok[-1]
            closer = BRACKET_CLOSE.get(opener, opener)
            j, depth = m.end(), 1
            while j < n:
                if text.startswith("#{", j):
                    j = _balanced_end(text, j + 1, "{", "}")
                    continue
                c = text[j]
                if c == closer:
                    depth -= 1
                    if depth == 0:
                        break
                elif c == opener and closer != opener:
                    depth += 1
                j += 2 if c == "\\" else 1
            i = paint_string(i, min(j + 1, n), (("#{", "{", "}"),))
            continue
        if ext == ".rb" and tok.startswith("%"):
            i = close(i, delimited_end(m.end(), tok[-1]), TEXT_STRING)
            continue
        if ext in (".pl", ".pm") and tok[:1] in "qmsty" and len(tok) > 1 and tok != "//":
            op = re.match(r"qr|q[qwx]?|tr|[msy]", tok).group(0)
            opener = tok[-1]
            end = delimited_end(m.end(), opener)
            if op in ("s", "tr", "y") and end < n:
                if opener in BRACKET_CLOSE:
                    # s{a}{b}: the second part has its own brackets, after optional blanks.
                    k = end
                    while k < n and text[k] in " \t\r\n":
                        k += 1
                    if k < n:
                        end = delimited_end(k + 1, text[k])
                else:
                    end = delimited_end(end, opener)
            i = close(i, end, TEXT_STRING)
            continue
        if ext in (".ex", ".exs") and tok.startswith("~"):
            # A sigil: ~s(...), ~r/.../, ~S"""...""". Lowercase sigils allow escapes; uppercase do not.
            delim = tok[2:].lstrip("ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789")
            if len(delim) == 3:
                end = text.find(delim, m.end())
                finish = n if end < 0 else end + 3
                specs = (("#{", "{", "}"),) if tok[1].islower() else ()
                i = paint_string(i, finish, specs)
                continue
            closer = BRACKET_CLOSE.get(delim, delim)
            escapes = tok[1].islower()
            j = m.end()
            while j < n and text[j] != closer:
                j += 2 if escapes and text[j] == "\\" else 1
            specs = (("#{", "{", "}"),) if tok[1].islower() else ()
            i = paint_string(i, min(j + 1, n), specs)
            continue
        if ext in (".rb", ".ex", ".exs") and tok.startswith("?"):
            i = close(i, m.end(), TEXT_STRING)
            continue
        if ext == ".zig" and tok == "\\\\":
            end = text.find("\n", i)        # a Zig multi-line string line runs to the end of the line
            i = close(i, n if end < 0 else end, TEXT_STRING)
            continue
        if ext == ".rs" and tok.endswith('"') and "r" in tok:
            hashes = tok.count("#")
            end = text.find('"' + "#" * hashes, m.end())
            i = close(i, n if end < 0 else end + 1 + hashes, TEXT_STRING)
            continue
        if ext == ".swift" and tok.startswith("#"):
            closer = ('"""' if text.startswith('"""', m.end() - 1) else '"') + "#" * (len(tok) - 1)
            end = text.find(closer, m.end() + (2 if len(closer) > len(tok) else 0))
            i = close(i, n if end < 0 else end + len(closer), TEXT_STRING)
            continue
        if ext == ".ps1" and tok in ('@"', "@'"):
            end = text.find("\n" + tok[1] + "@", m.end())
            i = close(i, n if end < 0 else end + 3, TEXT_STRING)
            continue
        if ext == ".cs" and (tok.endswith('@"') or tok == '@$"'):
            j = m.end()
            while j < n:
                if text[j] == '"':
                    if text.startswith('""', j):
                        j += 2
                        continue
                    j += 1
                    break
                j += 1
            specs = (("{", "{", "}"),) if "$" in tok else ()
            i = paint_string(i, min(j, n), specs)
            continue
        if ext in (".c", ".h", ".cc", ".cpp", ".hpp", ".cxx", ".hh", ".hxx") and re.match(r"(?:u8|[uUL])?R\"", tok):
            delim = tok[tok.find('"') + 1:-1]
            end = text.find(")" + delim + '"', m.end())
            i = close(i, n if end < 0 else end + len(delim) + 2, TEXT_STRING)
            continue
        if ext == ".lua" and tok.startswith("[") and tok.endswith("["):
            end = text.find("]" + tok[1:-1] + "]", i)
            i = close(i, n if end < 0 else end + len(tok), TEXT_STRING)
            continue
        block = next((b for a, b in blocks if a == tok), None)
        if block is not None:
            end = text.find(block, i + len(tok))
            i = close(i, n if end < 0 else end + len(block), TEXT_COMMENT)
            continue
        if tok in lines:
            if tok == "#":
                prev = text[i - 1] if i else "\n"
                # A word that an escaped space started (a\ #) is mid-word: its # is not a comment.
                if ext in (".sh", ".bash", ".zsh", ".ksh") and (prev not in " \t\r\n;|&()"
                                                               or prev in " \t" and _escaped(text, i - 1)):
                    i += 1
                    continue
                if ext in (".pl", ".pm") and prev == "$":
                    i += 1
                    continue
                if ext in (".rb", ".ex", ".exs") and prev == "?":
                    i += 1
                    continue
                if ext == ".php" and text.startswith("#[", i):
                    i += 1                     # a PHP 8 attribute, #[Pure], is code up to its ]
                    continue
            end = text.find("\n", i)
            if ext == ".java":
                # Java decodes unicode escapes before it lexes: one for LF or CR ends the comment.
                for u in re.finditer(r"\\u+000[aAdD]", text[i:n if end < 0 else end]):
                    if not _escaped(text, i + u.start()):
                        i = close(i, i + u.start(), TEXT_COMMENT) + len(u.group(0))
                        break
                else:
                    i = close(i, n if end < 0 else end, TEXT_COMMENT)
                continue
            i = close(i, n if end < 0 else end, TEXT_COMMENT)
            continue
        q = tok
        if ext in (".rb", ".ex", ".exs") and i and text[i - 1] == "?":
            i += 1                             # Ruby and Elixir ?x character literals
            continue
        if ext in (".pl", ".pm", ".rb") and i and text[i - 1] == "$":
            i += 1                             # Perl and Ruby punctuation variables $", $', and $`
            continue
        if ext == ".cs" and text.startswith('""""', i):
            # A C# raw string opened by more than three quotes ends at a run of as many.
            run = len(re.compile('"+').match(text, i).group(0))
            end = text.find('"' * run, i + run)
            specs, ticks = interpolation_specs(i, q)
            i = paint_string(i, n if end < 0 else end + run, specs, ticks)
            continue
        if ext in TRIPLE_QUOTES and text.startswith(q * 3, i):
            specs, ticks = interpolation_specs(i, q)
            j = i + 3
            while j < n:
                marker = next((x for x in specs if text.startswith(x[0], j)), None)
                if marker:
                    j = interpolation_end(j, marker)
                elif text.startswith(q * 3, j):
                    j += 3
                    break
                else:
                    j += 2 if text[j] == "\\" else 1
            i = paint_string(i, min(j, n), specs, ticks)
            continue
        if q == "'" and ext == ".m":
            k = i - 1
            while k >= 0 and text[k] in " \t":
                k -= 1
            if k >= 0 and (text[k].isalnum() or text[k] in "_)]}'.") and k == i - 1:
                i += 1                         # MATLAB transpose: A' or x.'
                continue
        if ext in (".sh", ".bash", ".zsh", ".ksh") and _escaped(text, i):
            i += 1                             # \' outside quotes is a quote character, not a string
            continue
        if q == "'" and ext in CHAR_LITERAL:
            lit = re.compile(r"'(?:\\.[^']{0,10}|[^'\\\n])'").match(text, i)
            if lit:
                i = close(i, lit.end(), TEXT_STRING)
            else:
                i += 1                         # a Rust lifetime or a stray apostrophe: not a string
            continue
        multi = (q == "`" and ext in MULTILINE_BACKTICK) or q in MULTILINE_QUOTES.get(ext, "")
        # Where a backslash is a plain character: standard SQL strings (escapes only in E'...'),
        # single quotes in a POSIX shell, and a Rust raw string with no hashes (r"C:\dir\").
        before = text[i - 1] if i else ""
        literal = (ext == ".sql" and q == "'" and before not in ("e", "E")) \
            or (ext in (".sh", ".bash", ".zsh", ".ksh") and q == "'" and before != "$") \
            or (ext == ".rs" and q == '"' and before == "r" and (i < 2 or not (text[i - 2].isalnum() or text[i - 2] == "_")
                                                               or text[i - 2] == "b"))
        specs, ticks = interpolation_specs(i, q)
        j = i + 1
        while j < n:
            c = text[j]
            marker = next((x for x in specs if text.startswith(x[0], j)), None)
            if marker:
                j = interpolation_end(j, marker)
                continue
            if c == "\\" and not literal:
                j += 2
                continue
            if c == q:
                j += 1
                break
            if c == "\n" and not multi:
                break
            j += 1
        i = paint_string(i, min(j, n), specs, ticks)
    return mask


CURLY_PAIR = re.compile("(?:^|(?<=[=(,:\\[{])|(?<=return))[ \\t]*([\u201c\u2018])([^\u201c\u201d\u2018\u2019\\n]{1,500}?)"
                        "([\u201d\u2019])(?=[ \\t\\r]*(?:[)\\],;}]|$|(#|//)))")


def _delimiter_pairs(line, comments=()):
    """Columns of curly quotes used as a pair of string delimiters (see CURLY_PAIR). comments: the
    line-comment openers of the language, which end a statement as the end of the line does."""
    found = set()
    for m in CURLY_PAIR.finditer(line):
        if m.group(4) and m.group(4) not in comments:
            continue
        if m.start() == 0 and m.start(1) == 0 and not line[:m.start(1)].strip() == "":
            continue
        if line[:m.start(1)].strip() == "":
            continue                       # a line that opens with a quote is prose, not an assignment
        if not any(c.isalnum() for c in m.group(2)):
            continue                       # a regex class or alternation of quotes: [""], (|)
        found.add(m.start(1))
        found.add(m.start(3))
    return found


def _scan_chars(line, i, what, markup, out, exact=False, spans=None, known=True, template=None, py_names=False, config=False,
                turkish=False, code_ext="", near_real_code=None, source_name="", manifest=None, twins=None, code_words=()):
    """Findings for the non-ASCII characters of one line. template: for a file that mixes code
    and markup (JSX, Vue, PHP), 1 for each column of template text, which is prose."""
    code = what == "code"
    lenient = SOFT if not code else HARD
    line_from = len(out)
    has_rtl = any(_is_rtl(c) or 0x0660 <= ord(c) <= 0x066C or 0x06F0 <= ord(c) <= 0x06F9
                  or ord(c) in (0x060B, 0x20AA, 0xFDFC) for c in line)
    has_cjk = any(_is_cjk(c) for c in line)

    for m in TAG_RUN.finditer(line):
        if _flag_emoji(line, m.start(), m.group(0)):
            continue
        hidden = _decode_tags(m.group(0))
        out.append(Finding(HARD, i, m.start() + 1, "hidden-tag-text",
                           "%d tag characters%s" % (len(m.group(0)), " spelling %r" % hidden[:80] if hidden else "")))
    for m in VS_RUN.finditer(line):
        out.append(Finding(HARD, i, m.start() + 1, "hidden-selectors",
                           "%d variation selectors in a row (can carry hidden bytes)" % len(m.group(0))))
    for m in PUA_RUN.finditer(line):
        n = len(m.group(0))
        out.append(Finding(HARD if n >= PUA_HARD_RUN else SOFT, i, m.start() + 1, "private-use",
                           "%d private-use character%s (no agreed meaning; can carry hidden data)" % (n, "" if n == 1 else "s")))
    real = _real_scripts(line)
    # A Cyrillic comment on the line does not make a lookalike name in the code beside it Cyrillic.
    local_real_code = _real_scripts("".join(c for k, c in enumerate(line)
                                      if not (spans is not None and 0 <= k < len(spans) and spans[k])
                                      and not (template is not None and 0 <= k < len(template) and template[k])))
    real_code = local_real_code if template is not None or near_real_code is None else near_real_code
    flagged = soft_flagged = 0
    # Curly quotes that stand where code puts string delimiters: an opening one right after
    # "=", "(", ",", ":", "[", "{" or "return", and its closing partner on the same line right
    # before ")", "]", ",", ";", "}" or the end of the line, with letters or digits between.
    # Only such a pair breaks a program; a lone quote, or one beside words, is text.
    # In a template the close of a code region (%>, %}) ends the statement as the end of a line
    # does, and a filter pipe ({{ x | upper }}) follows a value; page text is excluded below.
    probe = line if template is None else re.sub(r"%(?=[>}])", ";", line).replace("|", ",")
    pairs = _delimiter_pairs(probe, LINE_COMMENTS.get(code_ext, ("//",) if code_ext in SLASH_COMMENT_ONLY else ("#", "//"))) \
        if code and known and any(ord(c) in (0x201C, 0x2018) for c in line) else set()

    # Whether a column is in a string or a comment comes from the whole file (spans), so a
    # docstring or block comment over many lines counts as text on every line of it.
    def where(pos):
        if template is not None and 0 <= pos < len(template) and template[pos] == 2:
            return 0                      # a bound template attribute: code, though it is quoted
        return spans[pos] if spans is not None and 0 <= pos < len(spans) else 0

    def shown(pos):
        return template is not None and 0 <= pos < len(template) and template[pos] == 1

    def exact_at(pos):
        if not exact:
            return False
        if where(pos) == TEXT_COMMENT:
            return False
        if manifest is not None and 0 <= pos < len(manifest) and manifest[pos]:
            return manifest[pos] == 2
        base = os.path.basename(source_name).lower()
        spelled = "/" + source_name.replace(os.sep, "/").lower()
        workflow = "/.github/" in spelled or "/.circleci/" in spelled or "/.gitlab/" in spelled or base == ".travis.yml" \
            or base.startswith(("azure-pipelines.", "bitbucket-pipelines.", ".gitlab-ci"))
        before = line[:pos]
        if re.match(r"^[ \t]*(?:description|author|authors)[ \t]*[:=]", line, re.I):
            return False
        if base.endswith(".xml") and re.match(r"^[ \t]*<(?:description|name)>", line):
            return False                  # a Maven project's or developer's display name and description
        if workflow and re.match(r"^[ \t]*(?:-[ \t]*)?(?:name|description)[ \t]*:", line, re.I):
            return False
        run = re.match(r"^[ \t]*(?:-[ \t]*)?run[ \t]*:[ \t]*", line, re.I)
        if workflow and run:
            command = re.search(r"[^ \t]+", line[run.end():])
            return bool(command and pos < run.end() + command.end())
        start = pos
        while start > 0 and where(start - 1) == TEXT_STRING:
            start -= 1
        if where(pos) == TEXT_STRING and re.search(r"[\"'](?:description|author|authors)[\"'][ \t]*:[ \t]*$",
                                                   line[:start], re.I):
            return False
        return True

    for m in LOOKALIKE_RUN.finditer(line):
        first = ord(m.group(0)[0])
        wide = 0xFF00 <= first <= 0xFFEF
        if wide and has_cjk and not code:
            continue                 # full-width Latin is ordinary in CJK text
        what_kind = "full-width letters" if wide else "circled letters" if 0x24B6 <= first <= 0x24E9 else "mathematical styled letters"
        # In code they are a name that tools fold to ASCII (eval), unless they sit in a string
        # or comment, where full-width Latin next to CJK text is ordinary.
        quoted = bool(where(m.start())) or shown(m.start())
        # In a string, comment or page text they are text (a conversion table, a math docstring);
        # beside CJK text full-width letters are ordinary even unquoted (a shell argument).
        beside_cjk = (m.start() > 0 and _is_cjk_context(line[m.start() - 1])) \
            or (m.end() < len(line) and _is_cjk_context(line[m.end()]))
        # Bold, italic, script, fraktur and double-struck letters are math notation; monospace
        # and sans-serif ones are drawn like plain ASCII letters.
        math_name = code_ext in MATH_NAME_EXT and not quoted and not any(
            s in unicodedata.name(c, "") for c in m.group(0) for s in ("MONOSPACE", "SANS-SERIF"))
        if math_name or wide and beside_cjk and not quoted:
            continue
        # A shell argument is text (echo with a Japanese message); a command word still runs.
        out.append(Finding(SOFT if (not code or quoted or _shell_argument(line, m.start(), code_ext)) else HARD,
                           i, m.start() + 1, "lookalike-letter",
                           "%d %s (not the ASCII letters they resemble)" % (len(m.group(0)), what_kind)))
    for m in WORD.finditer(line):
        exact_word = exact_at(m.start())
        code_pos = code and not where(m.start()) and not shown(m.start())
        why = _homoglyph(m.group(0), real_code if code_pos else real)
        if why is None and code and len(m.group(0)) == 1 and m.group(0) in LOOKALIKE \
                and m.group(0) not in GREEK_LOWER_LOOKALIKE and _script(m.group(0)) not in real_code:
            pos = m.start()
            if not where(pos):
                why = "is a single %s letter that reads as Latin" % _script(m.group(0))
        pos = m.start()
        in_text = (bool(where(pos)) and known) or shown(pos)   # page text in a template is prose
        # A name a tool folds to plain ASCII. Only in code proper: in a string or comment "m\u00b2"
        # or "H\u2082O" is text, and nothing reads it as a name.
        if why is None and code and not in_text and code_ext not in MATH_NAME_EXT and not m.group(0).isascii() \
                and not LOOKALIKE_RUN.search(m.group(0)):
            letters_only = all(c.isascii() or unicodedata.category(c)[0] == "L" or unicodedata.category(c) == "Nl"
                               for c in m.group(0))
            # A modifier or index letter (x with subscript i) is a math name, but only that letter
            # is: a ligature or script letter beside it still folds to an ASCII name.
            base = "".join(c for c in m.group(0) if not _modifier_letter(c))
            folded = unicodedata.normalize("NFKC", base)
            if letters_only and base and folded != base and folded.isascii():
                why = ("is read by Python as %r" if py_names else "looks like %r but is another name") % folded
        # A host name is resolved, never read as text: a lookalike in one blocks wherever it is
        # (a curl argument, a string, a comment), unless the host is written in that script.
        # In code proper (not a shell argument) a dotted name is a member (x.item(), h.le), and
        # "@" an operator (W@x): only a word after :// is a host there.
        host = _host_at(line, m.start(), m.end(), not code_pos or code_ext in SHELL_TEXT_EXT) \
            if any(c in LOOKALIKE for c in m.group(0)) else None
        host_why = None
        if host:
            # Each label is judged alone, so a real subdomain does not vouch for a spoofed name
            # beside it, and one real letter among lookalikes (the m of a Cyrillic "com") does not
            # make a label a word of that script. Under a top-level label of another script
            # (.\u0440\u0444) no ASCII host is imitated, and the whole host may vouch for a label.
            label_native = _native_host(_host_label(line, host, m.start()))
            whole = line.translate(HOST_DOTS)[host[0]:host[1]].strip(".-_")
            if not label_native and not (not whole.rsplit(".", 1)[-1].isascii() and _native_idn_host(whole)):
                host_why = _homoglyph(m.group(0), set()) or "has %s letters that read as Latin" % _script(
                    next(c for c in m.group(0) if c in LOOKALIKE))
        if host_why:
            why = host_why + " (in a host name)"
        if why and (code or "mixes" in why or host_why):
            # A short word of lookalikes inside a comment is usually a real word in that language.
            pos = m.start()
            in_comment = where(pos) == TEXT_COMMENT
            in_string = where(pos) == TEXT_STRING or shown(pos)
            eval_word = code_ext in {".sh", ".bash", ".zsh", ".ksh"} \
                and bool(re.search(r"(?:^|[ \t;&|(])eval[ \t]+[\"']$", line[:m.start()]))
            if eval_word:
                in_string = False         # the first word of an eval string is a command
            short = "made only" in why and (in_string or in_comment)
            shell_text = _shell_argument(line, m.start(), code_ext) and not eval_word
            if "made only" in why and (shell_text or exact and not exact_word):
                short = True
            if shell_text and all(c in ORTHOGRAPHIC_LOOKALIKE for c in m.group(0) if c in LOOKALIKE):
                short = True              # a Turkish word with a dotless i as an argument: text
            if not known and not exact_word and all(c in ORTHOGRAPHIC_LOOKALIKE for c in m.group(0) if c in LOOKALIKE):
                short = True              # a language the scanner does not parse: it cannot tell a name from text
            dotted = m.group(0).replace("\u0131", "i")
            ident = re.search(r"\w*$", line[:m.start()]).group(0) + m.group(0) + re.match(r"\w*", line[m.end():]).group(0)
            if turkish and set(c for c in m.group(0) if c in LOOKALIKE) <= {"\u0131"} and not exact_word \
                    and ident.replace("\u0131", "i") not in code_words and dotted not in WELL_KNOWN_NAMES \
                    and not (line[max(0, m.start() - 2):m.start()] == "__" and line[m.end():m.end() + 2] == "__"):
                short = True              # a Turkish name in a Turkish file (it holds g-breve, s-cedilla...)
            if not exact_word and (in_string or in_comment or not py_names and config or exact) and \
                    all(c in ORTHOGRAPHIC_LOOKALIKE for c in m.group(0) if c in LOOKALIKE):
                short = True              # Turkish "sifirlandi" with dotless i, IPA, click letters: text
            if "may be a numeric name" in why:
                short = not exact_word    # a rho or nu with a suffix in numeric code: a warning, except in a manifest
            sev = HARD if host_why else SOFT if short else lenient
            # Past the cap a line adds nothing to report, but a warning never uses up the cap
            # that a blocking word after it needs.
            if sev == HARD:
                flagged += 1
                if flagged > PER_LINE_LIMIT:
                    break
            elif soft_flagged >= PER_LINE_LIMIT:
                continue
            else:
                soft_flagged += 1
            out.append(Finding(sev, i, m.start() + 1, "homoglyph", "%r %s" % (m.group(0)[:40], why)))

    wide_digit_runs = list(re.finditer("[\uff10-\uff19]+", line))
    for j, ch in enumerate(line, 1):
        o = ord(ch)
        if o < 0x80:
            continue
        if code and known and not py_names and not where(j - 1) and not shown(j - 1) and unicodedata.category(ch) == "Mn" \
                and j >= 2 and len(unicodedata.normalize("NFC", line[j - 2] + ch)) == 1:
            out.append(Finding(HARD, i, j, "lookalike-letter", "U+%04X COMBINING mark after %r: the same name as the "
                               "precomposed letter to the eye, another name to the language" % (o, line[j - 2])))
            continue
        if code and known and not where(j - 1) and not shown(j - 1) and ch in NATIVE_DIGIT_CONFUSABLE:
            a, b = j - 1, j
            name_char = lambda c: c.isalnum() or c == "_" or unicodedata.category(c)[0] == "M"
            while a > 0 and name_char(line[a - 1]):
                a -= 1
            while b < len(line) and name_char(line[b]):
                b += 1
            script = unicodedata.name(ch, "").replace("EXTENDED ", "").split()[0].split("-")[0] + " "
            letters = [c for c in line[a:b] if c.isalpha() or c == "_"]
            if letters and not any(unicodedata.name(c, "").startswith(script) for c in letters):
                out.append(Finding(HARD, i, j, "lookalike-letter", "U+%04X %s in a name (reads as %r)"
                                   % (o, unicodedata.name(ch, "DIGIT"), SKELETON.get(ch, "?"))))
                continue
        digit_run = next((m for m in wide_digit_runs if m.start() <= j - 1 < m.end()), None)
        digit_cjk = digit_run is not None and ((digit_run.start() > 0 and _is_cjk_context(line[digit_run.start() - 1])) \
                                               or (digit_run.end() < len(line) and _is_cjk_context(line[digit_run.end()])))
        # A bold or double-struck digit is math notation in a math language (the unit object 1 of
        # Mathlib); a monospace or sans-serif one is drawn like an ASCII digit.
        math_digit = code_ext in MATH_NAME_EXT and 0x1D7CE <= o <= 0x1D7FF \
            and not any(k in unicodedata.name(ch, "") for k in ("MONOSPACE", "SANS-SERIF"))
        if code and known and not where(j - 1) and not shown(j - 1) and unicodedata.category(ch) in ("Nd", "Pc") \
                and unicodedata.normalize("NFKC", ch).isascii() and not math_digit \
                and not digit_cjk and not (j >= 2 and _is_cjk(line[j - 2])) and not (j < len(line) and _is_cjk(line[j])):
            # A full-width digit or underscore in a name: Python reads x\uff11 as x1, other
            # languages as a different name that looks the same.
            out.append(Finding(HARD, i, j, "lookalike-letter", "U+%04X %s (not the ASCII character it resembles)"
                               % (o, unicodedata.name(ch, "DIGIT"))))
            continue
        prev = line[j - 2] if j >= 2 else ""
        nxt = line[j] if j < len(line) else ""
        if 0xE0000 <= o <= 0xE007F:
            continue          # reported as runs above, or part of a flag emoji
        if 0xE0080 <= o <= 0xE00FF or 0xE01F0 <= o <= 0xE0FFF:
            out.append(Finding(HARD, i, j, "invisible-char", "U+%04X unassigned code point (shows as nothing)" % o))
            continue
        if 0xE0100 <= o <= 0xE01EF:
            # An ideographic variation selector belongs after a Han character and nowhere else.
            alone = not (prev and _is_selector(prev)) and not (nxt and _is_selector(nxt))
            if alone and not (prev and _is_han(prev)):
                out.append(Finding(HARD, i, j, "hidden-selectors", "U+%04X VARIATION SELECTOR outside a Han variation sequence" % o))
            continue
        if o in BIDI:
            out.append(Finding(SOFT if what == "prose" else HARD, i, j, "bidi-control",
                               "U+%04X %s (can make code display differently from how it runs)" % (o, unicodedata.name(ch, "BIDI CONTROL"))))
        elif o in BLANK_LOOKALIKE:
            jamo = lambda c: bool(c) and 0x1100 <= ord(c) <= 0x11FF and ord(c) not in (0x115F, 0x1160)
            if o in (0x115F, 0x1160) and (jamo(prev) or jamo(nxt)):
                continue      # fillers are part of archaic Hangul syllables
            out.append(Finding(HARD, i, j, "blank-lookalike", "U+%04X %s" % (o, BLANK_LOOKALIKE[o])))
        elif o in (LRM, RLM, ALM):
            # Direction marks belong in right-to-left text and nowhere else.
            if not has_rtl:
                out.append(Finding(HARD, i, j, "invisible-char", "U+%04X %s outside right-to-left text" % (o, unicodedata.name(ch))))
            elif prev and ord(prev) in (LRM, RLM, ALM):
                out.append(Finding(HARD, i, j, "invisible-char", "U+%04X direction marks in a row (one is enough for any text)" % o))
            elif code:
                out.append(Finding(SOFT, i, j, "invisible-char", "U+%04X %s in code" % (o, unicodedata.name(ch))))
        elif o in (ZWJ, ZWNJ):
            # Joiners build emoji sequences and shape letters in Arabic, Persian and Indic scripts.
            # In Persian a joiner also sits between a Latin word and its suffix, so either side counts.
            ok = (bool(prev) and _joining_script(prev)) or (bool(nxt) and _joining_script(nxt)) \
                or (o == ZWJ and bool(prev) and bool(nxt) and _emoji_part(prev) and _emoji_part(nxt))
            if not ok:
                out.append(Finding(HARD, i, j, "invisible-char", "U+%04X %s outside an emoji sequence or joining script"
                                   % (o, unicodedata.name(ch))))
        elif o == BOM:
            first = i == 1 and j == 1
            out.append(Finding(SOFT if first else HARD, i, j, "invisible-char",
                               "U+FEFF %s" % ("BYTE ORDER MARK at the start of the file" if first else "ZERO WIDTH NO-BREAK SPACE")))
        elif o in (NBSP, NNBSP):
            # Outside a string or comment of a language the scanner knows, it stands where code
            # needs a plain space. Inside one it is text (French and Swedish strings use it).
            as_code = code and known and not where(j - 1) and not shown(j - 1)
            out.append(Finding(HARD if as_code else SOFT, i, j, "nbsp", "U+%04X %s" % (o, unicodedata.name(ch))))
        elif o == 0x200B and prev and _space_separated_script(prev):
            continue          # the word separator of Thai, Lao, Khmer and Myanmar
        elif o == 0x00AD and (not code or shown(j - 1)) and prev.isalpha() and nxt.isalpha():
            out.append(Finding(SOFT, i, j, "invisible-char", "U+00AD SOFT HYPHEN inside a word"))
        elif o in INVISIBLE:
            out.append(Finding(HARD, i, j, "invisible-char", "U+%04X %s" % (o, INVISIBLE[o])))
        elif 0xFE00 <= o <= 0xFE0F:
            keycap = prev in tuple("0123456789#*") and (nxt == chr(KEYCAP) or o == 0xFE0E)
            presentation = o in (0xFE0E, 0xFE0F)
            carrier = bool(prev) and ord(prev) >= 0x80 and (
                (presentation and _emoji_base(prev))
                or (not presentation and (_is_han(prev) or 0x1000 <= ord(prev) <= 0x109F or 0x1820 <= ord(prev) <= 0x18AA)))
            if not keycap and not carrier:
                out.append(Finding(HARD, i, j, "hidden-selectors", "U+%04X VARIATION SELECTOR after a character that takes none" % o))
        elif o in MONGOLIAN_SELECTORS:
            if not (prev and 0x1820 <= ord(prev) <= 0x18AA):
                out.append(Finding(HARD, i, j, "hidden-selectors", "U+%04X MONGOLIAN VARIATION SELECTOR outside Mongolian text" % o))
        elif o in INVISIBLE_MATH:
            out.append(Finding(SOFT if markup else HARD, i, j, "invisible-char", "U+%04X %s" % (o, unicodedata.name(ch))))
        elif o in ARABIC_FORMAT and has_rtl:
            continue
        elif o in TYPOGRAPHIC:
            # As code (a curly quote used as a string delimiter) these break the program. Inside a
            # string or a comment they are text: a UI label, a description, a sentence.
            # In a language the scanner does not know, it cannot tell text from code: a warning.
            # Policy: these are blocked only where they break code, which is a curly quote used
            # as a string delimiter in a language the scanner knows: right after "=", "(", ",",
            # ":", "[", "{", "return" or at the start of a line, or right before ")", "]", ",",
            # ";", "}" or the end of the line. Anywhere else (a string, a comment, JSX text, a
            # heredoc of a language not modelled) they are text, and a warning.
            delimiter = code and known and not config and o in (0x201C, 0x201D, 0x2018, 0x2019) and not where(j - 1) \
                and (j - 1) in pairs and not shown(j - 1)
            out.append(Finding(HARD if delimiter else SOFT, i, j, "non-ascii-punct",
                               "U+%04X %s%s" % (o, TYPOGRAPHIC[o], " used as a string delimiter" if delimiter else "")))
        else:
            cat = unicodedata.category(ch)
            if _noncharacter(o):
                out.append(Finding(HARD, i, j, "invisible-char", "U+%04X NONCHARACTER" % o))
            elif cat == "Cn" and _unassigned_hidden(o):
                out.append(Finding(HARD, i, j, "invisible-char", "U+%04X unassigned code point (shows as nothing)" % o))
            elif cat == "Cf":
                out.append(Finding(HARD, i, j, "invisible-char", "U+%04X %s" % (o, unicodedata.name(ch, "FORMAT CHARACTER"))))
            elif cat == "Cc":
                out.append(Finding(HARD, i, j, "control-char", "U+%04X control character" % o))
            elif o in OPERATOR_LOOKALIKE and code and known and not where(j - 1) and not shown(j - 1):
                out.append(Finding(SOFT, i, j, "operator-lookalike", "U+%04X %s (not the ASCII operator it resembles)"
                                   % (o, unicodedata.name(ch))))
            elif cat == "Zs":
                wide_space_in_cjk = o == 0x3000 and has_cjk
                if not (wide_space_in_cjk and not code):
                    as_code = code and known and not where(j - 1) and not wide_space_in_cjk and not shown(j - 1)
                    out.append(Finding(HARD if as_code else SOFT, i, j, "odd-space",
                                       "U+%04X %s (looks like a plain space)" % (o, unicodedata.name(ch, "SPACE"))))
    for m in re.finditer(r"\w+", line) if code and twins else ():
        # A lone Greek math letter (alpha, rho, sigma...) beside a Latin one is ordinary numeric code,
        # and so is one with an index (rho0, nu_t, sigma_xx); in a math language so is any one letter.
        if m.group(0) in GREEK_LOWER_LOOKALIKE or GREEK_INDEXED.fullmatch(m.group(0)) \
                or GREEK_INDEXED.fullmatch(twins.get(m.group(0), "")) \
                or (code_ext in MATH_NAME_EXT and len(m.group(0)) == 1):
            continue
        if m.group(0) in twins and not where(m.start()) and not shown(m.start()) and not any(
                f.sev == HARD and m.start() < f.col <= m.end() for f in out[line_from:]):
            out.append(Finding(HARD, i, m.start() + 1, "homoglyph", "%r reads as %r, another name in this file"
                               % (m.group(0)[:40], twins[m.group(0)][:40])))


def _hidden_notes(text):
    """(offset, note) for text a rendered page does not show: HTML comments (on one line or
    many), elements styled out of sight, and link or image titles. Found with plain searches,
    so a file full of unclosed comment openers costs no more than its length."""
    pos = 0
    while True:
        start = text.find("<!--", pos)
        if start < 0:
            break
        end = text.find("-->", start + 4)
        if end < 0:
            break
        yield start, text[start + 4:min(end, start + 4 + NOTE_SCAN_CHARS)]
        pos = end + 3
    for m in HIDDEN_STYLE.finditer(text):
        close = text.find("<", m.end())
        yield m.start(), text[m.end():min(close if close >= 0 else len(text), m.end() + NOTE_SCAN_CHARS)]
    for m in LINK_TITLE.finditer(text):
        yield m.start(), m.group(1) or m.group(2)


def scan(text, name="<stdin>", marker=True, fragment=False, only_lines=None, cap=True):
    """Return (findings, skipped). Hard findings mean the content is defective."""
    # A lone CR ends a line for editors too (old Mac files), so line 32 cannot pass for line 1.
    head = "\n".join(text.replace("\r\n", "\n").replace("\r", "\n").split("\n")[:30])
    if marker and MARKER in head:
        return [], True

    what = kind(name)
    exact = is_manifest(name)
    prose = what == "prose"
    markup = os.path.splitext(name)[1].lower() in MARKUP_EXT
    out = []
    # Old Mac line endings: in text, and in Python, which reads a lone CR as a line break. In
    # other code (a shell script, say) a lone CR stays on the line and can hide what runs.
    if "\n" not in text and "\r" in text and (what != "code" or effective_ext(name, text) in (".py", ".pyi")):
        text = text.replace("\r", "\n")          # old Mac line endings, in text; in code a CR can hide a line
    lines = text.split("\n")
    code_ext = code_ext_of(name, text)

    # Python decodes a source file by its coding cookie: under utf-7 (or another encoding a UTF-8
    # reader does not share) plain ASCII here becomes hidden characters and lookalike names there.
    if effective_ext(name, text) in (".py", ".pyi"):
        for k, line in enumerate(lines[:2], 1):
            cookie = PY_CODING.match(line)
            if cookie and not _ascii_compatible(cookie.group(1)):
                out.append(Finding(HARD, k, 1, "encoding", "coding cookie %r: Python reads this file in an encoding this "
                                   "scan does not see" % cookie.group(1)))
                break

    defined = set(re.findall(r"(?m)^[ \t]{0,3}\[([^\]\n]{1,200})\]:", text)) if prose else set()
    defined |= {d.lower() for d in defined}
    spans_all, spans_names, offsets, at = None, None, [], 0
    for l in lines:
        offsets.append(at)
        at += len(l) + 1
    known = effective_ext(name, text) in KNOWN_CODE or os.path.basename(name).lower() in KNOWN_CODE_NAMES
    if what == "code" and not text.isascii():
        spans_all = text_spans(text, name)
    code_text = "".join(c for k, c in enumerate(text) if spans_all is None or not spans_all[k])
    # Distinct names: one dotless name used twice is no evidence that the file is Turkish.
    # A dotless name whose dotted form is also a name (admin and adm\u0131n) is evidence of a
    # lookalike, not of Turkish.
    # Whole identifiers (kullanici_getir), not the words in them: the ASCII part of one snake_case
    # name is no dotted twin of a Turkish name.
    code_words = set(re.findall(r"\w+", code_text))
    dotless = {w for w in code_words if "\u0131" in w}
    # Evidence is Turkish text in the strings and comments, Turkish letters in other names, or
    # a name with two dotless letters (kullan\u0131c\u0131) beside another dotless name: such a name
    # alone is not (__\u0131n\u0131t__ would vouch for itself), nor are two names of one dotless letter.
    quoted = "".join(c for k, c in enumerate(text) if spans_all is not None and spans_all[k])
    # A word, not a lone letter: "// \u015f" says nothing about the names below it.
    turkish = (any(len(w) >= 3 and TURKISH_TEXT.search(w) for w in WORD.findall(quoted))
               or any(len(w) >= 3 and TURKISH_NAME.search(w) for w in code_words)
               or (len(dotless) >= 2 and any(w.count("\u0131") >= 2 for w in dotless))) \
        and not any(w.replace("\u0131", "i") in code_words for w in dotless)
    # A real word of a script vouches for the lookalike names of that script near it, not for
    # every name in the file.
    line_real_code = [_real_scripts("".join(c for k, c in enumerate(l, offsets[n]) if spans_all is None or not spans_all[k]))
                      if not l.isascii() else set() for n, l in enumerate(lines)]
    twins = {}
    if spans_all is not None:
        by_skeleton = {}
        for m in re.finditer(r"\w+", text):
            if not spans_all[m.start()]:
                # NFKC first, so a ligature (U+FB01 for fi) or a script l is the letters it folds to;
                # a modifier letter stays itself, as x with subscript i is not the name xi.
                fold = "".join(c if _modifier_letter(c) else unicodedata.normalize("NFKC", c) for c in m.group(0))
                by_skeleton.setdefault("".join(SKELETON.get(c, c) for c in fold), set()).add(m.group(0))
        for names in by_skeleton.values():
            for word in names:
                if len(names) > 1 and not word.isascii():
                    twins[word] = min(names - {word})
    text_rows = [n for n, l in enumerate(lines, 1) if l.strip()]
    # A fragment (the new text of an edit) has no first or last line of a file.
    first_text, last_text = (set(), set()) if fragment else (set(text_rows[:1]), set(text_rows[-EDGE_LINES:]))
    in_fence = False
    # Other code blocks of documentation markup: the indented body of an rst literal block or
    # code-block directive, an AsciiDoc ---- listing, an HTML <pre>.
    literal_at, listing, pre = None, False, False
    asciidoc = os.path.splitext(name)[1].lower() in (".adoc", ".asciidoc")
    mask = template_mask(text, os.path.splitext(name)[1].lower()) if what == "code" else None
    names = manifest_mask(text, name) if exact and not text.isascii() else None
    for i, line in enumerate(lines, 1):
        if not line:
            continue
        if prose and line.lstrip().startswith(("```", "~~~")):
            in_fence = not in_fence
        in_block = in_fence
        if prose:
            indent = len(line) - len(line.lstrip(" \t"))
            if literal_at is not None and line.strip() and indent <= literal_at:
                literal_at = None
            in_block = in_block or literal_at is not None
            if literal_at is None and re.match(r"[ \t]*\.\. (?:code-block|code|sourcecode)::|(?![ \t]*\.\. ).*::[ \t]*$", line):
                literal_at = indent
            if asciidoc and re.match(r"-{4,}[ \t]*$", line):
                listing = not listing
            pre = pre or bool(re.search(r"(?i)<pre\b", line))
            in_block = in_block or listing or pre
            if re.search(r"(?i)</pre>", line):
                pre = False
        for m in ASCII_CONTROL.finditer(line):
            o = ord(m.group(0))
            out.append(Finding(HARD, i, m.start() + 1, "control-char",
                               "U+%04X %s" % (o, {0x1B: "ESCAPE (can hide text in a terminal)", 0x0D: "CARRIAGE RETURN inside a line "
                                                  "(overwrites what came before it in a terminal)", 0x08: "BACKSPACE",
                                                  0x00: "NUL"}.get(o, "control character"))))
        if "\x0c" in line:
            out.append(Finding(SOFT, i, line.index("\x0c") + 1, "control-char", "U+000C FORM FEED"))
        if not line.isascii():
            if spans_all is None and what == "code":
                spans_all = text_spans(text, name)
            if spans_all is not None and spans_names is None:
                spans_names = tail_comments(text, spans_all)
            _scan_chars(line, i, what, markup, out, exact,
                        spans_names[offsets[i - 1]:offsets[i - 1] + len(line)] if spans_all is not None else None, known,
                        mask[offsets[i - 1]:offsets[i - 1] + len(line)] if mask is not None else None,
                        effective_ext(name, text) in (".py", ".pyi"),
                        os.path.splitext(name)[1].lower() in CONFIG_LIKE, turkish, code_ext,
                        set().union(*line_real_code[max(0, i - 1 - CONTEXT_LINES):i + CONTEXT_LINES]), name,
                        names[offsets[i - 1]:offsets[i - 1] + len(line)] if names is not None else None,
                        twins, code_words)

        taken = set()
        phrase = line.rstrip()[:PHRASE_CHARS]      # phrase rules need no more, and no rule can then slow down
        for pat, why in PLACEHOLDER:
            m = re.search(pat, phrase)
            if m:
                taken.add(m.start() + 1)
                out.append(Finding(SOFT if (prose and in_block) else HARD, i, m.start() + 1, "placeholder",
                                   "%s: %r" % (why, m.group(0)[:60])))
        for pat, why in SCAFFOLDING:
            m = re.search(pat, phrase)
            if m:
                if spans_all is None and what == "code":
                    spans_all = text_spans(text, name)
                at = offsets[i - 1] + m.start()
                quoted = what == "code" and spans_all is not None and at < len(spans_all) and spans_all[at] == TEXT_STRING
                out.append(Finding(SOFT if quoted else HARD, i, m.start() + 1, "scaffolding",
                                   "%s: %r" % (why, m.group(0)[:60])))
        # Inline code: `x`, an rst ``literal``, an HTML <code> element.
        inline = [c.span() for c in re.finditer(r"(`+)[^`].*?\1|<code\b[^>]*>.*?</code>", line, re.I)] \
            if prose and ("`" in line or "<" in line) else []
        in_code = lambda pos: any(a <= pos < b for a, b in inline)
        usage_line = re.match(r"[ \t]*(usage|synopsis):", line, re.I) or line.startswith(("    ", "\t"))
        if prose and not in_block and not usage_line:
            for m in PROSE_PLACEHOLDER.finditer(line):
                if not in_code(m.start()) and m.group(1) not in defined:
                    taken.add(m.start() + 1)
                    out.append(Finding(HARD, i, m.start() + 1, "placeholder", "unfilled template placeholder: %r" % m.group(0)))
            for rx, edge, why in ((PREAMBLE, first_text, "conversational preamble"), (TRAILER, last_text, "conversational trailer")):
                m = rx.search(line)
                if m:
                    out.append(Finding(HARD if i in edge else SOFT, i, m.start() + 1, "scaffolding", "%s: %r" % (why, m.group(0)[:60])))

        if prose and not in_block:
            bullet = re.match(r"[ \t]*[-*+][ \t]+", line)
            bullet_end = bullet.end() if bullet else -1
            table_row = "|" in line
            synopsis = re.match(r"[ \t]*(usage|synopsis):", line, re.I) or line.startswith(("    ", "\t"))
            for m in BRACKET_SLOT.finditer(line):
                if in_code(m.start()) or synopsis or line[m.start() - 1:m.start()] == "[" \
                        or m.group(1).lower() in defined:
                    continue          # a usage line, an indented code block, a [[wiki link]], a defined label
                if m.start() + 1 not in taken:
                    label = m.group(1)
                    # Not a slot: a reference label with its definition in the file, a changelog
                    # or list tag, a table cell, an rst citation, a LaTeX option.
                    k = m.start() - 1
                    while k >= 0 and line[k] in " \t":
                        k -= 1
                    used = label in defined or line[m.end():m.end() + 1] in ("_", "{") \
                        or m.start() == bullet_end or table_row or (k >= 0 and line[k] == "}")
                    known = label.lower() in TEMPLATE_SLOTS and not used
                    if label in defined:
                        continue          # a reference link with its definition: nothing to fill
                    out.append(Finding(HARD if known else SOFT, i, m.start() + 1, "placeholder",
                                       "%s: %r" % ("unfilled template slot" if known else "bracketed words (a template slot?)", m.group(0))))
            for rx, why in NEGATION:
                m = rx.search(line)
                if m and not in_code(m.start()):
                    out.append(Finding(SOFT, i, m.start() + 1, "negation", why))
                    break

        if prose:
            low = line.lower()
            m = VOCAB_RE.search(low)
            while m:
                out.append(Finding(SOFT, i, m.start() + 1, "vocab", "'%s' - use the plain word" % m.group(1)))
                m = VOCAB_RE.search(low, m.end())
            for p in VOCAB_PHRASES:
                k = low.find(p)
                if k >= 0:
                    out.append(Finding(SOFT, i, k + 1, "phrase", "'%s'" % p))

    ext = os.path.splitext(name)[1].lower()

    c_family = {".c", ".h", ".cc", ".cpp", ".cxx", ".hpp", ".hh", ".hxx", ".m", ".mm", ".cu"}
    escape_text, escape_offsets = text, list(range(len(text) + 1))
    if ext in c_family and "\\\n" in text:
        kept = [(c, k) for k, c in enumerate(text) if not (c == "\\" and k + 1 < len(text) and text[k + 1] == "\n")
                and not (c == "\n" and k and text[k - 1] == "\\")]
        escape_text = "".join(c for c, _ in kept)
        escape_offsets = [k for _, k in kept] + [len(text)]

    def escape_row(m, o, how="writes"):
        pos = m.start()
        row = _row_of(text, pos)
        out.append(Finding(SOFT if prose else HARD, row + 1, pos - text.rfind("\n", 0, pos), "hidden-escape",
                           "%r %s U+%04X, an invisible character" % (m.group(0)[:40], how, o)))

    for pattern, base, exts in OTHER_ESCAPES:
        if exts is None or ext in exts:
            for m in pattern.finditer(text):
                o = int(m.group(1).replace("_", "") or "0", base)
                if _hidden_code_point(o) and not _escaped(text, m.start()):
                    escape_row(m, o)
    if effective_ext(name, text) in X_CODE_POINT_EXT and X_CODE_POINT.search(text):
        literals_x = []
        spans_x = tail_comments(text, text_spans(text, name, literals_x))
        literals_x.sort()
        yaml_strings = [(lit.start(), lit.end()) for lit in _yaml_quoted(text)] if ext in (".yaml", ".yml") else None
        for m in X_CODE_POINT.finditer(text):
            if m.group(2) and ext in (".yaml", ".yml", ".dart", ".cs"):
                continue                      # no octal escapes there
            o = int(m.group(1), 16) if m.group(1) else int(m.group(2), 8)
            if not _hidden_code_point(o) or _escaped(text, m.start()):
                continue
            if yaml_strings is not None:
                if not any(a <= m.start() < b for a, b in yaml_strings):
                    continue
            else:
                if spans_x[m.start()] == TEXT_COMMENT:
                    continue                  # a comment that mentions \x85 is text
                # Outside any string the column is code the tokenizer may have misread (a quote
                # it missed): judged like a string that starts there, so a misread fails closed.
                k, end = _literal_at(literals_x, m.start()) or (m.start(), text.find("\n", m.start()) % (len(text) + 1))
                prefix = re.search(r"[A-Za-z_]*$", text[max(0, k - 4):k]).group(0).lower()
                if (ext in (".py", ".pyi") and prefix in ("b", "br", "rb", "r", "rf", "fr", "rt", "tr")) or (ext == ".dart" and prefix == "r"):
                    continue                  # Python bytes (a byte) or raw string (a backslash)
                if text[max(0, k - 10):k].endswith("String.raw") or (ext == ".cs" and "@" in text[k - 1:k + 1]):
                    continue                  # a raw template or a C# verbatim string: a backslash
                if ext in (".pl", ".pm") and text[k:k + 1] == "'":
                    continue                  # a Perl single-quoted string takes no escapes
                if o == 0x85:
                    escape_row(m, o)
                    continue                  # NEL is never an ordinary text byte
                if 0x80 <= o <= 0x9F:
                    others = [int(e[2:], 16) if e[1] == "x" else int(e[1:], 8)
                              for e in re.findall(r"\\(?:x[0-9a-fA-F]{2}|[0-3][0-7]{2})", text[k:end])]
                    if sum(1 for v in others if not 0x20 <= v <= 0x7E) > 1 or re.match(r"[A-Z]{2,}", text[m.end():m.end() + 3]):
                        continue              # one byte among others ("\x89PNG\r\n\x1a\n"): binary data, not text
            escape_row(m, o)
    if ext in (".lua", ".ml", ".mli"):
        for m in LUA_BYTES.finditer(text):
            data = bytes(min(int(x[1:]), 255) for x in re.findall(LUA_BYTE_ONE, m.group(0)))
            hidden = [c for c in data.decode("utf-8", "ignore") if _hidden_in_bytes(ord(c))]
            if hidden and not _escaped(text, m.start()):
                escape_row(m, ord(hidden[0]), "spells in UTF-8 bytes")
    if ext in (".yaml", ".yml"):
        # YAML double-quoted strings: \L line separator, \P paragraph separator, \N next line.
        for lit in _yaml_quoted(text):
            for m in re.finditer(r"\\([LPN])", lit.group(0)):
                if not _escaped(lit.group(0), m.start()):
                    escape_row(lit, {"L": 0x2028, "P": 0x2029, "N": 0x85}[m.group(1)])
                    break
    if ext == ".sql":
        for lit in PG_UNICODE.finditer(text):
            esc = re.escape(lit.group(3) or "\\")
            for m in re.finditer(esc + r"(?:\+([0-9a-fA-F]{6})|([0-9a-fA-F]{4}))", lit.group(1) or lit.group(2) or ""):
                o = int(m.group(1) or m.group(2), 16)
                if _hidden_code_point(o):
                    escape_row(lit, o)
                    break
    if ext in CSS_ESCAPE_EXT:
        if ext in (".css", ".scss", ".less", ".sass"):
            regions = [(0, len(text))]
        else:
            # In a page, CSS is only in <style> blocks and style attributes; elsewhere a backslash
            # is text (C:\Users\Admin).
            regions = [(m.end(), (text.lower().find("</style", m.end()) + 1 or len(text) + 1) - 1)
                       for m in re.finditer(r"(?i)<style\b[^>]{0,500}>", text)]
            regions += [m.span(2) for m in re.finditer(r"""(?i)\bstyle[ \t]*=[ \t]*(["'])(.*?)\1""", text)]
        found = [m for a, b in regions for m in CSS_ESCAPE.finditer(text, a, b)]
        for m in found:
            o = int(m.group(1), 16)
            if _hidden_code_point(o) and not _escaped(text, m.start()):
                row = _row_of(text, m.start())
                out.append(Finding(HARD, row + 1, m.start() - text.rfind("\n", 0, m.start()), "hidden-escape",
                                   "%r writes U+%04X, an invisible character" % (m.group(0), o)))
    if effective_ext(name, text) in WIDE_X_EXT:
        spans_w = text_spans(text, name) if ext == ".cs" and "@\"" in text else None
        for m in WIDE_X.finditer(text):
            o = int(m.group(1), 16)
            if spans_w is not None and spans_w[m.start()]:
                k = m.start()
                while k > 0 and spans_w[k - 1]:
                    k -= 1
                if text[k:k + 1] == "@" or text[k - 1:k] == "@":
                    continue                  # a C# verbatim string: the backslash is a character
            if _hidden_code_point(o) and not _escaped(text, m.start()):
                row = _row_of(text, m.start())
                out.append(Finding(HARD, row + 1, m.start() - text.rfind("\n", 0, m.start()), "hidden-escape",
                                   "%r writes U+%04X, an invisible character" % (m.group(0), o)))
    per_row = {}
    for m in ESCAPED_HIDDEN.finditer(escape_text):
        g = m.groups()
        original_pos = escape_offsets[m.start()]
        if m.group(0).startswith("\\") and _escaped(text, original_pos) and not _shell_live(text, original_pos, ext):
            continue                 # "\\u200b": an escaped backslash, then plain letters
        if g[5]:
            # JavaScript allows any number of leading zeros: \u{0000000000E0049}.
            digits = [x.replace("_", "").lstrip("0") or "0" for x in g[5].split()]
            listed = [int(x, 16) for x in digits if len(x) <= 8]
            o = next((c for c in listed if _hidden_code_point(c)), listed[0] if listed else -1)
        elif g[4]:
            o = int(g[4])
            if ext in HTML_PAGES:
                o = _cp1252_reference(o)
        elif g[0] or g[1] or g[2] or g[3] or g[8]:
            o = int((g[0] or g[1] or g[2] or g[3] or g[8]).replace("_", "") or "0", 16)
            if g[3] and ext in HTML_PAGES:
                o = _cp1252_reference(o)
        elif g[6]:
            try:
                try:
                    o = ord(unicodedata.lookup(" ".join(g[6].split()))[0])
                except KeyError:
                    o = ord(unicodedata.lookup(re.sub(r"[-_ ]+", " ", g[6]).strip())[0])   # loose spellings
            except (KeyError, TypeError):
                continue
        elif g[7]:
            if what == "code" and ext not in MARKUP_CODE | MARKUP_EXT:
                continue                  # &it; in C++ or Rust is an address-of, not an entity
            entity = html.entities.html5.get(g[7] + ";")
            if not entity:
                continue
            o = ord(entity[0])
        else:
            pair = re.findall(r"[0-9a-fA-F]{4}", m.group(0))
            o = 0x10000 + ((int(pair[0], 16) - 0xD800) << 10) + (int(pair[1], 16) - 0xDC00)
        if _hidden_code_point(o):
            row = _row_of(text, original_pos)
            per_row[row] = per_row.get(row, 0) + 1
            if per_row[row] > PER_LINE_LIMIT:
                continue              # a line this full of them is reported; the rest adds nothing
            out.append(Finding(SOFT if prose else HARD, row + 1, original_pos - text.rfind("\n", 0, original_pos),
                               "hidden-escape", "%r writes U+%04X, an invisible character" % (m.group(0), o)))
    # Byte escapes (\xf3\xa0\x81\x89, \363\240\201\211) that spell hidden characters in UTF-8.
    byte_text = text
    if ext in (".sh", ".bash", ".zsh", ".ksh", ".fish"):
        byte_text = text.replace("\\\\", "\\")    # the shell halves backslashes before printf %b or echo -e
    runs = list((BYTE_ESCAPES_ADJACENT if ext in c_family | {".go", ".py", ".pyi"} else BYTE_ESCAPES).finditer(byte_text))
    if ext in (".py", ".pyi"):
        # Python joins the elements of a list only in b"".join([...]); elsewhere a comma separates values.
        joined = [m for m in BYTE_ESCAPES.finditer(byte_text)
                  if re.search(r"\.join\([ \t\r\n]*[\[(][^\])]*$", byte_text[max(0, m.start() - 500):m.start()])]
        runs = joined + [m for m in runs if not any(j.start() <= m.start() < j.end() for j in joined)]
    for m in runs:
        raw = m.group(0)
        parts = re.findall(BYTE_ESCAPE_ONE, raw)
        data = bytes(int(p[2:], 16) if p[1] in "xX" else int(p[1:], 8) for p in parts)
        decoded = data.decode("utf-8", "ignore")
        hidden = [c for c in decoded if _hidden_in_bytes(ord(c))]
        try:
            data.decode("utf-8")
            clean = True
        except UnicodeDecodeError:
            clean = False
        # Random bytes (a gzip or PNG fixture) spell such a character now and then; text written
        # to hide decodes cleanly, or holds them in a run (a tag sequence).
        if hidden and (clean or _hidden_run(decoded) or any(0xE0000 <= ord(c) <= 0xE007F for c in hidden)):
            row = _row_of(byte_text, m.start())
            out.append(Finding(SOFT if prose else HARD, row + 1, m.start() - byte_text.rfind("\n", 0, m.start()), "hidden-escape",
                               "%r spells U+%04X, an invisible character, in UTF-8 bytes" % (raw[:40], ord(hidden[0]))))
    # Percent-encoding (decodeURIComponent, unquote) of hidden characters.
    if what != "prose":
        for m in PERCENT_RUN.finditer(text):
            data = bytes(int(x[1:], 16) for x in re.findall(r"%[0-9a-fA-F]{2}", m.group(0)))
            decoded = data.decode("utf-8", "ignore")
            hidden = [c for k, c in enumerate(decoded) if _hidden_in_bytes(ord(c))
                      and not (ord(c) in (0xFE0F, ZWJ) and k and _emoji_part(decoded[k - 1]))]
            try:
                data.decode("utf-8")
                clean = True
            except UnicodeDecodeError:
                clean = False
            if hidden and (clean or _hidden_run(decoded) or any(0xE0000 <= ord(c) <= 0xE007F for c in hidden)):
                row = _row_of(text, m.start())
                out.append(Finding(HARD, row + 1, m.start() - text.rfind("\n", 0, m.start()), "hidden-escape",
                                   "%r spells U+%04X, an invisible character, percent-encoded" % (m.group(0)[:40], ord(hidden[0]))))
        for m in PERCENT_U_RUN.finditer(text):
            units = [int(x[2:], 16) for x in re.findall(r"%u[0-9a-fA-F]{4}", m.group(0))]
            decoded = ""
            k = 0
            while k < len(units):
                if 0xD800 <= units[k] <= 0xDBFF and k + 1 < len(units) and 0xDC00 <= units[k + 1] <= 0xDFFF:
                    decoded += chr(0x10000 + ((units[k] - 0xD800) << 10) + units[k + 1] - 0xDC00)
                    k += 2
                else:
                    decoded += chr(units[k])
                    k += 1
            hidden = [c for c in decoded if _hidden_code_point(ord(c))]
            if hidden:
                row = _row_of(text, m.start())
                out.append(Finding(HARD, row + 1, m.start() - text.rfind("\n", 0, m.start()), "hidden-escape",
                                   "%r writes U+%04X, an invisible character, percent-encoded" %
                                   (m.group(0)[:40], ord(hidden[0]))))
    starts = None
    for offset, note in _hidden_notes(text):
        if note and INJECTION.search(note):
            if starts is None:
                starts, at = [], 0
                for line in lines:
                    starts.append(at)
                    at += len(line) + 1
            row = max(0, bisect.bisect_right(starts, offset) - 1)
            out.append(Finding(SOFT, row + 1, offset - starts[row] + 1, "hidden-instruction",
                               "text hidden from the rendered page reads like an instruction to a model: %r" % note.strip()[:60]))
    pua = sum(len(m.group(0)) for m in PUA_RUN.finditer(text))
    if pua >= PUA_HARD_FILE and not any(f.code == "private-use" and f.sev == HARD for f in out):
        # Terminal and editor configs are full of icon-font glyphs, so in code this is a warning.
        config_icons = ext in CONFIG_LIKE or ".omp." in os.path.basename(name).lower()
        out.append(Finding(SOFT if what == "code" or config_icons else HARD, 1, 1, "private-use",
                           "%d private-use characters in this file (enough to carry hidden data)" % pua))
    if not text.isascii():
        ivs = sum(1 for c in text if 0xE0100 <= ord(c) <= 0xE01EF or 0xFE00 <= ord(c) <= 0xFE0D
                  or ord(c) in MONGOLIAN_SELECTORS or ord(c) in (0x115F, 0x1160))
        if ivs >= IVS_HARD_FILE:
            out.append(Finding(HARD, 1, 1, "hidden-selectors",
                               "%d variation selectors or fillers in this file (enough to carry hidden data)" % ivs))
        # Joiners and direction marks are part of Persian, Arabic, Hebrew and Indic text, at a
        # few per hundred letters. Far more than that is not text.
        # A joiner inside an emoji sequence (family, profession, flag) is not a carrier.
        joiners = sum(1 for k, c in enumerate(text) if ord(c) in (ZWJ, ZWNJ, LRM, RLM, ALM)
                      and not (ord(c) == ZWJ and 0 < k < len(text) - 1
                               and _emoji_part(text[k - 1]) and _emoji_part(text[k + 1])))
        if joiners >= CARRIER_MIN:
            letters = sum(1 for c in text if _joining_script(c) or _is_rtl(c))
            if joiners * 100 > letters * CARRIER_SHARE:
                out.append(Finding(HARD, 1, 1, "invisible-char",
                                   "%d joiners and direction marks for %d letters that use them (enough to carry hidden data)"
                                   % (joiners, letters)))
    if is_helm_template(name) and "{{" in text and not text.isascii():
        # A Helm chart template is YAML data with Go-template code in {{ }}, whose names the
        # template engine resolves: the code is judged as a Go template, the rest as data.
        regions = template_mask(text, ".gotmpl")

        def in_code(f):
            at = offsets[f.line - 1] + f.col - 1 if f.line <= len(offsets) else -1
            return 0 <= at < len(regions) and not regions[at]
        code_only = "".join(c if c == "\n" or not regions[k] else " " for k, c in enumerate(text))
        out = [f for f in out if not in_code(f)] + [f for f in scan(code_only, os.path.splitext(name)[0] + ".gotmpl", False,
                                                                     fragment, cap=False)[0] if in_code(f)]
        out.sort(key=lambda f: (f.line, f.col))
    if only_lines is not None:
        # Report on these lines only, and apply the cap to them alone: the write guard uses it
        # to judge an edit in a file whose old findings would fill the list.
        out = [f for f in out if f.line in only_lines]
    if cap and len(out) > MAX_FINDINGS:
        out.sort(key=lambda f: (f.line, f.col))        # the cap keeps the first ones in file order
        hard = [f for f in out if f.sev == HARD]
        kept = (hard + [f for f in out if f.sev != HARD])[:MAX_FINDINGS]
        kept.append(Finding(HARD if len(hard) > MAX_FINDINGS else SOFT, 1, 1, "too-many",
                            "%d findings in this file; the first %d are shown" % (len(out), MAX_FINDINGS)))
        out = kept

    if prose:
        words = max(len(text.split()), 1)
        ems = text.count("\u2014")
        if ems > 1 and ems / (words / 1000.0) > 3:
            out.append(Finding(SOFT, 1, 1, "em-dash-density",
                               "%d em dashes in %d words - target under 3 per 1000" % (ems, words)))
    return out, False


BINARY_SAMPLE = 8000
# Extensions that are text by definition. A file with one of these is always scanned, whatever
# bytes it holds, so stray NULs or bad bytes cannot switch the scan off for it.
TEXT_EXT = PROSE_EXT | DATA_EXT | {
    ".py", ".pyi", ".js", ".jsx", ".mjs", ".cjs", ".ts", ".tsx", ".rs", ".go", ".java", ".kt", ".kts", ".scala", ".rb", ".php",
    ".swift", ".c", ".h", ".cc", ".cpp", ".hpp", ".cs", ".m", ".mm", ".dart", ".ex", ".exs", ".erl", ".hs", ".lua", ".pl", ".r",
    ".sh", ".bash", ".zsh", ".fish", ".ps1", ".bat", ".sql", ".css", ".scss", ".less", ".vue", ".svelte", ".astro",
    ".toml", ".ini", ".cfg", ".conf", ".env", ".mdc", ".mdx", ".tex", ".gradle", ".tf", ".proto", ".graphql", ".dockerfile"}
TEXT_EXT |= KNOWN_CODE | MARKUP_CODE | MARKUP_EXT | {".jsonc", ".json5", ".zig", ".jl", ".nim", ".vb", ".groovy",
                                                       ".ml", ".mli", ".el", ".scm", ".rkt", ".raku", ".rakumod"}
TEXT_NAMES = PROSE_NAMES | {"dockerfile", "makefile", "gemfile", "rakefile", "procfile", "brewfile", "justfile",
                            ".cursorrules", ".clinerules", ".windsurfrules", ".roorules", ".goosehints", ".rules",
                            ".gitignore", ".gitattributes", ".editorconfig", ".env", ".npmrc", ".aider.conf.yml"}
BINARY_SHARE = 10        # percent of NUL bytes, or of undecodable characters, that makes unnamed content binary


def is_text_name(name):
    base = os.path.basename(name).lower()
    return os.path.splitext(base)[1] in TEXT_EXT or base in TEXT_NAMES


# Names every program can reach without defining them: a dotless-i copy of one (pr\u0131nt,
# requ\u0131re) is never taken for a Turkish word, as no Turkish file needs to define it.
WELL_KNOWN_NAMES = set(dir(builtins)) | set(keyword.kwlist) | {
    "require", "import", "export", "console", "process", "window", "document", "global", "globalThis", "module",
    "exports", "fetch", "alert", "setTimeout", "setInterval", "function", "return", "this", "self", "main", "init",
    "Println", "Printf", "Sprintf", "printf", "sprintf", "fprintf", "puts", "system", "malloc", "free", "echo",
    "include", "define", "package", "public", "private", "static", "void", "string", "Main", "String", "System"}
TURKISH_TEXT = re.compile("[\u0131\u011f\u011e\u015f\u015e\u0130]")
TURKISH_NAME = re.compile("[\u00e7\u00c7\u00f6\u00d6\u00fc\u00dc\u011f\u011e\u015f\u015e\u0130]")
PY_CODING = re.compile(r"^[ \t\f]*#.*?coding[:=][ \t]*([-\w.]+)")
CHARSET_CODING = re.compile(r'''(?i)(?:<meta\b[^>]*?charset\s*=\s*["']?|@charset\s+["'])([-\w.]+)''')
SAFE_CODINGS = {"utf-8", "utf8", "utf_8", "ascii", "us-ascii", "latin-1", "latin1", "iso-8859-1", "iso8859-1",
                "cp1252", "windows-1252", "utf-8-sig"}


def _normal_codec(codec):
    """The codec a coding cookie names, as CPython's tokenizer normalizes it (get_normal_name:
    utf_8 and utf-8-unix are utf-8; latin-1, iso-latin-1 and iso-8859-1 with any suffix are
    iso-8859-1), without an Emacs line-end suffix."""
    enc = codec[:12].lower().replace("_", "-")
    if enc == "utf-8" or enc.startswith("utf-8-"):
        return "utf-8"
    if enc in ("latin-1", "iso-8859-1", "iso-latin-1") or enc.startswith(("latin-1-", "iso-8859-1-", "iso-latin-1-")):
        return "iso-8859-1"
    return re.sub(r"-(?:unix|dos|mac)$", "", codec, flags=re.I)


def _ascii_compatible(codec):
    """True for an encoding in which ASCII bytes are ASCII text (cp1251, euc-jp, shift_jis...), so
    a UTF-8 reader and Python agree on every ASCII character. UTF-7 and UTF-16 are not."""
    try:
        codec = _normal_codec(codec)
        # Backslash escapes too: unicode_escape reads ASCII bytes as ASCII but turns \\u000a into a newline.
        sample = bytes(range(32, 127)) + b"\t\n+A-\\u0041\\x41\\101\\N{DIGIT ONE}"
        with warnings.catch_warnings():
            warnings.simplefilter("ignore")      # unicode_escape warns about the sample's own backslashes
            if sample.decode(codec) != sample.decode("ascii"):
                return False
        # A codec that cannot replace bad bytes (idna, punycode) would make the legacy decode raise.
        codecs.getincrementaldecoder(codec)(errors="replace").decode(b"\xff", final=True)
        return True
    except (LookupError, UnicodeError, TypeError, ValueError):
        return False


# Three or four bytes that may be one UTF-8 character (checked by decoding them).
UTF8_WIDE = re.compile(b"[\xe0-\xef][\x80-\xbf]{2}|[\xf0-\xf4][\x80-\xbf]{3}")
ASCII_RUN = re.compile(b"[\x00-\x7f]+")


def _legacy_decode(raw, codec):
    """raw as Python, Ruby or a browser reads it under codec, except where three or four bytes
    at a character boundary are also UTF-8 for a hidden character: editors and the model may
    show that character, so it is kept for the scan to report. Two-byte UTF-8 readings are
    left alone; they turn up by chance in ordinary legacy text (Cyrillic VE before a curly quote).
    Seven-bit text is read in the codec too: iso-2022-jp switches character sets with ESC sequences."""
    if raw.isascii():
        return raw.decode(codec, "replace")
    try:
        return raw.decode("utf-8")
    except UnicodeDecodeError:
        pass
    hidden = {}
    for m in UTF8_WIDE.finditer(raw):
        try:
            c = m.group(0).decode("utf-8")
        except UnicodeDecodeError:
            continue
        if _hidden_code_point(ord(c)):
            hidden[m.start()] = (c, m.end())
    if not hidden:
        return raw.decode(codec, "replace")
    dec = codecs.getincrementaldecoder(codec)(errors="replace")
    out, p, n = [], 0, len(raw)
    while p < n:
        if p in hidden:
            out.append(hidden[p][0])
            p = hidden[p][1]
            continue
        if raw[p] < 0x80:
            k = ASCII_RUN.match(raw, p).end()
            out.append(raw[p:k].decode("ascii"))
            p = k
            continue
        # One legacy character: a lead byte takes the bytes after it (shift_jis, gbk, euc-jp).
        for k in range(p + 1, min(p + 4, n) + 1):
            dec.reset()
            try:
                piece = dec.decode(raw[p:k], final=k == min(p + 4, n))
            except (UnicodeError, ValueError):
                piece = "\ufffd"
            if piece:
                break
        out.append(piece)
        p = k
    return "".join(out)


def decode(raw, name=""):
    """(text, note). text is None for content judged binary.

    A file with a text extension is always scanned: invalid bytes are replaced and NULs are
    reported, so neither can switch the scan off. UTF-16 with a byte order mark is decoded.
    Only a file with no text extension can be skipped as binary.
    """
    note = None
    if len(raw) > MAX_SCAN_BYTES:
        raw, note = raw[:MAX_SCAN_BYTES], "larger than %d bytes; only that much was scanned" % MAX_SCAN_BYTES
    # Source files with a declared legacy encoding are scanned as their runtime sees them. Only
    # Python and Ruby read a coding comment, and only a page or stylesheet reads a charset: the
    # same words in a .js comment declare nothing.
    lang = effective_ext(name, raw[:200].decode("ascii", "replace"))
    cookie = None
    if lang in (".py", ".pyi", ".rb"):
        for line in raw.split(b"\n", 2)[:2]:
            cookie = PY_CODING.match(line.decode("ascii", "replace"))
            if cookie:
                break
    elif lang in (".html", ".htm", ".css"):
        cookie = CHARSET_CODING.search(raw[:1024].decode("ascii", "replace"))
    if cookie:
        codec = _normal_codec(cookie.group(1))
        if _ascii_compatible(codec) and codec.lower().replace("_", "-") not in ("utf-8", "utf8"):
            # The codec's reading is what runs; hidden characters that the same bytes spell in
            # UTF-8 (which editors may show, beside a stray legacy byte) are kept for the scan.
            try:
                return _legacy_decode(raw, codec), None
            except LookupError:
                pass
    if raw[:2] in (b"\xff\xfe", b"\xfe\xff") and b"\0" not in raw[2:]:
        # Two stray bytes in front of UTF-8 text are not a reason to read it as UTF-16, which
        # would turn every character into something else.
        try:
            return raw[2:].decode("utf-8"), "starts with a UTF-16 byte order mark but the rest is UTF-8; scanned as UTF-8"
        except UnicodeDecodeError:
            pass
    if raw[:2] in (b"\xff\xfe", b"\xfe\xff"):
        try:
            return raw.decode("utf-16"), "UTF-16; scanned after decoding"
        except UnicodeDecodeError:
            pass
    known_text = is_text_name(name) or raw[:2] == b"#!"
    if not known_text and raw.count(b"\0") * 100 > len(raw) * BINARY_SHARE:
        return None, None
    try:
        return raw.decode("utf-8"), note
    except UnicodeDecodeError:
        text = raw.decode("utf-8", "replace")
        if not known_text and text.count("\ufffd") * 100 > len(text) * BINARY_SHARE:
            return None, None            # largely undecodable and not a text type: another encoding or binary
        return text, "not valid UTF-8; scanned with the undecodable bytes replaced"


def read(path):
    """(text, note), or (None, None) when the path is missing, unreadable, not a regular file, or binary."""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
    except OSError:
        return None, None
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            return None, None            # a device or pipe (a symlink to /dev/zero, say) is never read
        chunks, left = [], MAX_SCAN_BYTES + 1
        while left > 0:
            chunk = os.read(fd, min(left, 1 << 20))
            if not chunk:
                break
            chunks.append(chunk)
            left -= len(chunk)
    except OSError:
        return None, None
    finally:
        os.close(fd)
    return decode(b"".join(chunks), path)


