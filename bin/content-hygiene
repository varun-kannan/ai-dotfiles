        ("js-regex-after-for-head", "for (;;) /`/.test(s);\nadm\u0131n();\nconst t = `x`;\n", "x.js", 1, 0),
        ("js-regex-after-with-head", "with (s) /`/.test(s);\nadm\u0131n();\nconst t = `x`;\n", "x.js", 1, 0),
        ("js-optional-catch-block", "try { s.x() } catch { }\n/[//a]/.test(s) && console.log(\"a\\xadb\");\n", "x.js", 1, 0),
        ("js-labeled-block", "out: { break out; }\n/[//a]/.test(s) && console.log(\"a\\xadb\");\n", "x.js", 1, 0),
        ("ts-return-type-block", "function f(): void { }\n/[//a]/.test(s) && console.log(\"a\\xadb\");\n", "x.ts", 1, 0),
        ("js-case-block", "switch (k) { case 1: { }\n/[//a]/.test(s) && console.log(\"a\\xadb\"); }\n", "x.js", 1, 0),
        ("js-default-block", "switch (k) { default: { }\n/[//a]/.test(s) && console.log(\"a\\xadb\"); }\n", "x.js", 1, 0),
        ("ts-module-block", "declare module \"m\" { }\n/[//a]/.test(s) && console.log(\"a\\xadb\");\n", "x.ts", 1, 0),
        ("ts-module-block-bare", "module X { }\n/[//a]/.test(s) && console.log(\"a\\xadb\");\n", "x.ts", 1, 0),
        ("js-object-in-label-ok", "const o = { out: { a: 1 }.a / 2, t: \"\u0435\u0445\u0435\u0441\" };\nconst r = \"/\";\n", "x.js", 0, 1),
        ("js-ternary-object-ok", "const v = c ? 1 : { a: 1 } / 2; const t = \"\u0435\u0445\u0435\u0441\"; const r = \"/\";\n", "x.js", 0, 1),
        ("perl-hash-delimiter", "$p =~ s#/usr#/opt#; my $t = \"a\\xadb\";\n", "x.pl", 1, 0),
        ("perl-hash-after-space-comment", "$x =~ s #c\n{a}{b}; \u0435\u0445\u0435\u0441(); # x #\n", "x.pl", 1, 0),
        ("perl-hash-delimiter-ok", "$p =~ s#/usr#/opt#; # it's done\nmy $t = \"\u0435\u0445\u0435\u0441\";\n", "x.pl", 0, 1),
        ("py-fstring-field-comment", "s = f\"\"\"{1 # \"\n}\"\"\" ; u = \"\"\" # \"\"\" ; v = \"a\\xad\"\n", "x.py", 1, 0),
        ("py-fstring-format-spec-hash-ok", "s = f\"{n:#x}\" + r\"\\xad\"\n", "x.py", 0, 0),
        ("ruby-dollar-quote-global", "x = $\"\n\u0435\u0445\u0435\u0441 = 1\n", "x.rb", 1, 0),
        ("ruby-dollar-apostrophe-global", "x = $'\n\u0435\u0445\u0435\u0441 = 1\n", "x.rb", 1, 0),
        ("ruby-dollar-in-string-ok", "s = \"cost: $\"\nt = \"\u0435\u0445\u0435\u0441\"\n", "x.rb", 0, 1),
        ("ruby-percent-caret", "x = %q^a\"b^\n\u0435\u0445\u0435\u0441 = 1\n", "x.rb", 1, 0),
        ("ruby-percent-w-caret-hash", "w = %w^#^; \u0435\u0445\u0435\u0441 = 1\n", "x.rb", 1, 0),
        ("ruby-bare-percent-caret", "x = %^a\"b^\n\u0435\u0445\u0435\u0441 = 1\n", "x.rb", 1, 0),
        ("ruby-modulo-ok", "y = x %-2 + \"-\"\nt = \"\u0435\u0445\u0435\u0441\"\n", "x.rb", 0, 1),
        ("js-sloppy-await-identifier", "var z = await / (globalThis.\u0435\u0445\u0435\u0441 = 2) / yield;\n", "x.js", 1, 0),
        ("js-async-await-regex-ok", "async function f(s) { return await /[\"]/.test(s) }\nconst t = \"\u0435\u0445\u0435\u0441\";\n", "x.js", 0, 1),
        ("js-generator-yield-regex-ok", "function* g(s) { yield /[\"]/.test(s) }\nconst t = \"\u0435\u0445\u0435\u0441\";\n", "x.js", 0, 1),
        ("js-module-await-regex-ok", "import a from \"a\";\nawait /[\"]/.test(a);\nconst t = \"\u0435\u0445\u0435\u0441\";\n", "x.js", 0, 1),
        ("java-unicode-newline-in-comment", "class A {\n  // note \\u000a s = \"a\\255b\";\n}\n", "A.java", 1, 0),
        ("java-escaped-unicode-in-comment-ok", "class A {\n  // note \\\\u000a s = \"a\\255b\";\n}\n", "A.java", 0, 0),
        ("trailing-comment-escape", "x = 1  # \"a\\xadb\"\n", "x.py", 1, 0),
        ("whole-line-comment-escape-ok", "# use \"a\\xadb\" for a soft hyphen\nx = 1\n", "x.py", 0, 0),
        ("trailing-comment-lookalike-name", "x = 1  # \u0435\u0445\u0435\u0441(cmd)\n", "x.py", 1, 0),
        ("whole-line-comment-lookalike-ok", "# \u0435\u0445\u0435\u0441\nx = 1\n", "x.py", 0, 1),
        ("py-bytes-list-elements-ok", "INVALID = [b\"\\xe2\\x80\",  # truncated\n    b\"\\x8b\",\n]\n", "x.py", 0, 0),
        ("py-bytes-adjacent-joined", "s = (b\"\\xe2\\x80\"  # split\n     b\"\\x8b\")\n", "x.py", 1, 0),
        ("py-iso-latin-1-cookie-ok", "# -*- coding: iso-latin-1 -*-\nx = 1\n", "x.py", 0, 0),
        ("py-iso-latin-1-unix-cookie-ok", "# -*- coding: iso-latin-1-unix -*-\nx = 1\n", "x.py", 0, 0),
        ("ruby-char-literal-cyrillic-ok", "c = ?\u0430\n", "x.rb", 0, 0),
        ("elixir-char-literal-cyrillic-ok", "c = ?\u0430\n", "x.ex", 0, 0),
        ("ruby-cyrillic-name-after-question", "c = x ?\u0435\u0445\u0435\u0441 : 1\n", "x.rb", 1, 0),
        ("perl-interpolated-strings-ok", "print \"\u0418\u0442\u043e\u0433: @{[ $n > 1 ? \"\u0441\u043e\u0440\" : \"\u0423\u0440\u0430\" ]}\";\n", "x.pl", 0, 0),
        ("perl-interpolation-code", "print \"@{[ \u0435\u0445\u0435\u0441() ]}\";\n", "x.pl", 1, 0),
        ("shell-nested-substitution-ok", "echo \"$(echo \"$(echo \"'\")\")\" \"label = \u201cSave\u201d,\"\n", "x.sh", 0, 2),
    ]
    bad = 0
    for name, text, fn, want_hard, want_soft in cases:
        f, skipped = scan(text, fn)
        h = len([x for x in f if x.sev == HARD])
        s = len([x for x in f if x.sev == SOFT])
        ok = (h == want_hard and s == want_soft)
        if not ok:
            bad += 1
        print("%-26s %s  hard=%d(want %d) soft=%d(want %d)"
              % (name, "ok  " if ok else "FAIL", h, want_hard, s, want_soft))

    decoding = [
        ("one NUL is still scanned", b"a = 1\x00\nb\xe2\x80\x8b\n", True),
        ("one bad byte is still scanned", b"a = 1\xff\nb\xe2\x80\x8b\n", True),
        ("binary is skipped", b"\x00\x01\x02\x03" * 500, False),
        ("NULs late in a script", b"#!/bin/sh\necho ok\n" * 600 + b"\x00" * 80 + "b\u200b\n".encode(), True),
        ("a few NULs, no extension", b"notes\x00\x00\x00\x00\nb\xe2\x80\x8b\n" + b"plain text line\n" * 20, True),
        ("UTF-8 behind a UTF-16 mark is read as UTF-8", b"\xff\xfe" + ("a = 1\u200b\n" * 20).encode("utf-8"), True),
        ("UTF-16 with a mark is read", ("a = 1\u200b\n" * 20).encode("utf-16"), True),
    ]
    decoding += [
        ("many NULs in a text file", b"x = 1\x00\x00\x00\x00\x00\n" * 40 + b"b\xe2\x80\x8b\n", True),
        ("many bad bytes in a text file", b"\xff" * 60 + b"\nb\xe2\x80\x8b\n", True),
        ("idna cookie text file still scanned", b"# coding: idna\n# \xff\nx = '\xe2\x80\x8b'\n", True),
        ("unicode_escape cookie text file blocks", b"# coding: unicode_escape\n# a \\u000a b = 1\n", True),
    ]
    exact = [
        ("UTF-8 behind a UTF-16 mark keeps its text", b"\xff\xfe" + "a = 1\n".encode("utf-8"), "x.py", "a = 1\n"),
        ("only the first 2 MB are scanned", b"a" * 2000005, "x.py", "a" * 2000000),
        ("legacy cookie over UTF-8 bytes reads UTF-8", b"# coding: cp437\nx = '\xe2\x80\x8b'\n", "x.py",
         "# coding: cp437\nx = '" + chr(0x200B) + "'\n"),
        ("legacy cookie over legacy bytes reads legacy", b"# coding: cp1251\nx = '\xcf\xf0'\n", "x.py",
         "# coding: cp1251\nx = '" + chr(0x41F) + chr(0x440) + "'\n"),
        ("Ruby legacy cookie reads legacy", b"# coding: windows-1251\nx = '\xe0'\n", "x.rb",
         "# coding: windows-1251\nx = '" + chr(0x430) + "'\n"),
        ("HTML legacy charset reads legacy", b"<meta charset=windows-1252>\n<p>ad\xad min</p>\n", "x.html",
         "<meta charset=windows-1252>\n<p>ad" + chr(0xAD) + " min</p>\n"),
        ("CSS legacy charset reads legacy", b"@charset \"windows-1252\";\na:after { content: '\xad'; }\n", "x.css",
         "@charset \"windows-1252\";\na:after { content: '" + chr(0xAD) + "'; }\n"),
        ("coding cookie on line 3 is ignored", b"a = 1\nb = 2\n# coding: cp1251\nx = '\xcf\xf0'\n", "x.py",
         "a = 1\nb = 2\n# coding: cp1251\nx = '" + chr(0xFFFD) * 2 + "'\n"),
        ("coding cookie on line 2 is read", b"#!/usr/bin/python\n# coding: cp1251\nx = '\xcf\xf0'\n", "x.py",
         "#!/usr/bin/python\n# coding: cp1251\nx = '" + chr(0x41F) + chr(0x440) + "'\n"),
        ("coding comment in js is ignored", b"# coding: cp1251\nx = '\xcf\xf0';\n", "x.js",
         "# coding: cp1251\nx = '" + chr(0xFFFD) * 2 + "';\n"),
        ("shift_jis text beside hidden char", b"# coding: shift_jis\nX = '" + (chr(0x65E5) + chr(0x672C) + chr(0x8A9E)).encode("shift_jis") + b"'  # \xe2\x80\x8b\n", "x.py",
         "# coding: shift_jis\nX = '" + (chr(0x65E5) + chr(0x672C) + chr(0x8A9E)) + "'  # " + chr(0x200B) + "\n"),
        ("gbk text beside hidden char", b"# coding: gbk\nX = '" + (chr(0x4E2D) + chr(0x6587) + chr(0x5B57)).encode("gbk") + b"'  # \xe2\x80\x8b\n", "x.py",
         "# coding: gbk\nX = '" + (chr(0x4E2D) + chr(0x6587) + chr(0x5B57)) + "'  # " + chr(0x200B) + "\n"),
        ("iso-2022-jp seven-bit text reads in its codec", b"# coding: iso-2022-jp\nX = '" + (chr(0x65E5) + chr(0x672C)).encode("iso2022_jp") + b"'\n", "x.py",
         "# coding: iso-2022-jp\nX = '" + chr(0x65E5) + chr(0x672C) + "'\n"),
    ]
    for name, raw, fn, want in exact:
        ok = decode(raw, fn)[0] == want
        if not ok:
            bad += 1
        print("%-26s %s" % (name[:26], "ok  " if ok else "FAIL"))
    # A charset or coding comment that the language does not read, or valid UTF-8 beside one
    # stray byte under a declared legacy encoding: the UTF-8 characters are still seen.
    stray = [
        ("ts comment charset", b"// <meta charset=koi8-r>\nconst a = '\xe2\x80\xae';\n// \xc1\n", "app.ts"),
        ("js string charset", b"const s = '<meta charset=koi8-r>';\nconst a = 1;\xe2\x80\xae\n// \xc1\n", "app.js"),
        ("py cookie, UTF-8 and a stray byte", b"# coding: cp1251\nx = 'a\xe2\x80\x8bb'\n# \xc1\n", "x.py"),
        ("rb cookie, UTF-8 and a stray byte", b"# encoding: koi8-r\nx = 'a\xe2\x80\x8bb'\n# \xc1\n", "x.rb"),
        ("html charset, UTF-8 and a stray byte", b"<meta charset=koi8-r>\n<p>a\xe2\x80\x8bb \xc1</p>\n", "x.html"),
        ("cp1251 stray byte, UTF-8 tags", b'# coding: cp1251\nx = "\xcf\xf0' + chr(0xE0049).encode() + chr(0xE0047).encode()
         + b'"\n', "x.py"),
    ]
    for name, raw, fn in stray:
        ok = any(x.sev == HARD for x in scan(decode(raw, fn)[0], fn)[0])
        if not ok:
            bad += 1
        print("%-26s %s" % (name[:26], "ok  " if ok else "FAIL"))
    # Legacy text whose byte pairs happen to be UTF-8 is read in its codec, as Python reads it.
    legacy_ok = [
        ("cp1251 VE before curly quote", b'# coding: cp1251\nCITY = "\x93\xca\xc8\xc5\xc2\x94 \xc2\x85 \xc2\x97 \xc2\x96"\n', "x.py", "cp1251"),
        ("cp1251 css VE before quote", b'@charset "windows-1251";\na:after { content: "\xca\xc8\xc5\xc2\x94"; }\n', "x.css", "cp1251"),
        ("cp1251 html VE before quote", b'<meta charset=windows-1251>\n<p>\xca\xc8\xc5\xc2\x94</p>\n', "x.html", "cp1251"),
        ("euc-jp C2 AD character", b'# coding: euc-jp\nERR = "' + (chr(0x4E0D) + chr(0x8DB3)).encode("euc_jp") + b'"\n', "x.py", "euc_jp"),
        ("euc-jp ruby C2 AD character", b'# encoding: euc-jp\nERR = "' + (chr(0x4E0D) + chr(0x8DB3)).encode("euc_jp") + b'"\n', "x.rb", "euc_jp"),
        ("shift_jis half-width katakana", b'# coding: shift_jis\nX = "' + (chr(0xFF8D) + chr(0xFF9E) + chr(0xFF82) + chr(0x306E)).encode("shift_jis") + b'"\n', "x.py", "shift_jis"),
        ("gbk level-1 character", b'# coding: gbk\nX = "' + (chr(0x4E00) + chr(0x4E2A)).encode("gbk") + b'"\n', "x.py", "gbk"),
        ("big5 level-1 character", b'# coding: big5\nX = "' + chr(0x4E00).encode("big5") + b'"\n', "x.py", "big5"),
        ("euc-kr level-1 character", b'# coding: euc-kr\nX = "' + chr(0xAC00).encode("euc_kr") + b'"\n', "x.py", "euc_kr"),
    ]
    for name, raw, fn, codec in legacy_ok:
        text = decode(raw, fn)[0]
        ok = text == raw.decode(codec) and not any(x.sev == HARD for x in scan(text, fn)[0])
        if not ok:
            bad += 1
        print("%-26s %s" % (name[:26], "ok  " if ok else "FAIL"))
    # A rename that changes the rules a file is read by (a Dockerfile's RUN lines are shell text)
    # is judged again; one that keeps them is not.
    moves = [("a/Dockerfile", "a/build", True), ("Makefile", "rules", True), ("x.py", "y.py", False),
             ("a/Dockerfile", "b/Dockerfile", False)]
    for old, new, want in moves:
        ok = move_rejudged(old, new) == want
        if not ok:
            bad += 1
        print("%-26s %s" % (("move " + old + " " + new)[:26], "ok  " if ok else "FAIL"))
    many = "b\u200b\n" * 300
    ok = len(scan(many, "x.py")[0]) == MAX_FINDINGS + 1 and len(scan(many, "x.py", cap=False)[0]) == 300 \
        and len(scan(many, "x.py", only_lines=set(range(1, 301)), cap=False)[0]) == 300
    if not ok:
        bad += 1
    print("%-26s %s" % ("no cap reports all 300", "ok  " if ok else "FAIL"))
    for name, raw, scanned in decoding:
        text, _note = decode(raw, "x.py" if "text file" in name else "")
        ok = (text is not None) == scanned and (not scanned or any(x.sev == HARD for x in scan(text, "x.py")[0]))
        if not ok:
            bad += 1
        print("%-26s %s" % (name[:26], "ok  " if ok else "FAIL"))
    total = len(cases) + len(decoding) + len(exact) + len(stray) + len(legacy_ok) + len(moves) + 1
    print("\n%d/%d passed" % (total - bad, total))
    return 1 if bad else 0


def _late(signum, frame):
    raise TimeoutError()


def scan_within(text, path, marker, deadline, fragment=False, only_lines=None, cap=True):
    """scan() under the run's deadline. Past it, TimeoutError: the caller reports the file as not checked."""
    if deadline is None or not hasattr(signal, "SIGALRM"):
        return scan(text, path, marker=marker, fragment=fragment, only_lines=only_lines, cap=cap)
    left = deadline - time.monotonic()
    if left <= 0:
        raise TimeoutError()
    old = signal.signal(signal.SIGALRM, _late)
    signal.setitimer(signal.ITIMER_REAL, left)
    try:
        return scan(text, path, marker=marker, fragment=fragment, only_lines=only_lines, cap=cap)
    finally:
        signal.setitimer(signal.ITIMER_REAL, 0)
        signal.signal(signal.SIGALRM, old)


def main():
    ap = argparse.ArgumentParser(add_help=True)
    ap.add_argument("files", nargs="*")
    ap.add_argument("--stdin", action="store_true")
    ap.add_argument("--name", default="<stdin>")
    ap.add_argument("--quiet", action="store_true", help="print hard findings only")
    ap.add_argument("--security", action="store_true",
                    help="print hard findings and the hidden-text warnings; leave out the prose-style ones")
    ap.add_argument("--lines", default=None,
                    help="report only on these lines, e.g. 3-5,9 (the cap then counts only them)")
    ap.add_argument("--no-cap", dest="cap", action="store_false",
                    help="report every finding: no limit of %d per file and no too-many row (works with --lines)"
                    % MAX_FINDINGS)
    ap.add_argument("--fragment", action="store_true",
                    help="the content is part of a file (the new text of an edit): no first-line or last-line rules")
    ap.add_argument("--no-marker", dest="marker", action="store_false",
                    help="scan even when the content carries the opt-out marker (for a fragment of a file)")
    ap.add_argument("--classify-moves", dest="moves", action="store_true",
                    help="read NUL-separated old/new path pairs on stdin; print, NUL-separated, each new path judged differently")
    ap.add_argument("--classify", action="store_true",
                    help="print how each named path is judged (kind, and whether it is a manifest), and exit")
    ap.add_argument("--deadline", type=float, default=0,
                    help="seconds for the whole run; a file not finished by then is a hard 'not checked' finding")
    ap.add_argument("--self-test", dest="selftest", action="store_true")
    a = ap.parse_args()
    only_lines = None
    if a.lines is not None:
        only_lines = set()
        for part in a.lines.split(","):
            lo, _, hi = part.strip().partition("-")
            if not lo.isdigit() or (hi and not hi.isdigit()):
                ap.error("--lines takes line numbers and ranges such as 3-5,9")
            only_lines.update(range(int(lo), int(hi or lo) + 1))
    if a.deadline != 0 and not (0 < a.deadline <= 86400):          # also rejects nan and inf
        ap.error("--deadline takes a number of seconds above 0 and at most 86400")

    for stream in (sys.stdout, sys.stderr):
        try:
            stream.reconfigure(errors="backslashreplace")      # a finding must print under any locale
        except (AttributeError, ValueError):
            pass
    if a.selftest:
        return self_test()
    if a.moves:
        names = [n for n in sys.stdin.buffer.read().split(b"\0") if n]
        for old_b, new_b in zip(names[0::2], names[1::2]):
            old_p, new_p = old_b.decode("utf-8", "surrogateescape"), new_b.decode("utf-8", "surrogateescape")
            if move_rejudged(old_p, new_p):
                sys.stdout.buffer.write(new_b + b"\0")
        return 0
    if a.classify:
        for p in a.files:
            print("%s %s %s" % (kind(p), "manifest" if is_manifest(p) else "-", effective_ext(p) or "-"))
        return 0

    items, unread, failed = [], [], []
    if a.stdin:
        try:
            text, note = decode(sys.stdin.buffer.read(), a.name)
        except (Exception, RecursionError) as e:
            failed.append((a.name, e))
            text = None
        if text is not None:
            items.append((a.name, text, note))
    for p in a.files:
        if os.path.splitext(p)[1].lower() in BINARY_EXT or os.path.isdir(p):
            continue
        try:
            text, note = read(p)
        except (Exception, RecursionError) as e:
            # Decoding is part of the check: content that breaks it must block, not skip the file.
            failed.append((p, e))
            continue
        if text is not None:
            items.append((p, text, note))
        elif not os.path.exists(p) or (os.path.isfile(p) and not os.access(p, os.R_OK)):
            unread.append(p)
    for p, e in failed:
        print(Finding(HARD, 1, 1, "not-checked", "the scanner failed on this file (%s), so it was not checked"
                      % type(e).__name__).fmt(p))
    for p in unread:
        print("content-hygiene: not scanned, missing or unreadable: %s" % p, file=sys.stderr)
    if not items:
        if failed:
            return 1
        if unread:
            return 3
        if a.files or a.stdin:
            return 0          # only binary content: nothing to scan
        ap.print_usage(sys.stderr)
        return 3

    hard = len(failed)
    deadline = time.monotonic() + a.deadline if a.deadline > 0 else None
    for n, (path, text, note) in enumerate(items):
        if deadline is not None and time.monotonic() > deadline:
            for later, _, _ in items[n:]:
                print(Finding(HARD, 1, 1, "not-checked", "the scan ran out of time before this file").fmt(later))
                hard += 1
            break
        try:
            findings, skipped = scan_within(text, path, a.marker, deadline, a.fragment, only_lines, a.cap)
        except TimeoutError:
            print(Finding(HARD, 1, 1, "not-checked",
                          "this file did not finish scanning within %d seconds, so it was not checked" % a.deadline).fmt(path))
            hard += 1
            continue
        except (Exception, RecursionError) as e:
            # Whatever the content did to the scanner, the file is not checked, which blocks:
            # a crash must never read as a pass.
            print(Finding(HARD, 1, 1, "not-checked", "the scanner failed on this file (%s), so it was not checked"
                          % type(e).__name__).fmt(path))
            hard += 1
            continue
        if note and not skipped and not a.quiet:
            print(Finding(SOFT, 1, 1, "encoding", note).fmt(path))
        for f in findings:
            if a.quiet and f.sev != HARD:
                continue
            if a.security and f.sev != HARD and f.code not in SECURITY_CODES:
                continue
            print(f.fmt(path))
            if f.sev == HARD:
                hard += 1
    return 1 if hard else 3 if unread else 0


if __name__ == "__main__":
    sys.exit(main())
