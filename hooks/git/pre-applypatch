#!/bin/bash
# ai-dotfiles-hook: a hook that was here before is kept as <name>.local and runs first;
# if it fails, so does this one.
# Only absolute PATH entries: an empty or relative one could pick up a program from the repo.
_p=""; _ifs="$IFS"; IFS=:
for _d in $PATH; do case "$_d" in /*) _p="${_p:+$_p:}$_d" ;; esac; done
IFS="$_ifs"; PATH="${_p:-/usr/bin:/bin}"; export PATH
if [ -x "$0.local" ]; then "$0.local" "$@" || exit $?; fi
# pre-applypatch - git am runs this, not pre-commit, once a patch is in the index and before
# it is committed. A patch is new content like any other commit, so the same scan runs.
d="$(dirname "$0")"
# Only our own pre-commit, by the header install.sh looks for: git never runs pre-commit during
# am, so a pre-commit of yours (or a symlink to who knows what) would be running out of turn.
[ -x "$d/pre-commit" ] && [ ! -L "$d/pre-commit" ] || exit 0
head -n 6 "$d/pre-commit" 2>/dev/null | grep -qE '^# (ai-dotfiles-hook:|strip-ai-attribution - git commit-msg hook|pre-commit - universal output-hygiene gate|Keeps the project harness current)' || exit 0
AI_HYGIENE_AM=1 exec "$d/pre-commit"
