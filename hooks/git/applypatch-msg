#!/bin/bash
# ai-dotfiles hook: applypatch-msg
# ai-dotfiles-hook: a hook that was here before is kept as <name>.local and runs first;
# if it fails, so does this one.
# Only absolute PATH entries: an empty or relative one could pick up a program from the repo.
_p=""; _ifs="$IFS"; IFS=:
for _d in $PATH; do case "$_d" in /*) _p="${_p:+$_p:}$_d" ;; esac; done
IFS="$_ifs"; PATH="${_p:-/usr/bin:/bin}"; export PATH
if [ -x "$0.local" ]; then "$0.local" "$@" || exit $?; fi
# applypatch-msg - git am runs this, not commit-msg, on the message of each patch it applies.
# The same attribution rules apply, so it hands the message to the commit-msg hook next to it.
# git rebase --apply runs it too, on commits already made: those keep their messages.
gitdir="$(git rev-parse --git-dir 2>/dev/null)" || exit 0
[ -e "$gitdir/rebase-apply/applying" ] || exit 0
d="$(dirname "$0")"
# Only our own commit-msg, by the header install.sh looks for: git never runs commit-msg during
# am, so a commit-msg of yours (or a symlink to who knows what) would be running out of turn.
[ -f "$d/commit-msg" ] && [ -x "$d/commit-msg" ] && [ ! -L "$d/commit-msg" ] || exit 0
head -n 6 "$d/commit-msg" 2>/dev/null | grep -q '^# ai-dotfiles hook: commit-msg$' || exit 0
AI_HYGIENE_AM=1 exec "$d/commit-msg" "$@"
