# Gemini CLI. Installed even before the tool is: it reads these on first run.
# Context file: https://geminicli.com/docs/cli/gemini-md/
# User skills:  https://geminicli.com/docs/cli/skills/  (~/.gemini/skills/<name>/SKILL.md)
DETECT=""
RULES_FILE="$HOME/.gemini/GEMINI.md"
RULES_TITLE="GEMINI.md"
SKILLS_DIR="$HOME/.gemini/skills"
