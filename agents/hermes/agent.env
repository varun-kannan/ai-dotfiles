# Hermes agent (Nous Research). Config is ~/.hermes/config.yaml and skills are
# ~/.hermes/skills/<name>/SKILL.md. The identity file is SOUL.md. Whether Hermes
# reads AGENTS.md is NOT confirmed, so no rules file is written here.
DETECT="$HOME/.hermes"
RULES_FILE=""
SKILLS_DIR="$HOME/.hermes/skills"
