# Cursor IDE. Project rules live per repo in .cursor/rules/*.mdc (see bootstrap);
# user rules are set in the Cursor settings UI and have no file, so setup.sh
# prints the paste step. Source: https://docs.cursor.com/context/rules
DETECT="$HOME/.cursor"
RULES_FILE=""
SKILLS_DIR=""
APP_NAME="Cursor"
APP_SETTINGS="Cursor Settings > Rules (user rules, applied to every project)"
